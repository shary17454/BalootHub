    "من لاعبين حتى أربعة لاعبين، أفرادًا أو في فرق صغيرة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From two up to four players, individually or in small teams."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De deux à quatre joueurs, en solo ou en petites équipes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dos a cuatro jugadores, en solitario o en equipos pequeños."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von zwei bis vier Spielern, einzeln oder in kleinen Teams."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki ila dört oyuncu, tek başına ya da küçük takımlarda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От двух до четырёх игроков — поодиночке или малыми командами."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دو سے چار کھلاڑی، انفرادی یا چھوٹی ٹیموں میں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो से चार खिलाड़ी, अकेले या छोटी टीमों में।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
