    "قراراتك قريبة من الخبير؛ ركز الآن على المواقف الصعبة وقراءة نية الشريك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decisions are close to the expert; now focus on hard scenarios and reading your partner's intent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos décisions frôlent l'expert : visez maintenant le difficile et l'intention du partenaire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones se acercan al experto; ahora céntrate en lo difícil y en leer a tu compañero."
