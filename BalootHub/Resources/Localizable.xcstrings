          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بولی میں کیے گئے وعدے کے برابر یا اس سے زیادہ ہاتھ جیتنا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोली में किए वादे के बराबर या अधिक चालें जीतना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meraih setidaknya jumlah trik yang dijanjikan saat lelang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少赢下叫牌时承诺的墩数。"
          }
        }
      }
    },
    "تختلف طريقة الاحتساب من جولة لأخرى داخل نفس الدورة، وتُجمع النقاط تراكميًا حتى نهاية الدورة الكاملة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calculation method differs from one round to the next within the same cycle, and points accumulate until the full cycle ends."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calcul change d'une manche à l'autre du cycle et les points s'additionnent jusqu'à la fin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cálculo cambia entre rondas del ciclo y los puntos se acumulan hasta el final."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechnung wechselt je Runde im Zyklus; die Punkte summieren sich bis zum Ende."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplama, aynı döngüdeki eller arasında değişir ve puanlar döngü bitene dek birikir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Способ подсчёта меняется от раунда к раунду в цикле, очки копятся до его конца."
