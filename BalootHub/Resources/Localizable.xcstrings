            "value" : "先筛选选项"
          }
        }
      }
    },
    "نسبة الاختيارات خارج أفضل خيارين مرتفعة. قبل المقارنة النهائية، استبعد الورق الذي لا يكسب الأكلة ولا يقلل الخسارة." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil der Entscheidungen außerhalb der zwei besten Optionen ist hoch. Streiche vor dem finalen Vergleich Karten, die weder die Stiche gewinnen noch den Verlust verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rate outside the top two options is high. Before the final comparison, remove cards that neither win the trick nor reduce the loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tasa fuera de las dos mejores opciones es alta. Antes de la comparación final, elimina cartas que no ganan la baza ni reducen la pérdida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton taux hors des deux meilleurs choix est élevé. Avant la comparaison finale, écarte les cartes qui ne gagnent pas le pli et ne réduisent pas la perte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शीर्ष दो विकल्पों से बाहर की दर अधिक है। अंतिम तुलना से पहले वे कार्ड हटाएँ जो न ट्रिक जीतते हैं न नुकसान घटाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingkat pilihan di luar dua teratas tinggi. Sebelum perbandingan akhir, singkirkan kartu yang tidak memenangkan trik dan tidak mengurangi kerugian."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля выборов вне двух лучших вариантов высока. Перед финальным сравнением уберите карты, которые не выигрывают взятку и не уменьшают потери."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk iki seçenek dışındaki tercih oranın yüksek. Son karşılaştırmadan önce eli kazanmayan ve kaybı azaltmayan kartları ele."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہترین دو انتخاب سے باہر جانے کی شرح زیادہ ہے۔ آخری موازنے سے پہلے وہ کارڈ نکالیں جو نہ بازی جیتتے ہیں نہ نقصان کم کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选择前两名之外选项的比例较高。最终比较前，先排除既不能赢墩也不能减少损失的牌。"
          }
        }
      }
    },
    "قبل اختيار الورقة، راجع اللون المطلوب والحكم الموجود ثم قارن هل تستطيع ربح الأكلة أو تقليل خسارتها." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before choosing a card, review the required suit and available trump, then decide whether you can win the trick or reduce the loss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de choisir : couleur demandée, atout présent, puis gagner ou limiter la perte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de elegir: palo pedido, triunfo presente, y luego ganar o reducir la pérdida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor der Wahl: geforderte Farbe, vorhandener Trumpf, dann gewinnen oder Verlust mindern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartı seçmeden önce istenen sembolü ve mevcut kozu gözden geçir, sonra eli kazanabilir misin yoksa kaybı azaltmalı mısın karşılaştır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед выбором: затребованная масть, козырь на столе, затем взять или снизить потери."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ چننے سے پہلے مطلوبہ رنگ اور موجود ترپ دیکھیں، پھر موازنہ کریں کہ ہاتھ جیت سکتے ہیں یا نقصان کم کرنا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड चुनने से पहले माँगा गया सूट और मौजूद तुरुप देखें, फिर तुलना करें कि चाल जीत सकते हैं या हानि घटानी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum memilih kartu, tinjau simbol yang diminta dan truf yang ada, lalu bandingkan bisa menang trik atau menekan kerugian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出牌前先看所需花色与场上将牌，再比较能否拿墩或减少损失。"
          }
        }
      }
    },
