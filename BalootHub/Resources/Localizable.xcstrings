    "لا توجد مشاريع بالمعنى المستخدم في البلوت؛ التركيز على دقة الالتزام بعدد الأكلات." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no projects in the Baloot sense; the focus is on meeting your committed number of tricks exactly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de projets au sens du Baloot : l'accent est sur le respect exact du contrat."
