    "شرح نمط الحكم داخل لعبة البلوت الواحدة؛ يحدده اللاعب المشتري ولونه أثناء دورة المزايدة." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explains Hokum inside the single Baloot game; the bidder chooses it and its suit during bidding."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique le mode Hokum dans le jeu unique ; le preneur en fixe la couleur aux enchères."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica el modo Hokum dentro del juego único; el postor elige su palo en la puja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erklärt den Hokum-Modus im einen Spiel; der Ansager bestimmt Farbe beim Reizen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek Baloot oyunu içinde Hokum modunu açıklar; alan oyuncu ve sembolü ihalede belirlenir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объясняет режим Hokum внутри одной игры: заказчик и масть определяются в торговле."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی بلوت کھیل میں Hokum موڈ کی وضاحت؛ بولی جیتنے والا اور اس کا رنگ بولی میں طے ہوتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही बलूत खेल में Hokum मोड की व्याख्या; बोली जीतने वाला और उसका सूट बोली में तय होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjelaskan mode Hokum di dalam satu permainan Baloot; pemenang lelang dan simbolnya ditentukan saat lelang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讲解单一 Baloot 游戏内的 Hokum 模式：叫牌方及其花色在叫牌中确定。"
          }
        }
      }
    },
    "شرح نمط الصن داخل لعبة البلوت الواحدة؛ لا يُفتح كلعبة منفصلة بل يُشترى أثناء المزايدة." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explains Sun inside the single Baloot game; it is not opened as a separate game; it is selected during bidding."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique le mode Sun au sein du jeu unique ; il s'achète aux enchères, pas comme jeu à part."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica el modo Sun dentro del juego único; se compra en la puja, no es un juego aparte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erklärt den Sun-Modus im einen Baloot-Spiel; er wird ersteigert, nicht separat geöffnet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek Baloot oyunu içinde Sun modunu açıklar; ayrı bir oyun olarak açılmaz, ihalede alınır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объясняет режим Sun внутри одной игры: он заявляется в торговле, а не открывается отдельно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی بلوت کھیل میں Sun موڈ کی وضاحت؛ الگ کھیل نہیں، بولی میں خریدا جاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही बलूत खेल में Sun मोड की व्याख्या; अलग खेल नहीं, बोली में लिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjelaskan mode Sun di dalam satu permainan Baloot; bukan permainan terpisah, tetapi dibeli saat lelang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讲解单一 Baloot 游戏内的 Sun 模式：它不是独立游戏，而是在叫牌中买到。"
          }
        }
      }
    },
