    "جرّب كلمة بحث أخرى مثل اسم اللعبة أو نوعها.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a different search term, like the game's name or category."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre terme, comme le nom ou la catégorie du jeu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro término, como el nombre o la categoría del juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Suchbegriff, etwa den Namen oder die Kategorie des Spiels."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun adı veya kategorisi gibi farklı bir terim deneyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другой запрос — например, название или категорию игры."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اور اصطلاح آزمائیں، جیسے گیم کا نام یا اس کا زمرہ۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई और शब्द आज़माएँ, जैसे गेम का नाम या श्रेणी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba kata lain, seperti nama atau kategori permainan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他搜索词，例如游戏名称或类别。"
          }
        }
      }
    },
