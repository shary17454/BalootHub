    "إجاباتك تصل قرب نهاية المؤقت؛ ابق على نفس المستوى حتى تزيد سرعة الجمع." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your answers arrive near the end of the timer; stay at the same level until your counting gets faster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réponses arrivent en fin de chrono : restez à ce niveau pour accélérer le calcul."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas llegan al final del cronómetro; quédate en este nivel hasta sumar más rápido."
          }
