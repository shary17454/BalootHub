    "عملية الشراء قيد الموافقة (مثل التحكم الأبوي)، ستُفعَّل تلقائيًا عند اكتمالها." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf wartet auf Freigabe (z. B. Kaufanfrage) und wird nach Abschluss automatisch aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase is pending approval (such as Ask to Buy) and will activate automatically once complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra está pendiente de aprobación (por ejemplo, Pedir autorización) y se activará automáticamente al completarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'achat est en attente d'approbation (par exemple Demander à acheter) et s'activera automatiquement une fois validé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खरीदारी अनुमोदन की प्रतीक्षा में है (जैसे Ask to Buy) और पूरा होते ही स्वतः सक्रिय हो जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian menunggu persetujuan (misalnya Ask to Buy) dan akan aktif otomatis setelah selesai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка ожидает подтверждения (например, «Запрос на покупку») и активируется автоматически после завершения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma onay bekliyor (örneğin Satın Alma İzni) ve tamamlandığında otomatik olarak etkinleşecek."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خریداری منظوری کی منتظر ہے (مثلاً Ask to Buy) اور مکمل ہوتے ہی خودکار طور پر فعال ہو جائے گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买正在等待批准（例如“购买请求”），完成后将自动生效。"
          }
        }
      }
    },
