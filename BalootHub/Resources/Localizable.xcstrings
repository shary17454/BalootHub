    "تعرض جدول نقاط كل ورقة في نمطي صن وحكم جنبًا إلى جنب لسهولة المقارنة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a table of each card's points in Sun and Hokum side by side for easy comparison."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les points de chaque carte en Sun et Hokum côte à côte pour comparer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los puntos de cada carta en Sun y Hokum lado a lado para comparar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Punkte jeder Karte in Sun und Hokum nebeneinander zum Vergleich."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kartın Sun ve Hokum puanlarını karşılaştırma kolaylığı için yan yana gösterir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает очки каждой карты в Sun и Hokum рядом для сравнения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کارڈ کے Sun اور Hokum پوائنٹس موازنے کی آسانی کے لیے ساتھ ساتھ دکھاتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कार्ड के Sun और Hokum अंक तुलना हेतु साथ-साथ दिखाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan poin tiap kartu di Sun dan Hokum berdampingan untuk perbandingan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并排显示每张牌在 Sun 与 Hokum 下的分值，便于比较。"
          }
        }
      }
    },
    "تعريف اللاعب الجديد بأدوار الطاولة (الموزّع، المزايد، الفريقان) وبأبسط قواعد البلوت قبل خوض جولة فعلية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce a new player to the roles at the table (dealer, bidder, the two teams) and to the simplest Baloot rules before playing a real round."
          }
        }
      }
    },
    "تعريف مبسّط بمفهوم \"المشروع\" كنقاط إضافية عند امتلاك تشكيلة معيّنة من الأوراق." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple introduction to the idea of a \"project\" as extra points for holding a certain combination of cards."
          }
        }
      }
    },
    "تعظيم نقاط الفريق عبر إعلان المشاريع الصحيحة إضافة إلى نقاط الأكلات المعتادة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximize your team's points by declaring valid projects in addition to the usual trick points."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximiser les points de l'équipe en annonçant des projets valides en plus des plis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximizar los puntos del equipo declarando proyectos válidos además de las bazas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Teampunkte durch gültige Projektansagen zusätzlich zu den Stichpunkten maximieren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli projeleri ilan ederek olağan el puanlarına ek olarak takım puanını en üste çıkarmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимизировать очки команды, объявляя действительные проекты вдобавок к взяткам."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درست پروجیکٹس کے اعلان سے عام ہاتھ پوائنٹس کے علاوہ ٹیم کے پوائنٹس بڑھانا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सही प्रोजेक्ट घोषित कर सामान्य चाल-अंकों के अलावा टीम अंक बढ़ाना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memaksimalkan poin tim dengan mendeklarasikan proyek sah selain poin trik biasa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过宣告有效项目，在常规墩分之外最大化队伍得分。"
          }
        }
      }
    },
    "تُعلَن الجلسة منتهية والفريق فائزًا فور بلوغ أحد الفريقين الهدف المستهدف بفارق واضح." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session is declared over and the team declared the winner as soon as one team reaches the target score by a clear margin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session s'achève et l'équipe est déclarée gagnante dès l'objectif atteint avec un écart net."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión termina y se declara ganador al equipo en cuanto alcanza el objetivo con margen claro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung endet und das Team gewinnt, sobald es das Ziel mit klarem Abstand erreicht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir takım hedefe net farkla ulaşınca oturum biter ve o takım kazanan ilan edilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессия завершается и команда объявляется победителем при достижении цели с явным отрывом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جیسے ہی کوئی ٹیم واضح فرق سے ہدف تک پہنچے، سیشن ختم اور وہ ٹیم فاتح قرار۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही कोई टीम स्पष्ट अंतर से लक्ष्य तक पहुँचे, सत्र समाप्त और वह टीम विजेता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi berakhir dan tim dinyatakan menang begitu satu tim mencapai target dengan selisih jelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦某队以明显优势达到目标分，本场即结束并宣布该队获胜。"
          }
        }
