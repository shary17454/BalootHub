    "تغطية أنواع المواقف تجعل توصيات المدرب أعدل؛ لا تدرّب الصعوبة فقط." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abdeckung verschiedener Situationstypen macht die Trainerempfehlungen fairer; trainiere nicht nur die Schwierigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Covering scenario types makes trainer recommendations fairer; do not train difficulty only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubrir tipos de situación hace más justas las recomendaciones del entrenador; no entrenes solo la dificultad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrir les types de situations rend les recommandations du coach plus justes; ne travaille pas seulement la difficulté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थिति प्रकारों को कवर करने से कोच की सिफारिशें बेहतर होती हैं; केवल कठिनाई का अभ्यास न करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencakup jenis situasi membuat rekomendasi pelatih lebih adil; jangan hanya melatih tingkat kesulitan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрытие типов ситуаций делает рекомендации тренера точнее; тренируйте не только сложность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaryo türlerini kapsamak koç önerilerini daha dengeli yapar; yalnızca zorluğu çalıştırma."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختلف صورتحال کی اقسام کا احاطہ کوچ کی سفارشات کو بہتر بناتا ہے؛ صرف مشکل سطح کی مشق نہ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖不同局面类型会让教练建议更均衡；不要只训练难度。"
          }
        }
      }
    },
