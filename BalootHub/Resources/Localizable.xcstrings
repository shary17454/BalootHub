          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihum spielen und dabei je nach Hausregeln Straf- oder Punktekarten meiden oder sammeln."
          }
        },
        "tr" : {
          "stringUnit" : {
