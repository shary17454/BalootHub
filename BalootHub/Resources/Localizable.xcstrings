            "value" : "接近最优的选择"
          }
        }
      }
    },
    "أغلب أخطائك ليست مدمرة، لكنها تفوّت أفضلية صغيرة. ركز على الفرق بين أفضل وثاني أفضل ورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most of your mistakes are not destructive, but they miss a small edge. Focus on the difference between the best and second-best card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos erreurs ne sont pas graves mais coûtent un petit avantage : regardez l'écart entre les deux meilleures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus errores no son graves pero pierden una pequeña ventaja; mira la diferencia entre las dos mejores cartas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fehler sind nicht schlimm, kosten aber einen kleinen Vorteil – prüfe den Abstand der beiden besten Karten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hataların yıkıcı değil ama küçük bir üstünlüğü kaçırıyor. En iyi ile ikinci kart arasındaki farka odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибки не разрушительны, но упускают небольшое преимущество — смотри разрыв двух лучших карт."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی غلطیاں تباہ کن نہیں، مگر چھوٹی برتری کھو دیتی ہیں۔ بہترین اور دوسرے کارڈ کے فرق پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी ग़लतियाँ विनाशकारी नहीं, पर छोटा लाभ चूकती हैं। सर्वश्रेष्ठ व दूसरे कार्ड के अंतर पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahanmu tidak fatal, tetapi melewatkan keunggulan kecil. Fokus pada selisih kartu terbaik dan kedua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的失误不算致命，但会错过小优势：关注最优与次优牌之间的差距。"
          }
        }
      }
    },
