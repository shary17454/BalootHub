    "يفتح مدرب وش تلعب؟ بنفس صعوبة وبذرة خطة التدريب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the What-to-Play trainer with the plan's difficulty and seed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre l'entraîneur « Quelle carte ? » avec la difficulté et la graine du plan."
          }
        },
        "es" : {
          "stringUnit" : {
