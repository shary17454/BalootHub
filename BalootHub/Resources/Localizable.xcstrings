          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les noms des deux équipes et l'objectif (152 par défaut ou personnalisé) avant la première donne."
          }
        },
        "es" : {
          "stringUnit" : {
