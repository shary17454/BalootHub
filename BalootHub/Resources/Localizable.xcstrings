            "value" : "اس صورتحال کے ماہرانہ تجزیے کے مطابق یہ بہترین کارڈ ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्थिति के विशेषज्ञ विश्लेषण अनुसार यही सर्वश्रेष्ठ कार्ड है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini kartu terbaik menurut analisis pakar untuk situasi ini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按专家对该局面的分析，这是最佳出牌。"
          }
        }
      }
    },
    "قريب جدًا من اختيار الخبير ولا يخسر أثرًا متوقعًا." : {
      "localizations" : {
