          }
        }
      }
    },
    "لديك عينات كافية من كل ألوان الحكم، لذلك تصبح توصيات الحكم أدق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have enough samples across all trump suits, so Hokum recommendations get sharper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez assez d'échantillons sur toutes les couleurs d'atout : les conseils Hokum s'affinent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes muestras suficientes de todos los palos de triunfo, así que los consejos de Hokum mejoran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast genug Daten zu allen Trumpffarben, daher werden Hokum-Empfehlungen genauer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm koz sembollerinden yeterli örneğin var; Hokum önerileri daha isabetli olur."
