        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلی مشق مختصر رکھیں اور اپنے انتخاب کے Replay کا بہترین فیصلے سے موازنہ کریں۔"
          }
        },
        "zh-Hans" : {
