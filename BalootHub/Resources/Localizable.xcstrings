        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирайте ситуации близко к вашему уровню и пересматривайте повтор лучшего решения перед повышением сложности."
          }
        },
        "tr" : {
          "stringUnit" : {
