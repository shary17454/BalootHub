        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez si votre entame dévoile trop tôt votre force ou la garde pour le pli suivant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara si tu salida revela pronto tu fuerza o la guarda para la siguiente baza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche, ob deine Eröffnung deine Stärke früh zeigt oder für den nächsten Stich spart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılışın gücünü erken mi gösteriyor yoksa sonraki ele mi saklıyor, karşılaştır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравни: заход раскрывает силу рано или бережёт её на следующую взятку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موازنہ کریں کہ آپ کا آغاز طاقت جلد ظاہر کرتا ہے یا اگلے ہاتھ کے لیے بچاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुलना करें कि आपकी शुरुआत ताक़त जल्दी दिखाती है या अगली चाल के लिए बचाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan apakah pembukamu membuka kekuatan lebih awal atau menyimpannya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对比：你的首攻是过早暴露实力，还是为下墩留力。"
          }
        }
      }
    },
    "الخيار الأفضل كان يتوقع كسبًا، بينما اختيارك يميل لخسارة الأكلة أو نقاطها. هذه المواقف تستحق إعادة قراءة الطاولة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best option expected a gain, while your choice tends to lose the trick or its points. These scenarios are worth rereading carefully."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meilleur choix gagnait, le vôtre tend à perdre : ces situations méritent une relecture de la table."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor opción esperaba ganar y la tuya tiende a perder; estas situaciones merecen releer la mesa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beste Option gewann, deine verliert eher – solche Situationen lohnen ein erneutes Tischlesen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi seçenek kazanç bekliyordu, seninki ise eli ya da puanını kaybetmeye meyilli. Bu durumlar masayı yeniden okumayı hak ediyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучший вариант обещал выигрыш, твой склонен терять — такие ситуации стоит перечитать."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہترین اختیار نفع کی توقع رکھتا تھا، جبکہ آپ کا انتخاب ہاتھ یا اس کے پوائنٹس ہارنے کی طرف مائل۔ ایسی صورتیں میز دوبارہ پڑھنے کے لائق ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वश्रेष्ठ विकल्प लाभ की उम्मीद रखता था, जबकि आपका चयन चाल या उसके अंक खोने की ओर झुका। ऐसी स्थितियाँ मेज़ फिर पढ़ने योग्य हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsi terbaik memperkirakan untung, sedangkan pilihanmu cenderung kehilangan trik atau poinnya. Situasi seperti ini layak dibaca ulang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最优选择本可获利，而你的选择偏向丢墩或丢分：这类局面值得重新读一遍桌面。"
          }
        }
      }
    },
    "قرارك قريب من الأفضل، لكن الفرق الصغير يتراكم مع الوقت؛ راجع لماذا رجّح الخبير الورقة الأولى." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decision is close to the best option, but small differences add up; review why the expert preferred the first card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proche du meilleur, mais l'écart s'accumule : voyez pourquoi l'expert préfère la première carte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de lo mejor, pero la pequeña diferencia se acumula; mira por qué el experto prefirió la primera carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nah am Besten, doch kleine Abstände summieren sich – sieh, warum der Experte die erste Karte wählte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararın en iyiye yakın ama küçük fark zamanla birikir; uzmanın ilk kartı neden yeğlediğini gözden geçir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близко к лучшему, но мелкий разрыв копится — посмотри, почему эксперт выбрал первую карту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا فیصلہ بہترین کے قریب ہے، مگر چھوٹا فرق وقت کے ساتھ جمع ہوتا ہے؛ دیکھیں ماہر نے پہلا کارڈ کیوں ترجیح دیا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका निर्णय श्रेष्ठ के करीब है, पर छोटा अंतर समय के साथ जुड़ता है; देखें विशेषज्ञ ने पहला कार्ड क्यों चुना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusanmu dekat dengan yang terbaik, tetapi selisih kecil menumpuk seiring waktu; tinjau mengapa pakar memilih kartu pertama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的决策接近最优，但细微差距会日积月累：看看专家为何更青睐第一张牌。"
          }
        }
      }
    },
    "قرارك يطابق أفضل خيار في هذا الموقف، لذلك ركز على تذكر سبب نجاحه للمواقف المشابهة." : {
