    "تعرض جدول نقاط كل ورقة في نمطي صن وحكم جنبًا إلى جنب لسهولة المقارنة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a table of each card's points in Sun and Hokum side by side for easy comparison."
          }
        }
      }
    },
    "تعريف اللاعب الجديد بأدوار الطاولة (الموزّع، المزايد، الفريقان) وبأبسط قواعد البلوت قبل خوض جولة فعلية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce a new player to the roles at the table (dealer, bidder, the two teams) and to the simplest Baloot rules before playing a real round."
          }
        }
      }
    },
    "تعريف مبسّط بمفهوم \"المشروع\" كنقاط إضافية عند امتلاك تشكيلة معيّنة من الأوراق." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple introduction to the idea of a \"project\" as extra points for holding a certain combination of cards."
          }
        }
      }
    },
    "تعظيم نقاط الفريق عبر إعلان المشاريع الصحيحة إضافة إلى نقاط الأكلات المعتادة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximize your team's points by declaring valid projects in addition to the usual trick points."
          }
        }
      }
    },
    "تُعلَن الجلسة منتهية والفريق فائزًا فور بلوغ أحد الفريقين الهدف المستهدف بفارق واضح." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session is declared over and the team declared the winner as soon as one team reaches the target score by a clear margin."
          }
        }
      }
    },
