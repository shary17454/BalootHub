    "أربعة لاعبين ثابتون في فريقين من لاعبين، يجلس شريكا كل فريق متقابلين على الطاولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four fixed players in two teams of two, with each team's partners seated opposite each other at the table."
          }
        }
      }
    },
    "أربعة لاعبين في فريقين متقابلين، كما في البلوت الكلاسيكي." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four players in two opposing teams, as in Classic Baloot."
          }
        }
      }
    },
    "أربعة لاعبين في فريقين متقابلين." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four players in two opposing teams."
          }
        }
      }
    },
    "أربعة لاعبين، إما كل لاعب لنفسه أو في فريقين متقابلين حسب الصيغة المعتمدة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four players, either every player for themselves or in two opposing teams depending on the format used."
          }
        }
      }
    },
    "أربعة لاعبين، كل لاعب يلعب لحسابه الخاص دون فرق ثابتة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four players, each playing for themselves with no fixed teams."
          }
        }
      }
    },
    "أشهر الأخطاء: القطع بحكم ضعيف بلا داعٍ، ونسيان أن بعض المجالس تُلزم بالتعلية (القطع بحكم أعلى) — وهو إعداد قابل للتفعيل من إعدادات التسجيل." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistakes: trumping with a low card needlessly, and forgetting that some groups require overtrumping (playing a higher trump) — an option you can enable in the scorekeeper settings."
          }
        }
      }
    },
    "أشهر الأخطاء: نسيان التلزيم بنفس النوع، القطع بحكم أضعف من اللازم، والإعلان عن مشروع غير مكتمل الشروط." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistakes: forgetting to follow suit, trumping with a weaker card than necessary, and declaring a project that doesn't meet the conditions."
          }
        }
      }
    },
    "أشهر المشاريع: السرا (ثلاث أوراق متتابعة من نفس النوع)، الخمسين (أربع متتابعة)، المية (أربع أوراق من نفس الرتبة)، إضافة إلى البلوت. القيم الدقيقة تختلف بين المجالس، لذا تُترك قابلة للاتفاق قبل اللعب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best-known projects: Sira (three consecutive cards of the same suit), Fifty (four consecutive), Hundred (four cards of the same rank), plus the Baloot. Exact values vary between groups, so they are left open to agreement before play."
          }
        }
      }
    },
    "أضف أول صكة لبدء تتبّع النتيجة." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die erste Runde hinzu, um den Punktestand zu verfolgen."
