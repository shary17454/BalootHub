        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменений с начала мало — работай над качеством, а не количеством."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تربیت کے آغاز اور حالیہ کوششوں میں فرق کم ہے؛ تعداد نہیں، معیار بڑھائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभ्यास की शुरुआत और हालिया प्रयासों में बदलाव कम है; संख्या नहीं, गुणवत्ता बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan sejak awal latihan terbatas; fokus meningkatkan kualitas, bukan sekadar jumlah."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从训练开始到最近的变化有限：提升质量，而不只是增加数量。"
          }
        }
      }
    },
