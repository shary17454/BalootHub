  "strings": {
    "، دوره الآن": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", their turn now"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", à lui de jouer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", ahora es su turno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", ist jetzt am Zug"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", şimdi sırası onda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ", сейчас его ход"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "، اب اُن کی باری ہے"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ", अब उनकी बारी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ", kini gilirannya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，现在轮到他"
          }
        }
      }
    },
