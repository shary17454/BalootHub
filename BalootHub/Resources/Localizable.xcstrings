        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İhalede söz verilen el sayısına ulaşmak ya da aşmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
