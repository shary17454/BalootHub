        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "风险在于习惯了简单局面，从不在压力下检验读牌。"
          }
        }
      }
    },
    "ارفع الصعوبة وركز على مواقف الحكم وقراءة نية الشريك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
