    "أدخل نقاطًا صحيحة غير سالبة لكلا الفريقين.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter valid, non-negative scores for both teams."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des scores valides et non négatifs pour les deux équipes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce puntuaciones válidas y no negativas para ambos equipos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib für beide Teams gültige, nicht negative Punktzahlen ein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki takım için de geçerli ve negatif olmayan puanlar girin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите корректные неотрицательные очки для обеих команд."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں ٹیموں کے لیے درست اور غیر منفی اسکور درج کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों टीमों के लिए मान्य और गैर-ऋणात्मक अंक दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan skor yang valid dan tidak negatif untuk kedua tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为两队输入有效且非负的分数。"
          }
        }
      }
    },
