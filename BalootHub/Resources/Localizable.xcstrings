    "أشهر الأخطاء: القطع بحكم ضعيف بلا داعٍ، ونسيان أن بعض المجالس تُلزم بالتعلية (القطع بحكم أعلى) — وهو إعداد قابل للتفعيل من إعدادات التسجيل." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistakes: trumping with a low card needlessly, and forgetting that some groups require overtrumping (playing a higher trump) — an option you can enable in the scorekeeper settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreurs classiques : couper trop bas sans raison et oublier l'obligation de surcouper, activable dans les réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errores clásicos: cortar con un triunfo bajo sin necesidad y olvidar que algunos grupos obligan a sobrecortar, opción activable en ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassische Fehler: unnötig niedrig stechen und die Übertrumpfpflicht vergessen – in den Einstellungen aktivierbar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaygın hatalar: gereksiz yere zayıf kozla kesmek ve bazı meclislerin üste çıkmayı (daha yüksek kozla kesmeyi) zorunlu kıldığını unutmak — bu, puan ayarlarından açılabilen bir seçenektir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типичные ошибки: козырять слабо без нужды и забыть про обязанность перебивать — включается в настройках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عام غلطیاں: بلاضرورت کمزور ترپ سے کاٹنا، اور بھول جانا کہ کچھ مجالس اوپر کاٹنا لازم کرتی ہیں — یہ اسکور ترتیبات سے فعال ہو سکتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आम ग़लतियाँ: बिना ज़रूरत कमज़ोर तुरुप से काटना, और भूलना कि कुछ समूह ऊपर काटना अनिवार्य करते हैं — यह स्कोर सेटिंग्स से सक्षम किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan umum: memotong dengan truf lemah tanpa perlu, dan lupa bahwa sebagian kelompok mewajibkan memotong lebih tinggi — opsi ini bisa diaktifkan di pengaturan skor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常见错误：无必要地用小将去砍，以及忘记某些圈子要求必须盖将——该选项可在计分设置中启用。"
          }
        }
      }
    },
    "أشهر الأخطاء: نسيان التلزيم بنفس النوع، القطع بحكم أضعف من اللازم، والإعلان عن مشروع غير مكتمل الشروط." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistakes: forgetting to follow suit, trumping with a weaker card than necessary, and declaring a project that doesn't meet the conditions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreurs classiques : ne pas fournir, couper trop bas, annoncer un projet incomplet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errores clásicos: no seguir el palo, cortar con un triunfo demasiado bajo y declarar un proyecto incompleto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassische Fehler: nicht bedienen, zu niedrig stechen, ein unvollständiges Projekt ansagen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaygın hatalar: aynı sembole uymayı unutmak, gereğinden zayıf kozla kesmek ve şartları tamamlanmamış proje ilan etmek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типичные ошибки: не ходить в масть, козырять слишком мелко, объявлять неполный проект."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عام غلطیاں: اسی رنگ کی پیروی بھولنا، ضرورت سے کمزور ترپ سے کاٹنا، اور نامکمل پروجیکٹ کا اعلان۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आम ग़लतियाँ: उसी सूट का पालन भूलना, ज़रूरत से कमज़ोर तुरुप से काटना, और अधूरा प्रोजेक्ट घोषित करना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan umum: lupa mengikuti simbol yang sama, memotong dengan truf terlalu lemah, dan mendeklarasikan proyek yang belum lengkap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常见错误：忘记跟花色、用过小的将牌去砍、以及宣告条件不完整的项目。"
          }
        }
      }
    },
    "أشهر المشاريع: السرا (ثلاث أوراق متتابعة من نفس النوع)، الخمسين (أربع متتابعة)، المية (أربع أوراق من نفس الرتبة)، إضافة إلى البلوت. القيم الدقيقة تختلف بين المجالس، لذا تُترك قابلة للاتفاق قبل اللعب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best-known projects: Sira (three consecutive cards of the same suit), Fifty (four consecutive), Hundred (four cards of the same rank), plus the Baloot. Exact values vary between groups, so they are left open to agreement before play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projets connus : Sira (3 cartes qui se suivent), Fifty (4 qui se suivent), Hundred (4 de même rang), plus le Baloot. Les valeurs varient selon les groupes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectos conocidos: Sira (3 seguidas del mismo palo), Cincuenta (4 seguidas), Cien (4 del mismo valor), más el Baloot. Los valores varían entre grupos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekannte Projekte: Sira (3 in Folge), Fifty (4 in Folge), Hundred (4 gleichrangige) sowie das Baloot. Werte variieren je Runde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinen projeler: Sira (aynı sembolden art arda üç kart), Fifty (art arda dört), Hundred (aynı değerden dört kart) ve Baloot. Kesin değerler meclislere göre değişir, bu yüzden oyun öncesi anlaşmaya bırakılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известные проекты: Sira (три подряд), Fifty (четыре подряд), Hundred (четыре одного ранга) и Baloot. Значения различаются по компаниям."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معروف پروجیکٹس: سرا (ایک ہی رنگ کے تین متواتر کارڈ)، خمسین (چار متواتر)، میہ (ایک ہی رتبے کے چار کارڈ)، اور بلوت۔ درست قیمتیں مجالس میں مختلف، سو کھیل سے پہلے اتفاق پر چھوڑی جاتی ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रसिद्ध प्रोजेक्ट: सिरा (एक ही सूट के तीन क्रमिक कार्ड), फ़िफ़्टी (चार क्रमिक), हंड्रेड (एक ही रैंक के चार कार्ड), और बलूत। सटीक मूल्य समूहों में भिन्न, इसलिए खेल से पहले सहमति पर छोड़े जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek terkenal: Sira (tiga kartu berurutan sesimbol), Fifty (empat berurutan), Hundred (empat kartu berperingkat sama), ditambah Baloot. Nilai persisnya berbeda antar kelompok, jadi disepakati sebelum bermain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知名项目：Sira（同花色三连张）、Fifty（四连张）、Hundred（四张同点），以及 Baloot。具体分值各圈不同，故留待开局前约定。"
          }
        }
      }
    },
