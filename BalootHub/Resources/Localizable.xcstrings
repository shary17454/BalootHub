    "أضف أول صكة لبدء تتبّع النتيجة.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the first round to start tracking the score."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la première manche pour commencer à suivre le score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la primera ronda para empezar a registrar la puntuación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die erste Runde hinzu, um den Punktestand zu verfolgen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanı takip etmeye başlamak için ilk eli ekleyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте первый раунд, чтобы начать вести счёт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکور کا حساب شروع کرنے کے لیے پہلا راؤنڈ شامل کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कोर ट्रैक करना शुरू करने के लिए पहला राउंड जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan ronde pertama untuk mulai mencatat skor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加第一局以开始记录分数。"
          }
        }
      }
    },
