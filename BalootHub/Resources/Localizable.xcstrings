    "تقترب من القرار الصحيح كثيرًا، لكن بعض الاختيارات تسرّب نقاطًا متوقعة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You often get close to the right decision, but some choices leak expected points."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous frôlez souvent la bonne décision, mais certains choix fuient des points attendus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te acercas mucho a la decisión correcta, pero algunas elecciones filtran puntos esperados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist oft nah an der richtigen Entscheidung, doch manche Wahlen kosten Erwartungspunkte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru karara çok yaklaşıyorsun ama bazı seçimler beklenen puan sızdırıyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты часто близок к верному решению, но часть выборов теряет ожидаемые очки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ درست فیصلے کے بہت قریب پہنچتے ہیں، مگر کچھ انتخابات متوقع پوائنٹس بہا دیتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप सही निर्णय के बहुत करीब आते हैं, पर कुछ चयन अपेक्षित अंक बहा देते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sering dekat dengan keputusan benar, tetapi sebagian pilihan membocorkan poin harapan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你常常很接近正确决策，但部分选择漏掉了期望分。"
          }
        }
      }
    },
    "غالبًا لا تبتعد كثيرًا عن أفضل خيار." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You usually do not drift far from the best option."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
