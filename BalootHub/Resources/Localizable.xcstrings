        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты почти не меняются — сокращай потери на вторых вариантах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے پچھلے اور حالیہ نتائج قریب ہیں؛ دوسرے اختیارات میں پوائنٹس کا نقصان کم کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पिछले और हालिया परिणाम समान हैं; दूसरे विकल्पों में अंक हानि घटाएँ।"
