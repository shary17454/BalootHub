    "ابدأ جلسة جديدة لتسجيل نتائج جولات صن وحكم أولًا بأول." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine neue Sitzung, um die Punkte der Sun- und Hokum-Runden laufend zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a new session to track sun and hokum round scores as you go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión nueva para registrar las puntuaciones de las rondas Sun y Hokum sobre la marcha."
