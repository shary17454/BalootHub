    "اجعل التدريب القادم قصيرًا ومبنيًا على مقارنة Replay اختيارك بأفضل قرار." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das nächste Training kurz und baue es auf dem Vergleich des Replays deiner Wahl mit der besten Entscheidung auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the next drill short and base it on comparing your replay with the best decision replay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que el próximo entrenamiento sea corto y basado en comparar la repetición de tu elección con la mejor decisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le prochain entraînement court et comparez le replay de votre choix au meilleur choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगला अभ्यास छोटा रखें और अपनी पसंद के रीप्ले की तुलना सर्वोत्तम निर्णय से करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat latihan berikutnya singkat dan bandingkan replay pilihan Anda dengan replay keputusan terbaik."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте следующую тренировку короткой и сравните повтор вашего выбора с повтором лучшего решения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki çalışmayı kısa tut ve kendi seçiminin tekrarını en iyi kararın tekrarıyla karşılaştır."
