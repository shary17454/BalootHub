    "كل الأنواع الأربعة تُرتَّب بنفس الترتيب: A أعلى، يليه 10، K، Q، J، 9، 8، 7 (الأضعف)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All four suits rank the same way: A highest, then 10, K, Q, J, 9, 8, 7 (lowest)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les quatre couleurs suivent le même ordre : A, puis 10, K, Q, J, 9, 8, 7 (le plus faible)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cuatro palos siguen el mismo orden: A, luego 10, K, Q, J, 9, 8, 7 (el más bajo)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vier Farben haben dieselbe Reihenfolge: A, dann 10, K, Q, J, 9, 8, 7 (am schwächsten)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dört sembol de aynı sırayı izler: A en yüksek, sonra 10, K, Q, J, 9, 8, 7 (en zayıf)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все четыре масти идут в одном порядке: A, затем 10, K, Q, J, 9, 8, 7 (младшая)."
