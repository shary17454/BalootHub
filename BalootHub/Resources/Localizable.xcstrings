    "تحقيق أفضل نتيجة عبر تجنّب أوراق أو أكلات معيّنة تخسر نقاطًا، بحسب الصيغة المعتمدة من اللاعبين." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the best result by avoiding certain cards or tricks that lose points, according to the format the players adopt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenir le meilleur score en évitant certaines cartes ou plis pénalisants, selon la variante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lograr el mejor resultado evitando ciertas cartas o bazas penalizadas, según la variante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das beste Ergebnis erzielen, indem man je nach Variante bestimmte Karten oder Stiche meidet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyuncuların benimsediği formata göre puan kaybettiren belirli kartlardan ya da ellerden kaçınarak en iyi sonucu almak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достичь лучшего результата, избегая штрафных карт или взяток по выбранному варианту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھلاڑیوں کے منتخب فارمیٹ کے مطابق نقصان دینے والے کارڈ یا ہاتھ سے بچ کر بہترین نتیجہ حاصل کرنا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खिलाड़ियों द्वारा चुने प्रारूप अनुसार अंक खोने वाले कार्ड या चालों से बचकर सर्वोत्तम परिणाम पाना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meraih hasil terbaik dengan menghindari kartu atau trik tertentu yang merugikan, sesuai format yang dipakai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按玩家采用的赛制，避开会扣分的特定牌或墩，从而取得最好成绩。"
          }
        }
      }
    },
    "تحقيق أقل عدد نقاط سلبية (أو أعلى نقاط إيجابية حسب الجولة) عبر دورة من عدة أنماط لعب مختلفة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish with the fewest penalty points (or the most positive points, depending on the round) across a cycle of several different play modes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finir avec le moins de points négatifs (ou le plus de positifs) sur un cycle de modes variés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar con menos puntos negativos (o más positivos) a lo largo de un ciclo de varios modos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den wenigsten Minuspunkten (oder meisten Pluspunkten) durch einen Zyklus mehrerer Modi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı oyun modlarından oluşan bir döngüde en az ceza puanını (ya da role göre en çok artı puanı) toplamak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набрать меньше всего штрафных очков (или больше положительных) за цикл разных режимов."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختلف انداز کے ایک دور میں کم سے کم منفی پوائنٹس (یا راؤنڈ کے مطابق زیادہ مثبت) حاصل کرنا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विभिन्न मोड के एक चक्र में सबसे कम ऋणात्मक अंक (या राउंड अनुसार सर्वाधिक धनात्मक) पाना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meraih poin negatif paling sedikit (atau positif terbanyak sesuai ronde) dalam satu siklus beberapa mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在包含多种玩法的一个周期中，取得最少的负分（或按该局取得最多正分）。"
          }
        }
      }
    },
    "تحقيق عدد الأكلات الذي التزم به اللاعب أو الفريق أثناء المزايدة، أو أكثر." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win at least the number of tricks you or your team committed to during the bidding."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réaliser au moins le nombre de plis promis lors des enchères."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganar al menos el número de bazas comprometido en la subasta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
