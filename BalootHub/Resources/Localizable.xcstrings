        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام ترپ رنگوں کے کافی نمونے ہیں، سو Hokum کی تجاویز زیادہ درست ہوں گی۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी तुरुप सूट के पर्याप्त नमूने हैं, इसलिए Hokum सिफ़ारिशें अधिक सटीक होंगी।"
