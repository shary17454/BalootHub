      }
    },
    "راجع القيمة قبل الصعوبة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe den Wert vor der Schwierigkeit" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review value before difficulty" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa el valor antes de la dificultad" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révise la valeur avant la difficulté" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कठिनाई से पहले मूल्य की समीक्षा करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinjau nilai sebelum kesulitan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разбери ценность перед сложностью" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zorluktan önce değeri gözden geçir" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مشکل سے پہلے قدر کا جائزہ لیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先复盘价值，再提高难度" } }
      }
    },
    "قلل النقاط الضائعة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Reduziere verlorene Punkte" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reduce lost points" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Reduce los puntos perdidos" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réduis les points perdus" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खोए अंक घटाएँ" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kurangi poin hilang" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сократи потерянные очки" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kayıp puanı azalt" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ضائع پوائنٹس کم کریں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "减少损失分" } }
      }
    },
    "قبل الموقف التالي، احذف الخيارات الضعيفة ثم قارن اختيارك بأفضل ورقة وثاني أفضل ورقة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Streiche vor der nächsten Situation die schwachen Optionen und vergleiche deine Wahl dann mit der besten und zweitbesten Karte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Before the next scenario, remove weak options, then compare your choice with the best and second-best cards." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Antes del siguiente escenario, descarta las opciones débiles y compara tu elección con la mejor y la segunda mejor carta." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Avant le prochain scénario, élimine les options faibles, puis compare ton choix avec la meilleure et la deuxième meilleure carte." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अगले परिदृश्य से पहले कमजोर विकल्प हटाएँ, फिर अपने चुनाव की तुलना सबसे अच्छे और दूसरे सबसे अच्छे पत्ते से करें." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Sebelum skenario berikutnya, singkirkan opsi lemah, lalu bandingkan pilihanmu dengan kartu terbaik dan kedua terbaik." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перед следующим сценарием отбрось слабые варианты, затем сравни свой выбор с лучшей и второй лучшей картой." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonraki senaryodan önce zayıf seçenekleri ele, sonra seçimini en iyi ve ikinci en iyi kartla karşılaştır." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "اگلے منظرنامے سے پہلے کمزور انتخاب ہٹائیں، پھر اپنے انتخاب کا بہترین اور دوسرے بہترین پتے سے موازنہ کریں." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "进入下个局面前，先排除弱选项，再把你的选择与最佳和第二佳牌比较。" } }
      }
    },
    "جلسة مراجعة القيمة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wert-Review-Sitzung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Value review session" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sesión de revisión de valor" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Session de révision de valeur" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मूल्य समीक्षा सत्र" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Sesi tinjauan nilai" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сессия разбора ценности" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değer inceleme oturumu" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "قدر کا جائزہ سیشن" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "价值复盘训练" } }
      }
    },
    "راجع القيمة الضائعة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe den verlorenen Wert" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review lost value" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa el valor perdido" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révise la valeur perdue" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खोए मूल्य की समीक्षा करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinjau nilai yang hilang" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разбери потерянную ценность" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kayıp değeri gözden geçir" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ضائع قدر کا جائزہ لیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复盘损失价值" } }
      }
    },
    "أعد الجلسة وركّز على تقليل الفارق عن اختيار الخبير قبل رفع الصعوبة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wiederhole die Sitzung und konzentriere dich darauf, den Abstand zur Expertenwahl zu verringern, bevor du die Schwierigkeit erhöhst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Repeat the session and focus on reducing the gap from the expert choice before raising difficulty." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Repite la sesión y céntrate en reducir la diferencia con la elección del experto antes de subir la dificultad." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Répète la session et concentre-toi sur la réduction de l’écart avec le choix de l’expert avant d’augmenter la difficulté." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कठिनाई बढ़ाने से पहले सत्र दोहराएँ और विशेषज्ञ के चुनाव से अंतर कम करने पर ध्यान दें." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Ulangi sesi dan fokus mengurangi selisih dari pilihan ahli sebelum menaikkan kesulitan." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повтори сессию и сосредоточься на сокращении разрыва с выбором эксперта перед повышением сложности." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zorluğu artırmadan önce oturumu tekrarla ve uzman seçimiyle aradaki farkı azaltmaya odaklan." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مشکل بڑھانے سے پہلے سیشن دہرائیں اور ماہر کے انتخاب سے فرق کم کرنے پر توجہ دیں." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提高难度前，重复本训练并专注缩小与专家选择的差距。" } }
      }
    },
    "الدقة وحدها لا تكفي هنا؛ ركز على تقليل الفارق بين اختيارك واختيار الخبير قبل رفع المستوى." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Genauigkeit allein reicht hier nicht; konzentriere dich darauf, den Abstand zwischen deiner Wahl und der Expertenwahl zu verringern, bevor du das Niveau erhöhst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accuracy alone is not enough here; focus on reducing the gap between your choice and the expert choice before raising the level." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La precisión sola no basta aquí; céntrate en reducir la diferencia entre tu elección y la del experto antes de subir el nivel." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La précision seule ne suffit pas ici ; concentre-toi sur la réduction de l’écart entre ton choix et celui de l’expert avant d’augmenter le niveau." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "यहाँ केवल सटीकता काफी नहीं है; स्तर बढ़ाने से पहले अपने चुनाव और विशेषज्ञ के चुनाव के बीच का अंतर घटाने पर ध्यान दें." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Akurasi saja belum cukup di sini; fokuslah mengurangi selisih antara pilihanmu dan pilihan ahli sebelum menaikkan level." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Одной точности здесь недостаточно; сосредоточься на сокращении разрыва между своим выбором и выбором эксперта перед повышением уровня." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Burada yalnızca doğruluk yetmez; seviyeyi artırmadan önce seçiminle uzman seçimi arasındaki farkı azaltmaya odaklan." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "یہاں صرف درستگی کافی نہیں؛ سطح بڑھانے سے پہلے اپنے انتخاب اور ماہر کے انتخاب کے فرق کو کم کرنے پر توجہ دیں." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这里只看准确率还不够；提高等级前，先专注缩小你的选择与专家选择之间的差距。" } }
      }
    },
    "هدف الجلسة: متوسط نقاط ضائعة أقل من 4." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sitzungsziel: durchschnittlich weniger als 4 verlorene Punkte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Session goal: average lost points below 4." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Objetivo de la sesión: puntos perdidos promedio por debajo de 4." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Objectif de session : points perdus moyens sous 4." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सत्र लक्ष्य: औसत खोए अंक 4 से कम." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Target sesi: rata-rata poin hilang di bawah 4." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Цель сессии: средние потерянные очки ниже 4." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Oturum hedefi: ortalama kayıp puan 4’ün altında." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "سیشن کا ہدف: اوسط ضائع پوائنٹس 4 سے کم." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "训练目标：平均损失分低于 4。" } }
      }
    },
    "ابق على مستوى قريب وراجع لماذا اختار الخبير ورقة أعلى قيمة قبل رفع التحدي." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bleib auf einem nahen Niveau und prüfe, warum der Experte eine wertvollere Karte gewählt hat, bevor du die Herausforderung erhöhst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay near this level and review why the expert chose a higher-value card before raising the challenge." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantente cerca de este nivel y revisa por qué el experto eligió una carta de mayor valor antes de subir el reto." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reste proche de ce niveau et révise pourquoi l’expert a choisi une carte de plus grande valeur avant d’augmenter le défi." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "चुनौती बढ़ाने से पहले इसी स्तर के पास रहें और देखें कि विशेषज्ञ ने अधिक मूल्य वाला पत्ता क्यों चुना." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tetap di level yang dekat dan tinjau mengapa ahli memilih kartu bernilai lebih tinggi sebelum menaikkan tantangan." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Останься на близком уровне и разбери, почему эксперт выбрал карту с большей ценностью, прежде чем повышать сложность." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zorluğu artırmadan önce yakın bir seviyede kal ve uzmanın neden daha değerli bir kart seçtiğini incele." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "چیلنج بڑھانے سے پہلے اسی سطح کے قریب رہیں اور دیکھیں کہ ماہر نے زیادہ قدر والا پتا کیوں چنا." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先保持接近当前的难度，复盘专家为何选择价值更高的牌，再提高挑战。" } }
      }
    },
    "لا توجد خسارة قيمة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Wertverlust" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No value lost" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin pérdida de valor" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune valeur perdue" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कोई मूल्य नहीं खोया" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada nilai hilang" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Потери ценности нет" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değer kaybı yok" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "قدر کا کوئی نقصان نہیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有价值损失" } }
      }
    },
    "خسارة قيمة بسيطة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Geringer Wertverlust" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Small value loss" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pérdida de valor pequeña" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Petite perte de valeur" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "छोटी मूल्य हानि" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kehilangan nilai kecil" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Небольшая потеря ценности" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Küçük değer kaybı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "قدر کا معمولی نقصان" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "小幅价值损失" } }
      }
    },
    "خسارة قيمة متوسطة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mittlerer Wertverlust" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Moderate value loss" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pérdida de valor media" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Perte de valeur moyenne" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मध्यम मूल्य हानि" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kehilangan nilai sedang" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Средняя потеря ценности" } },
