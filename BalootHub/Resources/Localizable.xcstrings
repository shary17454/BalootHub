        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुलना करें कि सूट के कारण काटना या तुरुप बचाना बदला या नहीं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan apakah memotong atau menyimpan truf berubah karena simbol"
