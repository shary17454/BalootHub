    "اختيارك ليس أفضل ولا ثاني أفضل مسار محاكاة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wahl ist weder der beste noch der zweitbeste Simulationspfad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice is neither the best nor the second-best simulation path"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu elección no es la mejor ni la segunda mejor ruta de simulación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre choix n'est ni le meilleur ni le deuxième meilleur chemin de simulation"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका चुनाव न सर्वश्रेष्ठ है न दूसरा सर्वश्रेष्ठ सिमुलेशन रास्ता"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan Anda bukan jalur simulasi terbaik maupun kedua terbaik"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш выбор не является ни лучшим, ни вторым лучшим путем симуляции"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimin ne en iyi ne de ikinci en iyi simülasyon yolu"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انتخاب نہ بہترین ہے نہ دوسرا بہترین سیمولیشن راستہ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择既不是最佳也不是第二佳模拟路径"
          }
        }
      }
    },
    "ابدأ Replay بأفضل محاكاة ثم راقب متى تغيرت نقاط الجولة." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte das Replay mit der besten Simulation und beobachte, wann sich die Rundenpunkte ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start replay with the best simulation, then watch when the round points change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia el replay con la mejor simulación y observa cuándo cambian los puntos de la ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez le replay avec la meilleure simulation, puis observez quand les points de la manche changent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वश्रेष्ठ सिमुलेशन से रिप्ले शुरू करें, फिर देखें राउंड पॉइंट कब बदलते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai replay dengan simulasi terbaik, lalu lihat kapan poin ronde berubah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
