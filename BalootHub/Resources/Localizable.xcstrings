    "أنت لا تملك اللون المطلوب ويجب عليك القطع بالحكم وفق القاعدة الحالية." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास माँगा गया सूट नहीं है, इसलिए मौजूदा नियम के अनुसार आपको तुरुप काटना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя нет затребованной масти, поэтому по текущим правилам ты обязан козырять."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You don't hold the required suit, so you must trump under the current rules."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے پاس مطلوبہ رنگ نہیں، اس لیے موجودہ اصول کے تحت آپ کو ترپ کاٹنا ہوگا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有所需花色，按当前规则必须出将牌。"
          }
        }
      }
    },
