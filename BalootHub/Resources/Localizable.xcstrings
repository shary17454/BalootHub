    "في صن: الآس أعلى ثم 10 ثم K ثم Q ثم J ثم 9 ثم 8 ثم 7. في حكم: الولد (J) هو الأقوى في نوع الحكم يليه 9 ثم A ثم 10 ثم K ثم Q ثم 8 ثم 7، بينما بقية الأنواع تُرتَّب كما في صن." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Sun: Ace is highest, then 10, K, Q, J, 9, 8, 7. In Hokum: the Jack is strongest in the trump suit, followed by 9, then A, 10, K, Q, 8, 7 — while the other suits rank as in Sun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun : A, 10, K, Q, J, 9, 8, 7. Hokum : dans l'atout, Valet puis 9, A, 10, K, Q, 8, 7 ; les autres couleurs comme en Sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: A, 10, K, Q, J, 9, 8, 7. Hokum: en el triunfo, J y luego 9, A, 10, K, Q, 8, 7; los demás palos como en Sun."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: A, 10, K, Q, J, 9, 8, 7. Hokum: im Trumpf Bube, dann 9, A, 10, K, Q, 8, 7; andere Farben wie in Sun."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun'da: A en yüksek, sonra 10, K, Q, J, 9, 8, 7. Hokum'da: koz sembolünde Vale en güçlü, ardından 9, A, 10, K, Q, 8, 7; diğer semboller Sun'daki gibi sıralanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: A, 10, K, Q, J, 9, 8, 7. Hokum: в козыре валет, затем 9, A, 10, K, Q, 8, 7; прочие масти — как в Sun."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun میں: A سب سے اوپر، پھر 10، K، Q، J، 9، 8، 7۔ Hokum میں: ترپ رنگ میں غلام (J) سب سے مضبوط، پھر 9، A، 10، K، Q، 8، 7؛ باقی رنگ Sun کی طرح۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun में: A सबसे ऊपर, फिर 10, K, Q, J, 9, 8, 7। Hokum में: तुरुप सूट में गुलाम (J) सबसे मज़बूत, फिर 9, A, 10, K, Q, 8, 7; बाकी सूट Sun की तरह।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Sun: As tertinggi lalu 10, K, Q, J, 9, 8, 7. Di Hokum: Jack terkuat di simbol truf, lalu 9, A, 10, K, Q, 8, 7; simbol lain mengikuti urutan Sun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun 中：A 最大，其后 10、K、Q、J、9、8、7。Hokum 中：将牌花色里 J 最强，其后 9、A、10、K、Q、8、7；其余花色同 Sun。"
          }
        }
      }
    },
    "في نوع الحكم فقط: الولد (J) أقوى ورقة، يليه 9، ثم A، 10، K، Q، 8، 7. بقية الأنواع الثلاثة تُرتَّب كما في صن (A الأعلى وحتى 7 الأضعف)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the trump suit only: the Jack is the strongest card, followed by 9, then A, 10, K, Q, 8, 7. The other three suits rank as in Sun (A highest down to 7 lowest)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l'atout seul : le Valet est le plus fort, puis 9, A, 10, K, Q, 8, 7. Les trois autres couleurs suivent l'ordre Sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en el triunfo: la J es la más alta, luego 9, A, 10, K, Q, 8, 7. Los otros tres palos siguen el orden de Sun."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in der Trumpffarbe: Bube am stärksten, dann 9, A, 10, K, Q, 8, 7. Die anderen drei Farben wie in Sun."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız koz sembolünde: Vale en güçlü kart, ardından 9, A, 10, K, Q, 8, 7. Diğer üç sembol Sun'daki gibi sıralanır (A en yüksek, 7 en zayıf)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только в козырной масти: валет старший, затем 9, A, 10, K, Q, 8, 7. Остальные три масти — как в Sun."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف ترپ رنگ میں: غلام (J) سب سے مضبوط، پھر 9، A، 10، K، Q، 8، 7۔ باقی تین رنگ Sun کی طرح (A سب سے اوپر، 7 کمزور ترین)۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल तुरुप सूट में: गुलाम (J) सबसे मज़बूत, फिर 9, A, 10, K, Q, 8, 7। बाकी तीन सूट Sun की तरह (A सबसे ऊपर, 7 सबसे कमज़ोर)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya di simbol truf: Jack kartu terkuat, lalu 9, A, 10, K, Q, 8, 7. Tiga simbol lain mengikuti urutan Sun (A tertinggi hingga 7 terlemah)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在将牌花色中：J 最大，其后为 9、A、10、K、Q、8、7；其余三门按 Sun 的顺序（A 最大至 7 最小）。"
          }
        }
      }
    },
    "قد تختلف بعض التفاصيل بين المجالس والبطولات، ويمكن تعديل إعدادات التسجيل لتناسب القواعد المعتمدة لديكم." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Details unterscheiden sich je nach Runde und Turnier — du kannst die Einstellungen des Punktezählers an eure Regeln anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some details may vary between gatherings and tournaments — you can adjust the scorekeeper settings to match the rules your group follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos detalles varían entre grupos y torneos: puedes ajustar la configuración del marcador para adaptarla a las reglas de tu grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains détails varient selon les groupes et les tournois — vous pouvez ajuster les réglages du marqueur pour correspondre aux règles de votre groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ विवरण अलग-अलग महफ़िलों और टूर्नामेंटों में भिन्न हो सकते हैं — आप स्कोरकीपर की सेटिंग्स अपने समूह के नियमों के अनुसार समायोजित कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa detail dapat berbeda antar kelompok dan turnamen — Anda dapat menyesuaikan pengaturan pencatat skor dengan aturan kelompok Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые детали различаются в разных компаниях и турнирах — вы можете настроить счётчик под правила вашей группы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı ayrıntılar meclisler ve turnuvalar arasında değişebilir — puan tablosu ayarlarını grubunuzun kurallarına göre düzenleyebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کچھ تفصیلات مختلف محفلوں اور ٹورنامنٹس میں مختلف ہو سکتی ہیں — آپ اسکور کیپر کی ترتیبات اپنے گروپ کے قواعد کے مطابق ایڈجسٹ کر سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同牌局和赛事的部分细节可能不同——你可以调整计分器设置，以符合你们采用的规则。"
          }
        }
      }
    },
