    "يبدأ اللاعب الذي على يمين الموزّع، ويجب على بقية اللاعبين اتّباع نفس نوع الورقة الأولى إن توفر لديهم. في نمط حكم، من لا يملك النوع المطلوب ويملك حكمًا يجب أن يقطع به. يفوز بالأكلة صاحب أعلى ورقة من النوع المطلوب أو أعلى حكم." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player to the dealer's right leads, and the other players must follow the suit led if they hold it. In Hokum, a player without the suit led who holds a trump must trump. The trick goes to the highest card of the suit led, or the highest trump."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le joueur à droite du donneur entame ; les autres fournissent si possible. En Hokum, sans la couleur mais avec un atout, il faut couper. Le pli va à la plus haute carte de la couleur demandée ou au plus haut atout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el jugador a la derecha del repartidor; los demás siguen el palo si lo tienen. En Hokum, quien no lo tenga y tenga triunfo debe cortar. La baza es para la carta más alta del palo pedido o el triunfo más alto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spieler rechts vom Geber eröffnet; die anderen bedienen, wenn möglich. In Hokum muss stechen, wer die Farbe nicht hat, aber Trumpf. Der Stich geht an die höchste Karte der geforderten Farbe oder den höchsten Trumpf."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dağıtıcının sağındaki oyuncu başlar; diğerleri ellerinde varsa ilk kartın sembolüne uymalıdır. Hokum modunda, istenen sembolü olmayıp kozu olan kesmek zorundadır. Eli, istenen sembolün en yüksek kartı ya da en yüksek koz alır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заходит игрок справа от сдающего; остальные ходят в масть, если могут. В Hokum без масти, но с козырем — обязан козырять. Взятку берёт старшая карта затребованной масти или старший козырь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقسیم کار کے دائیں کھلاڑی سے آغاز؛ باقی کھلاڑی پہلے کارڈ کے رنگ کی پیروی کریں اگر ان کے پاس ہو۔ Hokum میں جس کے پاس مطلوبہ رنگ نہ ہو مگر ترپ ہو، اسے کاٹنا لازم۔ ہاتھ مطلوبہ رنگ کے سب سے اونچے کارڈ یا سب سے بڑے ترپ والے کا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाँटने वाले के दाएँ खिलाड़ी से शुरुआत; बाकी पहले कार्ड के सूट का पालन करें यदि उनके पास हो। Hokum में जिसके पास माँगा गया सूट न हो पर तुरुप हो, उसे काटना अनिवार्य। चाल माँगे गए सूट के सबसे ऊँचे कार्ड या सबसे बड़े तुरुप वाले की।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemain di kanan pembagi memulai; yang lain wajib mengikuti simbol kartu pertama bila punya. Pada mode Hokum, yang tak punya simbol tetapi memegang truf wajib memotong. Trik dimenangkan kartu tertinggi dari simbol yang diminta atau truf tertinggi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由发牌者右侧的玩家首攻；其余玩家若有该花色必须跟牌。在 Hokum 模式下，没有所需花色但持将牌者必须砍将。该墩由所需花色中最大的牌或最大的将牌获得。"
          }
        }
      }
    },
    "يتبع ترتيب صن أو حكم حسب النمط المُختار لهذه الجولة (المشاريع تُضاف فوقه ولا تُغيّره)." : {
