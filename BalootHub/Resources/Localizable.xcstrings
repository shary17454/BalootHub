    "لعبة ورق تجمع عدة جولات مختلفة الأهداف في دورة واحدة (تجنّب أوراق معيّنة، أو التخلص من كل الأوراق أولًا)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A card game that combines several rounds with different objectives in one cycle (avoiding certain cards, or shedding all your cards first)."
          }
        }
      }
    },
    "لعبة ورق ثنائية أو جماعية بسيطة تعتمد على مطابقة أو التخلص من الأوراق حسب قواعد متفق عليها." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple two-player or group card game based on matching or shedding cards according to agreed rules."
          }
        }
      }
    },
    "لعبة ورق جماعية شهيرة تعتمد على المزايدة لتحديد عدد الأكلات المستهدفة ونوع الحكم (الطرنيب)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A well-known team card game based on bidding to set a target number of tricks and the trump suit (the Tarneeb)."
          }
        }
      }
    },
    "لعبة ورق شعبية مستقلة عن البلوت، تعتمد على تجنّب أو جمع أوراق محددة حسب اتفاق اللاعبين." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A popular card game separate from Baloot, based on avoiding or collecting specific cards as the players agree."
          }
        }
      }
    },
