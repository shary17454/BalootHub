        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایسے فیصلے کا جائزہ لیں جس کی قدر راؤنڈ مکمل ہونے کے بعد بدلی، صرف موجودہ ٹرک میں نہیں۔"
