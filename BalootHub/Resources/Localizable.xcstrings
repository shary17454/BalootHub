    "ركز على مقارنة أفضل وثاني أفضل حتى تقل خسارة النقاط المتوقعة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on comparing best and second best until expected point loss drops."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez meilleur et deuxième meilleur jusqu'à réduire la perte de points attendus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el mejor y el segundo mejor hasta reducir la pérdida esperada de puntos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche Bestes und Zweitbestes, bis der erwartete Punktverlust sinkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beklenen puan kaybı azalana dek en iyi ile ikinciyi karşılaştırmaya odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивай лучший и второй лучший, пока ожидаемые потери очков не снизятся."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقع پوائنٹس کا نقصان کم ہونے تک بہترین اور دوسرے بہترین کا موازنہ کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपेक्षित अंक हानि घटने तक सर्वश्रेष्ठ व दूसरे की तुलना पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus membandingkan terbaik dan kedua sampai kerugian poin harapan turun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注对比最优与次优，直到期望失分下降。"
          }
        }
      }
    },
