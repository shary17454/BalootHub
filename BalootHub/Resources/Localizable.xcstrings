    "قبل تكرار الجلسة؛ هذا يربط التدريب بسبب الخسارة لا بعدد المحاولات فقط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before repeating the session; this ties practice to the cause of the loss, not just attempt count."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de refaire la session : cela relie l'entraînement à la cause de la perte, pas au nombre d'essais."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de repetir la sesión; esto liga la práctica a la causa de la pérdida, no solo al número de intentos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Wiederholen der Sitzung – das koppelt das Training an die Verlustursache, nicht nur an die Versuchszahl."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu tekrarlamadan önce; bu, antrenmanı deneme sayısına değil kayıp nedenine bağlar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед повтором сессии — это связывает тренировку с причиной потерь, а не с числом попыток."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیشن دہرانے سے پہلے؛ یہ مشق کو نقصان کی وجہ سے جوڑتا ہے، محض کوششوں کی گنتی سے نہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्र दोहराने से पहले; यह अभ्यास को हानि के कारण से जोड़ता है, केवल प्रयासों की संख्या से नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum mengulang sesi; ini mengaitkan latihan dengan sebab kerugian, bukan sekadar jumlah percobaan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在重做训练前——这样练习是围绕失分原因，而不只是尝试次数。"
          }
        }
      }
    },
