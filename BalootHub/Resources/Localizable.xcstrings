    "حل مواقف أكثر حتى يحدد المدرب هل أخطاؤك قريبة من الأفضل أم تخسر نقاطًا واضحة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solve more scenarios so the coach can tell whether your mistakes are close to best or clearly losing points."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolvez plus de situations pour savoir si vos erreurs frôlent le meilleur ou coûtent cher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelve más situaciones para saber si tus errores rozan lo mejor o pierden puntos claros."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löse mehr Situationen, damit klar wird, ob deine Fehler knapp sind oder klar Punkte kosten."
