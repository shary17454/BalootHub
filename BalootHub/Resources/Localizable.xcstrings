      }
    },
    "نتائج التدريب تشير إلى قراءة جيدة للمواقف. ارفع الصعوبة وراجع الفوارق الصغيرة بين أفضل وثاني أفضل ورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your training results show good scenario reading. Raise the difficulty and review the small gaps between the best and second-best card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos résultats montrent une bonne lecture : montez d'un niveau et étudiez les petits écarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus resultados muestran buena lectura; sube la dificultad y estudia las pequeñas diferencias."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ergebnisse zeigen gutes Lesen – steigere die Stufe und prüfe die kleinen Abstände."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman sonuçların durumları iyi okuduğunu gösteriyor. Zorluğu artır ve en iyi ile ikinci kart arasındaki küçük farkları gözden geçir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты показывают хорошее чтение — повышай сложность и изучай мелкие разрывы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تربیتی نتائج اچھی قرات دکھاتے ہیں۔ دشواری بڑھائیں اور بہترین و دوسرے کارڈ کے چھوٹے فرق دیکھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभ्यास परिणाम अच्छी पढ़ाई दिखाते हैं। कठिनाई बढ़ाएँ और सर्वश्रेष्ठ व दूसरे कार्ड के छोटे अंतर देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil latihanmu menunjukkan bacaan situasi yang baik. Naikkan kesulitan dan tinjau selisih kecil antara kartu terbaik dan kedua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练结果显示你读局面不错：提升难度，并复盘最优与次优牌之间的细微差距。"
          }
        }
      }
    },
