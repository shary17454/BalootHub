    "تلخّص الفرق بين ترتيب صن وترتيب حكم بمثال مباشر يوضح مكانة الشايب في نوع الحكم." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarizes the difference between the Sun and Hokum rankings with a direct example showing the Jack's place in the trump suit."
          }
        }
      }
    },
    "تلخّص فكرة أن كل ورقة لها قيمة نقاط تختلف حسب النمط، وأن الفريق صاحب أعلى مجموع يفوز بالجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarizes the idea that each card has a point value that varies by mode, and that the team with the higher total wins the round."
          }
        }
      }
    },
    "تلخّص قيم المشاريع الشائعة وتنبّه إلى أنها قد تختلف بين المجالس." : {
