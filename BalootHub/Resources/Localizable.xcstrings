          }
        }
      }
    },
    "أي اتصال شبكة أو أسماء لاعبين عن بُعد يغيّر إفصاح الخصوصية الحالي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any network connection or remote player names changes the current privacy disclosure."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute connexion réseau ou nom de joueur distant modifie la déclaration de confidentialité actuelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier conexión de red o nombre de jugador remoto cambia la declaración de privacidad actual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Netzwerkverbindung oder Namen entfernter Spieler ändern die aktuelle Datenschutzangabe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir ağ bağlantısı ya da uzak oyuncu adı, mevcut gizlilik beyanını değiştirir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое сетевое соединение или имена удалённых игроков меняют текущее раскрытие о приватности."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی بھی نیٹ ورک کنکشن یا دور کے کھلاڑیوں کے نام موجودہ رازداری اعلان کو بدل دیتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी नेटवर्क कनेक्शन या दूरस्थ खिलाड़ी नाम मौजूदा गोपनीयता घोषणा बदल देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi jaringan apa pun atau nama pemain jarak jauh mengubah pengungkapan privasi saat ini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何网络连接或远程玩家名称都会改变当前的隐私声明。"
          }
        }
      }
    },
    "هذا الإصدار يعمل بالكامل دون إنترنت ولا يفتح أي اتصال شبكة. البنود التالية توضّح ما جهّزناه في البنية استعدادًا للعب الجماعي لاحقًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This release works fully offline and opens no network connection. The items below show what the architecture already prepares for multiplayer later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version fonctionne entièrement hors ligne et n'ouvre aucune connexion réseau. Les points ci-dessous montrent ce que l'architecture prépare déjà pour le multijoueur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión funciona totalmente sin conexión y no abre ninguna conexión de red. Los puntos siguientes muestran lo que la arquitectura ya prepara para el multijugador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version läuft vollständig offline und öffnet keine Netzwerkverbindung. Die Punkte unten zeigen, was die Architektur bereits für Mehrspieler vorbereitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sürüm tamamen çevrimdışı çalışır ve hiçbir ağ bağlantısı açmaz. Aşağıdaki maddeler mimarinin çok oyunculu için neyi hazırladığını gösterir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия работает полностью офлайн и не открывает сетевых соединений. Пункты ниже показывают, что архитектура уже готовит для мультиплеера."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ نسخہ مکمل آف لائن چلتا ہے اور کوئی نیٹ ورک کنکشن نہیں کھولتا۔ نیچے کے نکات بتاتے ہیں کہ ڈھانچہ ملٹی پلیئر کے لیے کیا تیار کر چکا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह संस्करण पूरी तरह ऑफ़लाइन चलता है और कोई नेटवर्क कनेक्शन नहीं खोलता। नीचे के बिंदु दिखाते हैं कि आर्किटेक्चर मल्टीप्लेयर के लिए क्या तैयार कर चुका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilis ini bekerja sepenuhnya luring dan tidak membuka koneksi jaringan. Butir di bawah menunjukkan apa yang sudah disiapkan arsitektur untuk multipemain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本完全离线运行，不建立任何网络连接。下列条目说明架构已为日后的多人对战做了哪些准备。"
          }
        }
      }
    },
