          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择偏离分析"
          }
        }
      }
    },
    "عدد الاختيارات خارج أفضل خيارين مرتفع؛ توقف قبل اللعب واقرأ اللون المطلوب والحكم والنقاط الموجودة على الطاولة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of choices outside the top two is high; pause before playing and read the required suit, trump, and points on the table."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de choix hors du top 2 : marquez une pause et lisez couleur, atout et points sur table."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas elecciones fuera de las dos mejores; haz una pausa y lee palo, triunfo y puntos en la mesa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Wahlen außerhalb der Top 2 – halte inne und lies Farbe, Trumpf und Punkte am Tisch."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi iki seçeneğin dışındaki tercihlerin çok; oynamadan önce dur ve istenen sembolü, kozu ve masadaki puanları oku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много выборов вне двух лучших — остановись и прочти масть, козырь и очки на столе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہترین دو اختیارات سے باہر انتخاب زیادہ ہیں؛ کھیلنے سے پہلے رکیں اور مطلوبہ رنگ، ترپ اور میز پر موجود پوائنٹس پڑھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वश्रेष्ठ दो विकल्पों से बाहर के चयन अधिक हैं; खेलने से पहले रुकें और सूट, तुरुप व मेज़ के अंक पढ़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak pilihan di luar dua terbaik; berhentilah sejenak dan baca simbol yang diminta, truf, dan poin di meja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落在前两名之外的选择偏多：出牌前先停一下，读清所需花色、将牌与桌上的分数。"
          }
        }
      }
    },
