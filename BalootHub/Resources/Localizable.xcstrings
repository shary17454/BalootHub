    "راجع قرارًا تغيّرت قيمته بعد استكمال الجولة، لا الأكلة الحالية فقط." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe eine Entscheidung, deren Wert sich nach Abschluss der Runde geändert hat, nicht nur im aktuellen Stich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review a decision whose value changed after finishing the round, not just the current trick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa una decisión cuyo valor cambió al completar la ronda, no solo la baza actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révise une décision dont la valeur change après la manche complète, pas seulement le pli actuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस निर्णय की समीक्षा करें जिसका मूल्य पूरी राउंड के बाद बदला, सिर्फ मौजूदा ट्रिक में नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau keputusan yang nilainya berubah setelah ronde selesai, bukan hanya trik saat ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересмотри решение, ценность которого изменилась после завершения раунда, а не только текущей взятки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece mevcut elde değil, tur tamamlanınca değeri değişen bir kararı incele."
