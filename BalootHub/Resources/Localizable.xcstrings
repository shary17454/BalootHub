    "مجموع حكم = 152، ومجموع صن الأساسي = 130 (يُضاعف عادة إلى 260). القيم قابلة للتخصيص من إعدادات التسجيل حسب عرف المجلس." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hokum totals 152, and the base Sun total is 130 (usually doubled to 260). The values can be customized in the scorekeeper settings to match your group's custom."
          }
        }
      }
    },
    "مجموع نقاط أوراق جولة الحكم 152 نقطة: 62 نقطة من نوع الحكم و30 نقطة من كل نوع آخر (×3)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Hokum round's card points total 152: 62 points from the trump suit and 30 points from each of the other suits (×3)."
          }
        }
      }
    },
    "مجموع نقاط الأوراق في الجولة 120 نقطة، ويُضاف لها 10 نقاط لفريق آخر أكلة فيصبح المجموع 130، وتُضاعف عادة (×2) لتصبح 260 عند احتسابها ضمن هدف المباراة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card points in the round total 120, plus 10 points for the team taking the last trick, making 130 — usually doubled (×2) to 260 when counted toward the match target."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120 points de cartes plus 10 pour le dernier pli, soit 130, généralement doublés (×2) à 260 pour l'objectif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120 puntos de cartas más 10 por la última baza, total 130, normalmente doblado (×2) a 260 para el objetivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120 Kartenpunkte plus 10 für den letzten Stich ergeben 130 – meist verdoppelt (×2) auf 260 fürs Matchziel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eldeki kart puanları toplamı 120'dir; son eli alan takıma 10 puan eklenir ve toplam 130 olur, maç hedefine sayılırken genelde ikiyle çarpılıp 260'a çıkar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120 очков карт плюс 10 за последнюю взятку — 130, обычно удваивается (×2) до 260 в зачёт цели матча."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راؤنڈ میں کارڈ پوائنٹس 120، اور آخری ہاتھ لینے والی ٹیم کو 10 مزید، سو مجموعہ 130؛ میچ ہدف میں شمار کرتے وقت عموماً دگنا (×2) ہو کر 260۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड में कार्ड अंक 120, अंतिम चाल लेने वाली टीम को 10 और, कुल 130; मैच लक्ष्य में गिनते समय आमतौर पर दोगुना (×2) होकर 260।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total poin kartu dalam ronde 120, ditambah 10 untuk tim pemenang trik terakhir menjadi 130, dan biasanya dikalikan dua (×2) menjadi 260 saat dihitung ke target pertandingan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本局牌分共 120 分，最后一墩的队伍再加 10 分，合计 130；计入比赛目标时通常翻倍（×2）为 260。"
          }
        }
      }
    },
    "مخصصة للتعلّم الفردي، وتُطبَّق لاحقًا مع 4 لاعبين في جولة حقيقية." : {
