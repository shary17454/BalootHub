        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेलने से पहले देखें कि कोई कार्ड चाल आपकी टीम को दिला सकता है, न कि केवल कम नुक़सान वाला फेंकना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum bermain, cek apakah ada kartu yang memindahkan trik ke timmu, bukan sekadar membuang aman."
