          }
        }
      }
    },
    "الخطر القادم هو التعود على المواقف السهلة وعدم اختبار القراءة تحت ضغط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next risk is getting used to easy scenarios without testing reads under pressure."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risque : s'habituer au facile sans jamais tester la lecture sous pression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El riesgo: acostumbrarse a lo fácil sin probar la lectura bajo presión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gefahr: sich an Leichtes gewöhnen, ohne das Lesen unter Druck zu testen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risk: kolay durumlara alışıp okumayı baskı altında hiç sınamamak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Риск — привыкнуть к лёгкому и не проверять чтение под давлением."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطرہ یہ ہے کہ آسان صورتحال کی عادت پڑ جائے اور دباؤ میں قرات نہ آزمائی جائے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोखिम यह है कि आसान स्थितियों की आदत पड़ जाए और दबाव में पढ़ाई न परखी जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risikonya: terbiasa dengan situasi mudah tanpa menguji bacaan di bawah tekanan."
