        "id" : { "stringUnit" : { "state" : "translated", "value" : "Dampak pembuka" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эффект захода" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açılış etkisi" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "افتتاحی اثر" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开局影响" } }
      }
    },
    "لا تحسم الأكلة الآن" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entscheidet den Stich jetzt nicht" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Does not decide the trick yet" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no decide la baza" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ne décide pas encore le pli" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी बाज़ी तय नहीं करती" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum menentukan trik" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока не решает взятку" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eli henüz belirlemez" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابھی چال کا فیصلہ نہیں کرتی" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不决定这一墩" } }
      }
    },
    "لفريقك" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "für dein Team" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "for your team" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "para tu equipo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "pour ton équipe" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी टीम के लिए" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "untuk timmu" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "для вашей команды" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "takımın için" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی ٹیم کے لیے" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "给你的队伍" } }
      }
