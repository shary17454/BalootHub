        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मान्य प्रोजेक्ट" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Proyek valid" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Допустимый проект" } },
