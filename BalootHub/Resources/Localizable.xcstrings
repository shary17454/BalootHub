        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب کا طریقہ ایک ہی دور کے راؤنڈز میں بدلتا ہے، اور پوائنٹس دور کے اختتام تک جمع ہوتے رہتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गणना विधि एक ही चक्र के राउंड में बदलती है, और अंक चक्र के अंत तक जुड़ते रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara perhitungan berbeda antar ronde dalam siklus yang sama, dan poin terakumulasi hingga akhir siklus."
