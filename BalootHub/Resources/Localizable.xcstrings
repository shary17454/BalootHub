    "أعد نفس الموقف" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry the same scenario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejouer la même situation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite la misma situación"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieselbe Situation wiederholen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı durumu tekrar oyna"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторить ту же ситуацию"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی صورتحال دہرائیں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही स्थिति दोहराएँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi situasi yang sama"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重放同一局面"
          }
        }
      }
    },
    "الفرق بسيط؛ أعد الموقف مرة واحدة وحاول تمييز سبب ترجيح الخبير للورقة الأفضل." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gap is small; retry the scenario once and focus on why the expert preferred the best card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écart est mince : rejouez une fois et cernez pourquoi l'expert préfère cette carte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diferencia es mínima; repite una vez y descubre por qué el experto prefirió esa carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abstand ist gering – wiederhole einmal und erkenne, warum der Experte so wählt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fark küçük; durumu bir kez tekrarla ve uzmanın neden o kartı yeğlediğini ayırt et."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрыв мал — повтори один раз и пойми, почему эксперт выбрал ту карту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرق معمولی ہے؛ صورتحال ایک بار دہرائیں اور سمجھیں کہ ماہر نے وہ کارڈ کیوں ترجیح دیا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतर मामूली है; स्थिति एक बार दोहराएँ और समझें कि विशेषज्ञ ने वह कार्ड क्यों चुना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selisihnya kecil; ulangi situasi sekali dan pahami mengapa pakar memilih kartu itu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差距很小：重放一次，弄清专家为何偏好那张牌。"
          }
        }
      }
    },
    "لن تُحسب الإعادة كمحاولة جديدة. ركّز على الورقة الأفضل قبل الانتقال للموقف التالي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The retry will not count as a new attempt. Focus on the best card before moving to the next scenario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise ne compte pas comme nouvelle tentative : visez la meilleure carte avant de passer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reintento no cuenta como intento nuevo; céntrate en la mejor carta antes de avanzar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wiederholungsversuch zählt nicht neu – konzentriere dich auf die beste Karte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar yeni bir deneme sayılmaz. Sonraki duruma geçmeden en iyi karta odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтор не считается новой попыткой — сосредоточься на лучшей карте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دہرانا نئی کوشش شمار نہیں ہوگا۔ اگلی صورتحال سے پہلے بہترین کارڈ پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोहराना नया प्रयास नहीं गिना जाएगा। अगली स्थिति से पहले सर्वश्रेष्ठ कार्ड पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengulangan tidak dihitung sebagai percobaan baru. Fokus pada kartu terbaik sebelum lanjut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试不计为新的尝试：进入下一局面前，专注找出最佳出牌。"
          }
        }
      }
    },
