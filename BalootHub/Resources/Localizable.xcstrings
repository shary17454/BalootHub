        "id" : { "stringUnit" : { "state" : "translated", "value" : "Di luar kedua jalur" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вне обоих путей" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "İki yolun dışında" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "دونوں راستوں سے باہر" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不在两条路径内" } }
      }
    },
    "نسبة أفضل محاكاة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Quote beste Simulation" } },
