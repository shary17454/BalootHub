    "قارن هل القطع أو حفظ الحكم تغيّر بسبب اللون" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare whether trumping or saving trump changed because of the suit"
          }
        },
        "fr" : {
          "stringUnit" : {
