    "تفسير الفارق" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gap explanation"
          }
        }
      }
    },
    "الفارق الموجب يعني أن الصن أعلى من أفضل حكم في هذا التحليل." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A positive gap means sun is higher than the best hokum suit in this analysis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un écart positif signifie que Sun dépasse le meilleur Hokum dans cette analyse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una diferencia positiva significa que Sun supera al mejor Hokum en este análisis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein positiver Abstand heißt: Sun liegt über dem besten Hokum in dieser Analyse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitif fark, bu analizde Sun'ın en iyi Hokum'dan yüksek olduğunu gösterir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положительный разрыв означает, что Sun выше лучшего Hokum в этом разборе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبت فرق کا مطلب اس تجزیے میں Sun بہترین Hokum سے اوپر ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धनात्मक अंतर का अर्थ इस विश्लेषण में Sun सर्वश्रेष्ठ Hokum से ऊपर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selisih positif berarti Sun lebih tinggi dari Hokum terbaik dalam analisis ini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正差表示在本分析中 Sun 高于最佳 Hokum。"
          }
        }
      }
    },
    "الفارق السالب يعني أن أفضل حكم أعلى من الصن في هذا التحليل." : {
      "localizations" : {
        "en" : {
