    "النتيجة النهائية = نقاط الجولة (أكلات + مشاريع) × المضاعف المُعلَن (دبل ×2، ثري ×3، فور ×4 في الصيغة القياسية لهذا التطبيق، وقابلة للتغيير من الإعدادات)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final result = round points (tricks + projects) × the declared multiplier (Double ×2, Triple ×3, Quadruple ×4 in this app's standard formula, adjustable in Settings)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résultat = points (plis + projets) × multiplicateur annoncé (×2, ×3, ×4 par défaut, modifiable dans les réglages)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultado = puntos (bazas + proyectos) × multiplicador declarado (×2, ×3, ×4 por defecto, ajustable en ajustes)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergebnis = Punkte (Stiche + Projekte) × angesagter Multiplikator (×2, ×3, ×4 standardmäßig, in den Einstellungen änderbar)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nihai sonuç = el puanı (eller + projeler) × ilan edilen çarpan (bu uygulamanın standart formülünde Double ×2, Triple ×3, Quadruple ×4; Ayarlar'dan değiştirilebilir)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итог = очки (взятки + проекты) × объявленный множитель (×2, ×3, ×4 по умолчанию, меняется в настройках)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتمی نتیجہ = راؤنڈ کے پوائنٹس (ہاتھ + پروجیکٹس) × اعلان شدہ ضرب (اس ایپ کے معیاری صیغے میں ڈبل ×2، تھری ×3، فور ×4؛ ترتیبات سے بدلنے کے قابل)۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतिम परिणाम = राउंड अंक (चालें + प्रोजेक्ट) × घोषित गुणक (इस ऐप के मानक सूत्र में डबल ×2, ट्रिपल ×3, फोर ×4; सेटिंग्स से बदला जा सकता है)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil akhir = poin ronde (trik + proyek) × pengganda yang dideklarasikan (Double ×2, Triple ×3, Quadruple ×4 pada formula standar aplikasi ini, dapat diubah di Pengaturan)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最终结果 = 本局分数（墩分 + 项目分）× 所宣告的倍数（本应用标准公式为 Double ×2、Triple ×3、Quadruple ×4，可在设置中调整）。"
          }
        }
      }
    },
