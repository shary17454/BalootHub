    "أكمل هذه المواقف بنفس البذرة والصعوبة المقترحة من تقرير الجولة السابقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete these scenarios with the same seed and difficulty suggested by the previous round report."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez ces situations avec la graine et la difficulté suggérées par le rapport précédent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa estas situaciones con la semilla y dificultad sugeridas por el informe anterior."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absolviere diese Situationen mit Seed und Schwierigkeit aus dem vorigen Rundenbericht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu durumları önceki el raporunun önerdiği tohum ve zorlukla tamamla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройди эти ситуации с сидом и сложностью из отчёта прошлого раунда."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہی صورتحال کو پچھلی راؤنڈ رپورٹ کی تجویز کردہ سیڈ اور دشواری کے ساتھ مکمل کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन स्थितियों को पिछली राउंड रिपोर्ट द्वारा सुझाई सीड और कठिनाई से पूरा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan situasi ini dengan seed dan kesulitan yang disarankan laporan ronde sebelumnya."
          }
