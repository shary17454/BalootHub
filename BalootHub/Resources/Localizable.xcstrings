            "value" : "倍数"
          }
        }
      }
    },
    "الدبل دون تقييم حقيقي لقوة اليد، أو نسيان تسجيل المضاعف الصحيح في مسجّل النقاط." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubling without a real assessment of your hand's strength, or forgetting to record the correct multiplier in the scorekeeper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doubler sans évaluer sa main, ou oublier d'inscrire le bon multiplicateur au score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doblar sin evaluar la mano, u olvidar registrar el multiplicador correcto en el marcador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdoppeln ohne echte Handbewertung oder den richtigen Multiplikator nicht eintragen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elin gücünü gerçekten değerlendirmeden double demek ya da doğru çarpanı puan aracına yazmayı unutmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удваивать без оценки руки или забыть записать верный множитель в счёт."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہاتھ کی اصل قوت جانچے بغیر ڈبل کہنا، یا اسکور میں درست ضرب لکھنا بھول جانا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाथ की असली ताक़त आँके बिना डबल कहना, या स्कोर में सही गुणक दर्ज करना भूलना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggandakan tanpa menilai kekuatan kartu, atau lupa mencatat pengganda yang benar di pencatat skor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有真正评估手牌就加倍，或忘记在计分器中记录正确的倍数。"
          }
        }
      }
    },
