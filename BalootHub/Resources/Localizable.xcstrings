    "تُحتسب النتيجة حسب عدد الأوراق أو الأكلات المرصودة نهاية الجولة وفق الاتفاق المسبق." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result is calculated from the number of cards or tricks recorded at the end of the round, per the prior agreement."
          }
        }
      }
    },
    "تُحتسب النتيجة عادة بعدّ الأوراق المتبقية بيد كل لاعب خاسر في نهاية الجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result is usually calculated by counting the cards left in each losing player's hand at the end of the round."
          }
        }
      }
