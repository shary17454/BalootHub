    "راجع اللون المطلوب" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the required suit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyez la couleur demandée"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repasa el palo pedido"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geforderte Farbe prüfen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstenen sembolü gözden geçir"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь затребованную масть"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوبہ رنگ کا جائزہ لیں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माँगे गए सूट की समीक्षा करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau simbol yang diminta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复查所需花色"
          }
        }
      }
    },
    "ابدأ بمعرفة اللون المطلوب ثم قرر هل الفوز بالأكلة ممكن أو الأفضل تقليل الخسارة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start by identifying the required suit, then decide whether winning the trick is possible or reducing loss is better."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiez la couleur demandée, puis décidez : gagner le pli ou limiter la perte ?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica el palo pedido y luego decide: ¿ganar la baza o reducir la pérdida?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne die geforderte Farbe und entscheide dann: Stich gewinnen oder Verlust mindern?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce istenen sembolü belirle, sonra eli kazanmak mümkün mü yoksa kaybı azaltmak mı daha iyi karar ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определи затребованную масть, затем реши: взять взятку или снизить потери."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے مطلوبہ رنگ جانیں، پھر طے کریں کہ ہاتھ جیتنا ممکن ہے یا نقصان کم کرنا بہتر۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले माँगा गया सूट पहचानें, फिर तय करें कि चाल जीतना संभव है या हानि घटाना बेहतर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenali dulu simbol yang diminta, lalu putuskan bisa menang trik atau lebih baik menekan kerugian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先确认所需花色，再决定是能拿下这墩，还是减少损失更好。"
          }
        }
      }
    },
    "يوجد حكم على الطاولة؛ لا تصرف حكمًا أعلى إلا إذا كان العائد يستحق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is trump on the table; do not spend a higher trump unless the return is worth it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a de l'atout sur la table : ne montez pas plus haut sans retour suffisant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay triunfo en la mesa; no gastes uno mayor salvo que el retorno lo justifique."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es liegt Trumpf auf dem Tisch – stich nur höher, wenn sich der Ertrag lohnt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masada koz var; getirisi değmedikçe daha yüksek koz harcama."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На столе козырь — не трать старший козырь без достойной отдачи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میز پر ترپ ہے؛ بڑا ترپ تبھی خرچ کریں جب فائدہ اس کے قابل ہو۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेज़ पर तुरुप है; तभी बड़ा तुरुप खर्चें जब लाभ उसके योग्य हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada truf di meja; jangan buang truf lebih tinggi kecuali imbalannya sepadan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌上有将牌：除非回报值得，否则不要动更大的将。"
          }
        }
      }
    },
    "لا يوجد حكم على الطاولة؛ اسأل هل القطع الآن يحسم الأكلة أو يكشف قوتك مبكرًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no trump on the table; ask whether cutting now wins the trick or reveals your strength too early."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'atout sur la table : couper maintenant emporte-t-il le pli ou révèle-t-il trop tôt ?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay triunfo en la mesa; pregunta si cortar ahora gana la baza o revela tu fuerza pronto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Trumpf am Tisch – gewinnt Stechen jetzt den Stich oder verrät es dich zu früh?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masada koz yok; şimdi kesmek eli alır mı yoksa gücünü erken mi açar, sor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Козыря на столе нет — спроси: козырение сейчас берёт взятку или рано раскрывает силу?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میز پر ترپ نہیں؛ پوچھیں کہ ابھی کاٹنا ہاتھ جیتے گا یا آپ کی طاقت جلد کھول دے گا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेज़ पर तुरुप नहीं; पूछें कि अभी काटना चाल जिताएगा या ताक़त जल्दी खोल देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak ada truf di meja; tanyakan apakah memotong sekarang memenangkan trik atau membuka kekuatanmu terlalu dini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌上没有将牌：问自己，现在砍将能拿下这墩，还是过早暴露实力？"
          }
        }
      }
    },
    "رتّبها حسب الأثر المتوقع لا حسب أعلى ورقة فقط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rank them by expected impact, not only by the highest card."
          }
        }
      }
    },
