    "الخطأ الأكثر شيوعًا هو التعامل مع صن وكأن فيها نوعًا مفضّلًا، أو نسيان أن الآس هو الأقوى دائمًا هنا." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistake is treating Sun as though it had a favored suit, or forgetting that the Ace is always the strongest card here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur fréquente : croire qu'une couleur prime en Sun, ou oublier que l'As y est toujours le plus fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error frecuente: creer que en Sun hay un palo favorito, u olvidar que el As siempre es el más alto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häufiger Fehler: in Sun eine Vorzugsfarbe annehmen oder vergessen, dass das Ass immer am höchsten ist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En yaygın hata: Sun'da tercih edilen bir sembol varmış gibi davranmak ya da burada As'ın hep en güçlü olduğunu unutmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частая ошибка: считать, что в Sun есть привилегированная масть, или забыть, что туз всегда старший."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سب سے عام غلطی: Sun میں کسی رنگ کو ترجیحی سمجھنا، یا بھول جانا کہ یہاں اِکّہ ہمیشہ سب سے مضبوط ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे आम ग़लती: Sun में किसी सूट को वरीयता वाला मानना, या भूलना कि यहाँ इक्का हमेशा सबसे मज़बूत है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan paling umum: menganggap Sun punya simbol favorit, atau lupa bahwa As selalu paling kuat di sini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最常见的错误：以为 Sun 里有某门花色更优，或忘了 A 在这里永远最大。"
          }
        }
      }
    },
    "الخلط بين أهداف الجولات المختلفة داخل نفس الدورة، خصوصًا عند التبديل بين جولة تجنّب وجولة تجميع." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixing up the objectives of different rounds within the same cycle, especially when switching between an avoidance round and a collection round."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confondre les objectifs des manches d'un même cycle, surtout entre éviter et collecter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confundir los objetivos de rondas distintas del mismo ciclo, sobre todo entre evitar y reunir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziele verschiedener Runden im selben Zyklus verwechseln, besonders Meiden vs. Sammeln."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı döngüdeki farklı ellerin amaçlarını karıştırmak; özellikle kaçınma eliyle toplama eli arasında geçerken."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путать цели разных раундов в одном цикле, особенно при переходе от избегания к сбору."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی دور کے مختلف راؤنڈز کے مقاصد خلط ملط کرنا، خاص طور پر بچنے اور جمع کرنے کے راؤنڈ کے بیچ۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही चक्र के अलग राउंड के उद्देश्य मिला देना, विशेषकर बचने और जुटाने वाले राउंड के बीच।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencampur tujuan ronde berbeda dalam satu siklus, terutama saat berpindah dari ronde menghindar ke ronde mengumpulkan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混淆同一周期内不同小局的目标，尤其在「避开」与「收集」两类小局之间切换时。"
          }
        }
      }
    },
    "الخلط بين صيغ اللعب المختلفة المتداولة باسم هذه اللعبة دون اتفاق مسبق واضح." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixing up the different formats circulating under this game's name without a clear prior agreement."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confondre les variantes portant ce nom sans accord clair au préalable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezclar las variantes que circulan con este nombre sin un acuerdo previo claro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die unter diesem Namen kursierenden Varianten ohne klare Vorabsprache vermischen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oyunun adıyla dolaşan farklı formatları önceden net anlaşmadan karıştırmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смешивать разные варианты под этим названием без чёткой договорённости."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کھیل کے نام سے رائج مختلف صیغوں کو واضح پیشگی اتفاق کے بغیر ملانا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खेल के नाम से प्रचलित अलग प्रारूपों को स्पष्ट पूर्व सहमति बिना मिलाना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencampur berbagai format yang beredar dengan nama permainan ini tanpa kesepakatan jelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在没有事先明确约定时，混用以此名流传的不同赛制。"
          }
        }
      }
    },
    "الدبل" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiplikator"
          }
        },
        "en" : {
