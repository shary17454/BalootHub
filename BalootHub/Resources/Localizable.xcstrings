    "آخر محاولاتك تطابق أفضل قرار؛ جرّب صعوبة أعلى أو ركز على تفسير سبب التفوق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent attempts match the best decision; try a higher difficulty or focus on explaining why the best move wins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dernières tentatives collent au meilleur choix : montez ou expliquez pourquoi il gagne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimos intentos coinciden con la mejor decisión; sube el nivel o explica por qué gana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Versuche treffen das Beste – steigere oder erkläre, warum es gewinnt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son denemelerin en iyi kararla örtüşüyor; zorluğu artır ya da neden üstün olduğunu açıkla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние попытки совпадают с лучшим — повышай уровень или объясни, почему он лучше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی حالیہ کوششیں بہترین فیصلے سے ملتی ہیں؛ دشواری بڑھائیں یا برتری کی وجہ سمجھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हालिया प्रयास सर्वश्रेष्ठ निर्णय से मेल खाते हैं; कठिनाई बढ़ाएँ या श्रेष्ठता का कारण समझें।"
