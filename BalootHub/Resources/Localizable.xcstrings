    "تأكيد قبل الحذف أو التراجع" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Löschen oder Widerrufen bestätigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm Before Delete or Undo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmar antes de eliminar o deshacer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmer avant de supprimer ou d'annuler"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाने या पूर्ववत करने से पहले पुष्टि करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi Sebelum Hapus atau Urungkan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждать удаление и отмену"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silmeden veya geri almadan önce onayla"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف یا واپسی سے پہلے تصدیق کریں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除或撤销前确认"
          }
        }
      }
    },
    "تتبّع نقاط جلسة بلوت حقيقية بدقة، وإعلان الفريق الفائز فور بلوغ الهدف المتفق عليه." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track a real Baloot session's score accurately, and declare the winning team as soon as the agreed target is reached."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre précisément le score d'une vraie session et annoncer le vainqueur dès l'objectif atteint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir con precisión el marcador de una sesión real y anunciar al ganador al alcanzar el objetivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Punktestand einer echten Sitzung genau führen und den Sieger beim Zielwert ausrufen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek bir Baloot oturumunun puanını hatasız izlemek ve hedefe ulaşınca kazananı ilan etmek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точно вести счёт настоящей сессии и объявить победителя при достижении цели."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حقیقی بلوت سیشن کے پوائنٹس درست ٹریک کرنا، اور ہدف پہنچتے ہی جیتنے والی ٹیم کا اعلان۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असली बलूत सत्र के अंक सटीक ट्रैक करना, और लक्ष्य पहुँचते ही विजेता टीम घोषित करना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melacak skor sesi Baloot nyata dengan akurat, dan mengumumkan tim pemenang begitu target tercapai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确记录真实 Baloot 场次的分数，并在达到约定目标时立刻宣布获胜队伍。"
          }
        }
      }
    },
    "تجمع أكثر الأخطاء شيوعًا لدى المبتدئين في نقاط سريعة قبل اللعب الفعلي." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collects the most common beginner mistakes into quick points before real play."
          }
        }
      }
    },
    "تُجمع نقاط الأوراق التي يفوز بها كل فريق عبر الأكلات. في حكم يكون مجموع نقاط الجولة 152 نقطة، وفي صن 130 نقطة (تُضاعف عادة إلى 260 عند احتسابها ضمن هدف المباراة)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card points each team wins across the tricks are added up. In Hokum the round totals 152 points, and in Sun 130 points (usually doubled to 260 when counted toward the match target)."
          }
        }
      }
    },
    "تجهيز اللعب" : {
      "extractionState" : "stale",
      "localizations" : {
