    },
    "عند قراءة الموقف جيدًا تصل لاختيارات قريبة من الخبير." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you read the scenario well, you reach choices close to the expert."
