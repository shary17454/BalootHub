            "state" : "translated",
            "value" : "Aynı koz sembolünden iki durum çöz"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реши две ситуации с одной козырной мастью"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی ترپ رنگ سے دو صورتحال حل کریں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही तुरुप सूट की दो स्थितियाँ हल करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan dua situasi dengan truf sama"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解决同一将牌花色的两个局面"
          }
        }
      }
    },
    "هذه الخطة مبنية على تقرير الجولة السابقة، لذلك تُحسب منفصلة عن بقية تدريباتك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plan comes from the previous round report, so it is counted separately from your other practice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce plan vient du rapport de la manche précédente : il est compté séparément."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan procede del informe de la ronda anterior, así que se cuenta por separado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan stammt aus dem vorigen Rundenbericht und wird separat gezählt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu plan önceki el raporundan geliyor; bu yüzden diğer antrenmanlarından ayrı sayılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот план построен на отчёте прошлого раунда, поэтому считается отдельно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ منصوبہ پچھلی راؤنڈ رپورٹ پر مبنی ہے، اس لیے باقی مشقوں سے الگ شمار ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह योजना पिछली राउंड रिपोर्ट पर आधारित है, इसलिए बाकी अभ्यास से अलग गिनी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rencana ini berasal dari laporan ronde sebelumnya, jadi dihitung terpisah dari latihan lain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本计划源自上一局报告，因此与其他训练分开统计。"
          }
        }
      }
    },
    "هدف الجلسة: أنهي الدفعة بدقة 70% أو أعلى." : {
      "localizations" : {
