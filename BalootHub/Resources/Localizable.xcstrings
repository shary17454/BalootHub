    "أنشئ بطولة مجلس من 4 أو 8 فرق واعتمد بطلها حتى تدخل نتائج البطولات في مسيرتك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a 4- or 8-team majlis tournament and confirm its champion so tournament results count toward your career."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un tournoi de majlis à 4 ou 8 équipes et validez son champion pour l'inscrire à votre carrière."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un torneo de majlis de 4 u 8 equipos y confirma su campeón para que cuente en tu carrera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein Majlis-Turnier mit 4 oder 8 Teams und bestätige den Sieger, damit es zur Karriere zählt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 ya da 8 takımlı bir meclis turnuvası oluştur ve şampiyonunu onayla ki kariyerine işlensin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создай турнир меджлиса на 4 или 8 команд и подтверди чемпиона, чтобы он вошёл в карьеру."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 یا 8 ٹیموں کا مجلس ٹورنامنٹ بنائیں اور چیمپیئن طے کریں تاکہ نتائج آپ کے کیریئر میں آئیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 या 8 टीमों का मजलिस टूर्नामेंट बनाएँ और चैंपियन तय करें ताकि परिणाम करियर में जुड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat turnamen majelis 4 atau 8 tim dan tetapkan juaranya agar hasilnya masuk kariermu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建 4 队或 8 队的 Majlis 锦标赛并确认冠军，成绩才会计入生涯。"
          }
        }
      }
    },
