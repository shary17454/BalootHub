          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihum spielen, passen oder ziehen je nach Variante, bis eine Hand leer oder der Stapel aufgebraucht ist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyuncular, benimsenen formatın kurallarına göre sırayla oynar, eşleştirir ya da kart çeker; biri kartsız kalana ya da deste bitene dek sürer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По очереди играют, подбирают или тянут по варианту, пока рука не опустеет или колода не кончится."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھلاڑی منتخب صیغے کے اصولوں پر باری باری کھیلتے، ملاتے یا کارڈ کھینچتے ہیں، تاآنکہ کسی کا ہاتھ خالی ہو یا گڈی ختم ہو۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खिलाड़ी चुने प्रारूप के नियमों पर बारी-बारी खेलते, मिलाते या कार्ड खींचते हैं, जब तक किसी का हाथ खाली न हो या गड्डी समाप्त न हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemain bergiliran memainkan, mencocokkan, atau mengambil kartu sesuai aturan format, sampai ada yang kehabisan kartu atau dek habis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "玩家按所选赛制轮流出牌、配对或摸牌，直到有人出完手牌或牌堆耗尽。"
          }
        }
      }
    },
    "يتناوب اللاعبون على اللعب، مع الحرص على تجنّب أو جمع الأوراق ذات الأثر السلبي أو الإيجابي حسب قواعد المجلس." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Players take turns, taking care to avoid or collect the cards with a negative or positive effect according to the group's rules."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun joue à son tour en évitant ou collectant les cartes pénalisantes ou payantes selon l'usage."
