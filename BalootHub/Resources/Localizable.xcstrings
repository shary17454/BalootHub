{
  "sourceLanguage" : "ar",
  "strings" : {
    "الأثر المتوقع" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erwarteter Effekt" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Expected Impact" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Impacto esperado" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impact attendu" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपेक्षित प्रभाव" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Dampak yang Diharapkan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ожидаемый эффект" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklenen Etki" } },
