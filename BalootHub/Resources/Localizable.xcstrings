    "أداؤك متوسط ومستقر؛ أكمل عدة أسئلة بنفس المستوى حتى تبني سلسلة صحيحة قبل التصعيد." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your performance is steady but average; complete several questions at the same level before moving up."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau moyen mais stable : enchaînez des questions au même niveau pour bâtir une série."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimiento medio y estable; completa varias preguntas del mismo nivel para armar una racha."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchschnittlich, aber stabil – löse mehrere Fragen derselben Stufe für eine Serie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performansın orta ve istikrarlı; yükselmeden önce aynı seviyede birkaç soruyla seri kur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средне, но стабильно — набери серию на том же уровне до повышения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی کارکردگی اوسط اور مستحکم ہے؛ ترقی سے پہلے اسی سطح پر کئی سوال حل کر کے سلسلہ بنائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्रदर्शन औसत पर स्थिर है; बढ़ने से पहले उसी स्तर पर कई प्रश्न हल कर लड़ी बनाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performamu sedang tetapi stabil; kerjakan beberapa soal di level sama untuk membangun rentetan."
