            "state" : "translated",
            "value" : "Training priority"
          }
        }
      }
    },
    "تدرّب على اختيار ورقة البداية التي تكشف أقل معلومات وتحافظ على ورقة القوة للوقت المناسب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice choosing an opening card that reveals minimal information and preserves power cards for the right moment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez l'entame qui révèle le moins et garde la carte forte pour le bon moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica la salida que revele menos y guarde la carta fuerte para el momento adecuado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe die Eröffnung, die am wenigsten verrät und die starke Karte aufspart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az bilgi veren ve güçlü kartı doğru ana saklayan açılış kartını seçmeyi çalış."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренируй заход, который меньше выдаёт и бережёт сильную карту до нужного момента."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایسا پہلا کارڈ چننے کی مشق کریں جو کم سے کم معلومات دے اور مضبوط کارڈ صحیح وقت کے لیے بچائے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा शुरुआती कार्ड चुनने का अभ्यास करें जो कम जानकारी दे और मज़बूत कार्ड सही समय के लिए बचाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latih memilih kartu pembuka yang paling sedikit membocorkan info dan menyimpan kartu kuat untuk saat tepat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练习选择泄露信息最少、又能把强牌留到关键时刻的首攻牌。"
          }
        }
      }
    },
    "راجع التلزيم: ابدأ بمعرفة اللون المطلوب ثم قرر هل تكسب الأكلة أم تخفف خسارة النقاط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review following suit: start by identifying the required suit, then decide whether to win the trick or reduce point loss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyez la fourniture : couleur demandée d'abord, puis gagner ou limiter la perte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repasa el seguir el palo: primero el palo pedido, luego ganar la baza o reducir la pérdida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe das Bedienen: erst die geforderte Farbe, dann gewinnen oder Verlust mindern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uymayı gözden geçir: önce istenen sembolü belirle, sonra eli kazanmayı mı kaybı azaltmayı mı seç."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь ход в масть: сначала затребованная масть, потом взять или снизить потери."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلزیم دیکھیں: پہلے مطلوبہ رنگ جانیں، پھر طے کریں ہاتھ جیتنا ہے یا نقصان کم کرنا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूट पालन देखें: पहले माँगा गया सूट जानें, फिर तय करें चाल जीतें या हानि घटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau kewajiban mengikuti simbol: kenali simbol yang diminta dulu, lalu pilih menang trik atau menekan kerugian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复盘跟牌：先确认所需花色，再决定拿墩还是减损。"
          }
        }
      }
    },
    "ركّز على ضغط الحكم: لا تقطع بلا هدف، واحسب هل التعلية أو حفظ الحكم أقوى للفريق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on trump pressure: do not trump without a goal, and judge whether overtrumping or saving trump is stronger for the team."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez la pression d'atout : ne coupez pas sans but, surcoupez ou gardez selon l'équipe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Céntrate en la presión del triunfo: no cortes sin objetivo y evalúa si sobrecortar o guardar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeite am Trumpfdruck: stich nicht ziellos und wäge Übertrumpfen gegen Sparen ab."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koz baskısına odaklan: amaçsız kesme; üste çıkmak mı kozu saklamak mı takıma güçlü, hesapla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работай над козырным давлением: не козыряй без цели, взвесь перебить или сберечь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترپ کے دباؤ پر توجہ دیں: بلا مقصد نہ کاٹیں، اور سوچیں کہ اوپر جانا یا ترپ بچانا ٹیم کے لیے بہتر ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुरुप दबाव पर ध्यान दें: बिना उद्देश्य न काटें, और तय करें कि ऊपर काटना या तुरुप बचाना बेहतर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus pada tekanan truf: jangan memotong tanpa tujuan, dan timbang menaikkan truf atau menyimpannya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注将牌压力：不要无目的地砍将，权衡盖将与留将哪个对队伍更有利。"
          }
        }
      }
    },
    "في الخيارات المحدودة، قارن الأثر المتوقع لاختيارين فقط ولا ترم الورقة الأعلى تلقائيًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In narrow-choice spots, compare the expected impact of only two options and do not automatically throw the highest card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec peu d'options, comparez l'impact de deux cartes et ne jetez pas la plus haute par réflexe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con pocas opciones, compara el impacto de dos cartas y no tires la más alta por inercia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei wenigen Optionen vergleiche zwei Karten und wirf nicht reflexhaft die höchste."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçenek azken sadece iki seçeneğin beklenen etkisini karşılaştır; en yüksek kartı otomatik atma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При узком выборе сравни две карты и не сбрасывай старшую автоматически."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محدود اختیارات میں دو انتخاب کے متوقع اثر کا موازنہ کریں اور اونچا کارڈ خودبخود نہ پھینکیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमित विकल्पों में दो चयनों के अपेक्षित प्रभाव की तुलना करें और ऊँचा कार्ड स्वतः न फेंकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat pilihan terbatas, bandingkan dampak harapan dua opsi saja dan jangan otomatis membuang kartu tertinggi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择受限时，只比较两个选项的期望影响，别下意识丢最大的牌。"
          }
        }
      }
    },
