    "ابدأ موقفًا جديدًا بالمستوى المقترح بدل تكرار خطة أتقنتها." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a new scenario at the suggested level instead of repeating a plan you've mastered."
