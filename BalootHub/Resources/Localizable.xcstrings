    "الدقة أو أثر القرار منخفض؛ أعد نفس الخطة ولا ترفع الصعوبة بعد." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accuracy or decision impact is low; repeat the same plan and do not increase difficulty yet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision ou impact faible : refaites le même plan sans monter en difficulté."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisión o impacto bajos; repite el mismo plan y aún no subas la dificultad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit oder Wirkung sind niedrig – wiederhole den Plan, ohne zu steigern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğruluk ya da karar etkisi düşük; aynı planı tekrarla, zorluğu henüz artırma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность или влияние низкие — повтори тот же план, сложность пока не поднимай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درستگی یا فیصلے کا اثر کم ہے؛ وہی منصوبہ دہرائیں، ابھی دشواری نہ بڑھائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीकता या निर्णय प्रभाव कम है; वही योजना दोहराएँ, अभी कठिनाई न बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasi atau dampak keputusan rendah; ulangi rencana sama, jangan naikkan kesulitan dulu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准确率或决策影响偏低，请重做同一计划，暂不提升难度。"
          }
        }
      }
    },
    "أكملتها، لكن عدد القرارات المكلفة أعلى من هدف الخطة؛ أعدها وراجع Replay أفضل قرار." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You completed it, but costly decisions were above the plan target; repeat it and review the best-decision replay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminé, mais trop de décisions coûteuses : refaites et revoyez le replay du meilleur coup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completado, pero hubo demasiadas decisiones costosas; repítelo y revisa la repetición del mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeschlossen, aber zu viele teure Entscheidungen – wiederhole und sieh das Replay an."
