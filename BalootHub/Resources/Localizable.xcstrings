        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复盘模拟"
          }
        }
      }
    },
    "قرارك يطابق أفضل خيار في الأكلة الحالية، لكن محاكاة بقية الجولة تستحق المراجعة قبل تثبيت النمط." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Entscheidung entspricht der besten Option im aktuellen Stich, aber die Simulation der restlichen Runde sollte vor dem Festigen des Musters überprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decision matches the best option for the current trick, but the rest-of-round simulation is worth reviewing before locking in the pattern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu decisión coincide con la mejor opción de la baza actual, pero conviene revisar la simulación del resto de la ronda antes de fijar el patrón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta décision correspond à la meilleure option du pli actuel, mais la simulation du reste de la manche mérite d'être revue avant d'ancrer ce schéma."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका निर्णय मौजूदा ट्रिक के लिए सबसे अच्छे विकल्प से मेल खाता है, लेकिन पैटर्न पक्का करने से पहले बाकी राउंड की सिमुलेशन समीक्षा करनी चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusanmu cocok dengan opsi terbaik untuk trik saat ini, tetapi simulasi sisa ronde layak ditinjau sebelum pola itu dikunci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше решение совпадает с лучшим вариантом для текущей взятки, но симуляцию остатка раунда стоит проверить, прежде чем закреплять этот шаблон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararın mevcut el için en iyi seçenekle eşleşiyor, ancak bu kalıbı kesinleştirmeden önce turun kalan simülasyonunu gözden geçirmek gerekir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا فیصلہ موجودہ چال کے بہترین اختیار سے ملتا ہے، مگر اس انداز کو پکا کرنے سے پہلے باقی راؤنڈ کی سیمولیشن دیکھنا بہتر ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的决策符合当前一墩的最佳选择，但在固定这个模式前，值得复盘剩余整轮的模拟。"
          }
        }
      }
    },
    "اختيارك صحيح في الأكلة الحالية، لكن نتيجة الجولة الكاملة تشير إلى مسار أقوى." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wahl ist für den aktuellen Stich richtig, aber das Ergebnis der gesamten Runde zeigt einen stärkeren Weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice is correct for the current trick, but the full-round result points to a stronger line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu elección es correcta para la baza actual, pero el resultado de la ronda completa apunta a una línea más fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton choix est correct pour le pli actuel, mais le résultat de la manche complète indique une ligne plus forte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी चाल मौजूदा ट्रिक के लिए सही है, लेकिन पूरे राउंड का परिणाम एक मजबूत लाइन दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihanmu benar untuk trik saat ini, tetapi hasil ronde penuh menunjukkan jalur yang lebih kuat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш выбор верен для текущей взятки, но результат всего раунда указывает на более сильную линию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimin mevcut el için doğru, ancak tam tur sonucu daha güçlü bir hattı gösteriyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انتخاب موجودہ چال کے لیے درست ہے، مگر مکمل راؤنڈ کا نتیجہ ایک زیادہ مضبوط راستہ دکھاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择对当前一墩是正确的，但整轮结果指向更强的路线。"
          }
        }
      }
    },
    "قرارك يخسر بعد استكمال الجولة؛ راجع Replay كامل قبل لعب موقف جديد." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Entscheidung verliert nach Abschluss der Runde; prüfe das vollständige Replay, bevor du eine neue Situation spielst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decision loses after the round is completed; review the full replay before playing a new scenario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu decisión pierde al completar la ronda; revisa la repetición completa antes de jugar una nueva situación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta décision perd après la fin de la manche ; revois le replay complet avant de jouer une nouvelle situation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड पूरा होने के बाद आपका निर्णय अंक गंवाता है; नया परिदृश्य खेलने से पहले पूरा replay देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusanmu kalah setelah ronde selesai; tinjau replay penuh sebelum memainkan skenario baru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше решение проигрывает после завершения раунда; просмотрите полный повтор перед новым сценарием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararın tur tamamlandıktan sonra kaybettiriyor; yeni bir senaryo oynamadan önce tam replay'i incele."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راؤنڈ مکمل ہونے کے بعد آپ کا فیصلہ نقصان دیتا ہے؛ نیا منظر کھیلنے سے پہلے مکمل replay دیکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的决策在整轮完成后会失分；开始新局面前先复盘完整回放。"
          }
        }
      }
    },
    "جلسة مراجعة المحاكاة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulations-Review-Sitzung"
