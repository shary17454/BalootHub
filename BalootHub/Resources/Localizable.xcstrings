    "أكمل مباراة أو جلسة تسجيل حتى يبدأ سجل المسيرة من نتيجة حقيقية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish a match or a scorekeeping session so your career record starts from a real result."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez un match ou une session de score pour démarrer la carrière sur un vrai résultat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una partida o una sesión de anotación para que tu carrera parta de un resultado real."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende ein Match oder eine Zählsitzung, damit die Karriere mit einem echten Ergebnis startet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kariyer kaydın gerçek bir sonuçla başlasın diye bir maç ya da puan oturumu tamamla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заверши матч или сессию подсчёта, чтобы карьера началась с реального результата."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میچ یا اسکور سیشن مکمل کریں تاکہ کیریئر ریکارڈ حقیقی نتیجے سے شروع ہو۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैच या स्कोर सत्र पूरा करें ताकि करियर रिकॉर्ड असली परिणाम से शुरू हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan pertandingan atau sesi pencatatan agar rekam karier dimulai dari hasil nyata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成一场比赛或计分记录，让生涯档案从真实成绩开始。"
          }
        }
      }
    },
    "أنهِ جلسات تسجيل بلوت أو حل مواقف وش تلعب حتى يستطيع التطبيق تحليل أسلوب لعبك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish Baloot scorekeeping sessions or solve What-to-Play scenarios so the app can analyze your style."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez des sessions de score ou résolvez des situations pour que l'app analyse votre style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina sesiones de anotación o resuelve situaciones para que la app analice tu estilo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende Zählsitzungen oder löse Situationen, damit die App deinen Stil auswerten kann."
