    "آخر قراراتك صحيحة أو رابحة؛ استمر أو جرّب موقفًا أصعب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your latest decisions are correct or profitable; continue or try a harder scenario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dernières décisions sont bonnes ou payantes : continuez ou corsez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimas decisiones son correctas o rentables; sigue o prueba algo más difícil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Entscheidungen sind richtig oder gewinnbringend – weiter so oder schwerer."
