    "رفع قيمة نتيجة الجولة عبر تحدّي الفريق الخصم بمضاعفة الرهان قبل بدء اللعب، مع تحمّل مخاطرة أعلى عند الخسارة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise the round's value by challenging the opposing team with a stake multiplier before play begins, at the cost of greater risk if you lose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmenter la valeur de la manche en défiant l'adversaire par une surenchère, au prix d'un risque accru."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subir el valor de la ronda desafiando al rival con un multiplicador, asumiendo mayor riesgo si pierdes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Rundenwert erhöhen, indem man den Gegner mit einem Multiplikator herausfordert – bei höherem Risiko."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun başlamadan rakip takıma bahsi katlayarak meydan okuyup elin değerini yükseltmek; kaybetmede risk daha yüksektir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повысить ценность раунда, бросив вызов сопернику удвоением ставки — с большим риском при проигрыше."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھیل شروع ہونے سے پہلے حریف ٹیم کو شرط دگنی کر کے چیلنج دے کر راؤنڈ کی قیمت بڑھانا، ہارنے پر زیادہ خطرے کے ساتھ۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेल शुरू होने से पहले विपक्षी टीम को दाँव दोगुना कर चुनौती देकर राउंड का मूल्य बढ़ाना, हारने पर अधिक जोखिम के साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaikkan nilai ronde dengan menantang tim lawan lewat penggandaan taruhan sebelum bermain, dengan risiko lebih besar bila kalah."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开打前以加倍向对方叫阵，提升本局价值，代价是输时风险更大。"
          }
        }
      }
    },
