    "يتحقق عند مطابقة قرار الخبير في 5 مواقف من مدرب وش تلعب." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird freigeschaltet, wenn du in 5 Was spielst du?-Szenarien die Expertenentscheidung triffst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earned when you match the expert decision in 5 What to Play trainer scenarios."
          }
