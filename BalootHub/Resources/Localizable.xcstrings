    "تعذّر تحميل معلومات الشراء. تحقق من الاتصال وحاول مرة أخرى.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load purchase information. Check your connection and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les informations d'achat. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar la información de compra. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufinformationen konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma bilgileri yüklenemedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить информацию о покупке. Проверьте соединение и попробуйте снова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری کی معلومات لوڈ نہیں ہو سکیں۔ اپنا کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी की जानकारी लोड नहीं हो सकी। अपना कनेक्शन जाँचें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi pembelian tidak dapat dimuat. Periksa koneksi Anda lalu coba lagi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入购买信息。请检查网络连接后重试。"
          }
        }
      }
    },
