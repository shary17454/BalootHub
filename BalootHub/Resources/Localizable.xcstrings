    "درّب ألوان الحكم هذه أكثر" : {},
    "الحكم في البلوت يتغير كثيرًا حسب اللون؛ درّب كل لون حتى لا تنحاز لقراءة لون واحد." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'atout varie beaucoup selon la couleur : travaillez chaque couleur pour éviter tout biais."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El triunfo cambia mucho según el palo; practica cada palo para no sesgar tu lectura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Trumpf ändert sich stark je Farbe – übe jede Farbe, um keine Farbe zu bevorzugen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baloot'ta koz sembole göre çok değişir; tek renge yönelmemek için her sembolü çalış."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Baloot козырь сильно зависит от масти — тренируй все масти, чтобы не было перекоса."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلوت میں ترپ رنگ کے مطابق بہت بدلتا ہے؛ ہر رنگ کی مشق کریں تاکہ ایک رنگ کی طرف جھکاؤ نہ ہو۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बलूत में तुरुप सूट अनुसार बहुत बदलता है; हर सूट का अभ्यास करें ताकि झुकाव न बने।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Baloot truf sangat berubah menurut simbol; latih tiap simbol agar bacaanmu tidak berat sebelah."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baloot 中将牌因花色差异很大：每个花色都要练，避免只偏读一门。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Baloot the trump changes a lot by suit; practise every suit so you don't bias one read."
          }
        }
      }
    },
    "حل موقفين من نفس لون الحكم" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solve two scenarios with the same trump suit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
