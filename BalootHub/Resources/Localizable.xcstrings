    "نسيان اختيار المضاعف الصحيح، أو حفظ صكة بأرقام فارغة أو سالبة — والأداة تمنع ذلك تلقائيًا." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgetting to choose the correct multiplier, or saving a round with empty or negative numbers — which the tool prevents automatically."
          }
        }
      }
    },
    "نفس حزمة الـ32 ورقة، ويُختار نمط \"صن\" في مرحلة المزايدة بدل اختيار نوع حكم." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same 32-card deck, with \"Sun\" chosen during the bidding phase instead of picking a trump suit."
          }
        }
      }
    },
    "نفس مشاريع البلوت العامة قابلة للاتفاق عليها، باستثناء \"البلوت\" (شايب وبنت الحكم) لأنه لا يوجد نوع حكم في هذا النمط." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same general Baloot projects can be agreed on, except the \"Baloot\" (Jack and Queen of trump), since there is no trump suit in this mode."
          }
        }
      }
    },
    "نمط اللاعبين" : {

    },
    "نمط داخل البلوت لا يوجد فيه نوع حكم؛ يُحتسب كل الأنواع الأربعة بنفس ترتيب القوة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Baloot mode with no trump suit; all four suits rank by the same order of strength."
          }
        }
      }
    },
    "نمط داخل البلوت يُختار فيه نوع واحد يصبح \"الحكم\"، فيتفوق على بقية الأنواع، والشايب هو أقوى أوراقه." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Baloot mode where one suit is chosen as the \"Hokum\" (trump), outranking the others, with the Jack as its strongest card."
          }
        }
      }
    },
    "نمط يركّز على إعلان \"المشاريع\" (تتابعات وتكرارات في اليد) كمصدر إضافي للنقاط قبل بدء اللعب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mode focused on declaring \"projects\" (runs and sets in your hand) as an extra source of points before play begins."
          }
        }
      }
    },
    "نمط يعتمد على مضاعفة الرهان أثناء المزايدة (دبل، ثري، فور) قبل بدء اللعب، لرفع قيمة الجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mode built on raising the stakes during bidding (Double, Triple, Quadruple) before play begins, to increase the round's value."
          }
        }
      }
    },
