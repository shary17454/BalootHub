    "تُطفأ تلقائيًا إذا فعّلت \"تقليل الحركة\" في إعدادات النظام." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned off automatically if you enable \"Reduce Motion\" in system settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé automatiquement si vous activez « Réduire les animations » dans les réglages système."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactiva automáticamente si activas «Reducir movimiento» en los ajustes del sistema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird automatisch deaktiviert, wenn du „Bewegung reduzieren“ in den Systemeinstellungen aktivierst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem ayarlarında \"Hareketi Azalt\" açıksa otomatik olarak kapanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически отключается, если включить «Уменьшение движения» в настройках системы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر سسٹم سیٹنگز میں \"حرکت کم کریں\" آن ہو تو خودکار بند ہو جاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि सिस्टम सेटिंग्स में \"मोशन कम करें\" चालू है तो स्वतः बंद हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis mati jika Anda mengaktifkan \"Kurangi Gerak\" di pengaturan sistem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若在系统设置中开启“减弱动态效果”，将自动关闭。"
          }
        }
      }
    },
    "أشكال الأوراق وظهرها ولبس الطاولة والخلفية وصورة اللاعب والثيم. تُفتح الأنماط بالتقدّم في نمط المسيرة، بلا أي شراء." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card faces and backs, table felt, backdrop, player avatar and theme. Styles unlock through Career progress — never by purchase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faces et dos des cartes, tapis, arrière-plan, avatar et thème. Les styles se débloquent par la progression en Carrière, jamais par achat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caras y dorsos de cartas, tapete, fondo, avatar y tema. Los estilos se desbloquean con el progreso de Carrera, nunca comprando."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenvorder- und -rückseiten, Tischtuch, Hintergrund, Avatar und Design. Stile werden über den Karriere-Fortschritt freigeschaltet, nie durch Kauf."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart yüzleri ve arkaları, masa çuhası, arka plan, avatar ve tema. Stiller Kariyer ilerlemesiyle açılır, satın almayla değil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицо и рубашка карт, сукно стола, фон, аватар и тема. Стили открываются прогрессом в карьере, а не покупкой."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ کے رخ اور پشت، میز کی چادر، پس منظر، اوتار اور تھیم۔ انداز کیریئر کی پیش رفت سے کھلتے ہیں، خریداری سے نہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड के मुख और पीठ, मेज़ का कपड़ा, पृष्ठभूमि, अवतार और थीम। शैलियाँ करियर प्रगति से खुलती हैं, खरीद से नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muka dan punggung kartu, alas meja, latar, avatar, dan tema. Gaya terbuka lewat kemajuan Karier, bukan pembelian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牌面与牌背、桌布、背景、玩家头像与主题。样式通过生涯进度解锁，绝非购买。"
          }
        }
      }
    },
    "تُستخدم أصوات واجهة النظام مباشرة، فلا يحمل التطبيق أي ملفات صوت." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System interface sounds are used directly, so the app ships no audio files."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sons d'interface du système sont utilisés directement : l'app n'embarque aucun fichier audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan directamente los sonidos de la interfaz del sistema, así que la app no incluye archivos de audio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden direkt die System-Oberflächentöne verwendet; die App enthält keine Audiodateien."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrudan sistem arayüz sesleri kullanılır; uygulama hiçbir ses dosyası taşımaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются системные звуки интерфейса, поэтому приложение не содержит аудиофайлов."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سسٹم انٹرفیس کی آوازیں براہِ راست استعمال ہوتی ہیں، سو ایپ میں کوئی آڈیو فائل نہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम इंटरफ़ेस ध्वनियाँ सीधे उपयोग होती हैं, इसलिए ऐप में कोई ऑडियो फ़ाइल नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara antarmuka sistem dipakai langsung, jadi aplikasi tak membawa berkas audio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接使用系统界面音效，因此应用不附带任何音频文件。"
          }
        }
      }
    },
    "التطبيق يعمل دون إنترنت بالكامل. هذه الصفحة توضّح ما جُهِّز في البنية لدعم اللعب عن بُعد لاحقًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app works fully offline. This page shows what the architecture prepares for remote play later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app fonctionne entièrement hors ligne. Cette page montre ce que l'architecture prépare pour le jeu à distance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app funciona totalmente sin conexión. Esta página muestra lo que la arquitectura prepara para el juego remoto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App läuft vollständig offline. Diese Seite zeigt, was die Architektur für späteres Fernspiel vorbereitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama tamamen çevrimdışı çalışır. Bu sayfa, mimarinin uzaktan oyun için neyi hazırladığını gösterir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение работает полностью офлайн. На этой странице показано, что архитектура готовит для игры по сети."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ مکمل آف لائن چلتی ہے۔ یہ صفحہ بتاتا ہے کہ ڈھانچہ آگے دور کے کھیل کے لیے کیا تیار کرتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप पूरी तरह ऑफ़लाइन चलता है। यह पृष्ठ दिखाता है कि आर्किटेक्चर आगे रिमोट खेल के लिए क्या तैयार करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi bekerja sepenuhnya luring. Halaman ini menunjukkan apa yang disiapkan arsitektur untuk permainan jarak jauh nanti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用完全离线运行。本页说明架构为日后的远程对战做了哪些准备。"
          }
        }
      }
    },
    "كل الأنماط تُكسب باللعب والتدريب وحدهما." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every style is earned by playing and training alone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque style s'obtient uniquement en jouant et en s'entraînant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los estilos se ganan solo jugando y entrenando."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Stil wird allein durch Spielen und Training verdient."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm stiller yalnızca oynayarak ve antrenmanla kazanılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все стили открываются только игрой и тренировкой."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر انداز صرف کھیل اور مشق سے حاصل ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर शैली केवल खेलने और अभ्यास से मिलती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua gaya diperoleh hanya dengan bermain dan berlatih."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有样式仅通过对局与训练获得。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
