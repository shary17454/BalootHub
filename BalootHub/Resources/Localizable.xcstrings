        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہاتھ مکمل ہونے پر ایپ قوت کا اندازہ، بہترین بولی، پروجیکٹس اور تدبیری مشورہ دکھاتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाथ पूरा होने पर ऐप ताक़त, सर्वश्रेष्ठ बोली, प्रोजेक्ट और रणनीतिक सलाह दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
