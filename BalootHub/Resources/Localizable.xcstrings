    "التخلص من كل الأوراق في يد اللاعب قبل بقية اللاعبين، أو تحقيق أقل عدد نقاط متبقية بحسب الصيغة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shed all the cards in your hand before the other players, or end with the fewest remaining points depending on the format."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se défausser de toutes ses cartes avant les autres, ou finir avec le moins de points restants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacerse de todas las cartas antes que los demás, o acabar con menos puntos restantes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Karten vor den anderen ablegen oder mit den wenigsten Restpunkten enden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartlarını diğerlerinden önce bitirmek ya da formata göre en az kalan puanla bitirmek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить все карты раньше других или закончить с наименьшим остатком очков."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوسروں سے پہلے سارے کارڈ نکال دینا، یا فارمیٹ کے مطابق کم سے کم باقی پوائنٹس پر ختم کرنا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरों से पहले सारे कार्ड निकाल देना, या प्रारूप अनुसार सबसे कम शेष अंक पर समाप्त करना।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuang semua kartu di tangan lebih dulu dari pemain lain, atau berakhir dengan sisa poin paling sedikit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比其他玩家更早出清手牌，或按赛制以最少的剩余分结束。"
          }
        }
      }
    },
