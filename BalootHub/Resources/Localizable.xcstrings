    "تنتهي الجولة بانتهاء الأوراق، وتُعلن النتيجة بحسب الصيغة المعتمدة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when the cards run out, and the result is declared according to the format used."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manche s'achève à l'épuisement des cartes et le résultat suit le format retenu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda acaba al agotarse las cartas y el resultado se anuncia según el formato."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Runde endet, wenn die Karten aus sind; das Ergebnis richtet sich nach dem Format."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartlar bitince el sona erer ve sonuç seçilen formata göre açıklanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раунд заканчивается, когда карты выходят, а результат объявляют по формату."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ ختم ہونے پر راؤنڈ ختم اور نتیجہ منتخب فارمیٹ کے مطابق اعلان ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड समाप्त होने पर राउंड समाप्त और परिणाम चुने प्रारूप अनुसार घोषित होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde berakhir saat kartu habis, dan hasil diumumkan sesuai format."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牌出完则本局结束，按所采用的赛制公布结果。"
          }
        }
      }
    },
    "تنتهي الجولة بانتهاء كل الأوراق (13 أكلة)، وتُحدَّث النتيجة التراكمية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when all the cards are played (13 tricks), and the running total is updated."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manche s'achève après les 13 plis et le cumul est mis à jour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda acaba tras las 13 bazas y se actualiza el acumulado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Runde endet nach 13 Stichen; der Gesamtstand wird aktualisiert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm kartlar bitince (13 el) el sona erer ve toplam skor güncellenir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раунд заканчивается после 13 взяток, общий счёт обновляется."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام کارڈ (13 ہاتھ) ختم ہونے پر راؤنڈ ختم اور مجموعی نتیجہ اپ ڈیٹ ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सारे कार्ड (13 चालें) समाप्त होने पर राउंड खत्म और कुल स्कोर अपडेट होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde berakhir saat semua kartu habis (13 trik), dan total diperbarui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打完全部牌（13 墩）后本局结束，累计分随之更新。"
          }
        }
      }
    },
    "تنتهي الجولة بخلوّ يد أحد اللاعبين من الأوراق أو باستنفاد الحزمة الاحتياطية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when one player's hand is empty or the draw pile is exhausted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manche s'achève quand une main est vide ou que la pioche est épuisée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda acaba cuando una mano queda vacía o se agota el mazo de robo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Runde endet, wenn eine Hand leer ist oder der Nachziehstapel aufgebraucht ist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El, bir oyuncunun eli bitince ya da çekme destesi tükenince sona erer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раунд заканчивается, когда у игрока кончаются карты или иссякает колода добора."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راؤنڈ اس وقت ختم جب کسی کھلاڑی کا ہاتھ خالی ہو یا ذخیرہ گڈی ختم ہو جائے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड तब खत्म जब किसी का हाथ खाली हो या ड्रॉ ढेर समाप्त हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde berakhir saat tangan seorang pemain kosong atau tumpukan ambil habis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当某位玩家手牌出完或摸牌堆耗尽时，本局结束。"
          }
        }
      }
    },
    "تنتهي الجولة بعد الأكلات الثماني، وتُحتسب نقاط كل فريق وتُضاف إلى إجمالي الجلسة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends after the eight tricks, and each team's points are counted and added to the session total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manche s'achève après huit plis ; les points de chaque équipe s'ajoutent au total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ronda acaba tras ocho bazas y los puntos de cada equipo se suman al total."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Runde endet nach acht Stichen; die Teampunkte kommen zur Sitzungssumme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekiz elden sonra el biter; her takımın puanı hesaplanıp oturum toplamına eklenir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раунд заканчивается после восьми взяток; очки команд идут в общий счёт."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آٹھ ہاتھ کے بعد راؤنڈ ختم؛ ہر ٹیم کے پوائنٹس شمار ہو کر سیشن کے مجموعے میں شامل ہوتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आठ चालों के बाद राउंड समाप्त; हर टीम के अंक गिनकर सत्र के कुल में जुड़ते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde berakhir setelah delapan trik; poin tiap tim dihitung dan ditambahkan ke total sesi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "八墩打完本局结束，各队分数汇总并计入本场累计。"
          }
        }
      }
    },
    "تنتهي الجولة بعد لعب الأكلات الثماني وتُجمع النقاط لكل فريق." : {
