        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درستگی اور سلسلہ زیادہ پروجیکٹس اور ضربات والی اوپر کی سطح کی اجازت دیتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
