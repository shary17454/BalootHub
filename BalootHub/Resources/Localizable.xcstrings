    "أثرك مقبول لكن الدقة لم تصل؛ كرر نفس الخطة وراجع سبب كل رفض قانوني أو تكتيكي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your impact is acceptable but accuracy is short; repeat the same plan and review each legal or tactical rejection reason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impact correct mais précision insuffisante : refaites le plan et revoyez chaque refus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El impacto es aceptable pero falta precisión; repite el plan y repasa cada rechazo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirkung ist okay, Genauigkeit nicht – wiederhole den Plan und prüfe jede Ablehnung."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin kabul edilebilir ama doğruluk yetmedi; aynı planı tekrarla ve her ret gerekçesini gözden geçir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влияние приемлемо, но точность не дотянула — повтори план и разбери каждый отказ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا اثر قابلِ قبول ہے مگر درستگی نہیں پہنچی؛ وہی منصوبہ دہرائیں اور ہر انکار کی وجہ دیکھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्रभाव ठीक है पर सटीकता नहीं पहुँची; वही योजना दोहराएँ और हर अस्वीकृति का कारण देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dampakmu memadai tetapi akurasi belum tercapai; ulangi rencana dan tinjau tiap alasan penolakan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影响尚可但准确率未达标：重做同一计划，并复盘每次被判非法或不利的原因。"
          }
        }
      }
    },
