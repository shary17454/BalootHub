    "أنت تبدأ الأكلة: لا تكشف ورقتك القوية بلا سبب واضح." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are leading the trick: do not reveal a strong card without a clear reason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous entamez : ne dévoilez pas votre carte forte sans raison claire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú abres: no reveles tu carta fuerte sin un motivo claro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du eröffnest: Zeige deine starke Karte nicht ohne klaren Grund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eli sen açıyorsun: güçlü kartını net bir sebep olmadan gösterme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты заходишь: не раскрывай сильную карту без ясной причины."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ ہاتھ شروع کر رہے ہیں: بلاوجہ اپنا مضبوط کارڈ نہ کھولیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप चाल शुरू कर रहे हैं: बिना स्पष्ट कारण अपना मज़बूत कार्ड न दिखाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu membuka trik: jangan buka kartu kuatmu tanpa alasan jelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由你首攻：没有明确理由不要暴露强牌。"
          }
        }
      }
    },
    "ابدأ بحصر الأوراق القانونية من هذا اللون." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start by narrowing the legal cards from this suit."
          }
        }
      }
    },
    "لا يوجد لون مطلوب واضح؛ اقرأ الأوراق المطروحة قبل حساب الربح." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no clear required suit; read the played cards before calculating the win."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de couleur demandée claire : lisez les cartes jouées avant de calculer le gain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay palo pedido claro; lee las cartas jugadas antes de calcular la ganancia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine klare geforderte Farbe – lies die gespielten Karten vor der Gewinnrechnung."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net bir istenen sembol yok; kazancı hesaplamadan önce oynanan kartları oku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Явной затребованной масти нет — прочти сыгранные карты до подсчёта выигрыша."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی واضح مطلوبہ رنگ نہیں؛ نفع گننے سے پہلے کھیلے گئے کارڈ پڑھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई स्पष्ट माँगा गया सूट नहीं; लाभ गिनने से पहले खेले गए कार्ड पढ़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak ada simbol yang jelas diminta; baca kartu yang keluar sebelum menghitung untung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有明确的所需花色，先看已出的牌再算收益。"
          }
        }
      }
    },
    "الحكم موجود على الطاولة؛ لا تعلّي إلا إذا كان العائد يستحق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trump is already on the table; only overtrump when the return is worth it."
          }
        }
      }
    },
    "الحكم لم يظهر في الأكلة؛ احسب هل القطع الآن أفضل أم حفظ الحكم." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trump has not appeared in this trick; decide whether cutting now is better than saving trump."
          }
        }
      }
    },
    "صن: لا يوجد حكم، فقارن قوة اللون والنقاط بدل انتظار القطع." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: there is no trump, so compare suit strength and points instead of expecting a cut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun : pas d'atout, comparez force de couleur et points au lieu d'attendre une coupe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: no hay triunfo, compara fuerza de palo y puntos en vez de esperar un corte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: kein Trumpf – vergleiche Farbstärke und Punkte, statt auf Stechen zu warten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: koz yok; kesme beklemek yerine sembol gücünü ve puanları karşılaştır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: козыря нет — сравнивай силу масти и очки, а не жди козырения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: کوئی ترپ نہیں، سو کاٹنے کے انتظار کے بجائے رنگ کی قوت اور پوائنٹس کا موازنہ کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: कोई तुरुप नहीं, इसलिए काटने की प्रतीक्षा के बजाय सूट की ताक़त और अंक तोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun: tidak ada truf, jadi bandingkan kekuatan simbol dan poin alih-alih menunggu potongan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun：没有将牌，应比较花色实力与分数，而不是等着砍将。"
          }
        }
      }
    },
    "الأوراق قبل دورك" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards before your turn"
          }
        }
      }
    },
    "كلما زادت الأوراق زادت دقة حساب ربح الأكلة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More played cards make the trick-win calculation more precise."
          }
        }
      }
    },
    "خياراتك قليلة؛ اختر أقل خسارة متوقعة لا أعلى شكل للورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your options are limited; choose the lowest expected loss, not the highest-looking card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos options sont peu nombreuses : visez la moindre perte, pas la plus belle carte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes pocas opciones; elige la menor pérdida esperada, no la carta más vistosa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast wenige Optionen – wähle den geringsten erwarteten Verlust, nicht die schönste Karte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçeneğin az; en yüksek görünüşlü kartı değil, en az beklenen kaybı seç."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вариантов мало — выбирай наименьшие ожидаемые потери, а не самую красивую карту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختیارات کم ہیں؛ سب سے کم متوقع نقصان چنیں، نہ کہ سب سے بڑا کارڈ۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विकल्प कम हैं; सबसे कम अपेक्षित हानि चुनें, न कि सबसे बड़ा कार्ड।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihanmu sedikit; pilih kerugian harapan terkecil, bukan kartu paling besar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选不多：选期望损失最小的牌，而不是看起来最大的牌。"
          }
        }
      }
    },
