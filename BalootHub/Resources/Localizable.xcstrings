    "ستظهر هنا كل جلسات تسجيل البلوت النشطة والمنتهية.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your active and finished Baloot scorekeeper sessions will appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos sessions Baloot actives et terminées apparaîtront ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán todas tus sesiones de Baloot activas y finalizadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen all deine aktiven und beendeten Baloot-Sitzungen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin ve biten tüm Baloot oturumlarınız burada görünecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся все ваши активные и завершённые сессии Балут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے تمام فعال اور مکمل شدہ بلوت سیشنز یہاں دکھائی دیں گے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सभी सक्रिय और समाप्त बलूत सत्र यहाँ दिखाई देंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sesi Baloot Anda yang aktif dan selesai akan muncul di sini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所有进行中和已结束的巴鲁特会话都会显示在这里。"
          }
        }
      }
    },
    "سجّل جلسة بلوت جديدة، أو تابع جلسة قائمة": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new Baloot session, or continue an existing one"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une nouvelle session Baloot ou reprenez-en une"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión nueva de Baloot o continúa una existente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine neue Baloot-Sitzung oder setze eine bestehende fort"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir Baloot oturumu başlatın veya mevcut birine devam edin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните новую сессию Балут или продолжите текущую"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا بلوت سیشن شروع کریں یا موجودہ جاری رکھیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया बलूत सत्र शुरू करें, या मौजूदा जारी रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai sesi Baloot baru, atau lanjutkan yang sudah ada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新的巴鲁特会话，或继续已有的会话"
          }
        }
      }
    },
