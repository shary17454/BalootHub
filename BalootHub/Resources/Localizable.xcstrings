          }
        }
      }
    },
    "هذا المستوى يعطيك مواقف كافية لاختبار التلزيم والقطع وحماية الشريك بدون قفزة صعبة مبكرة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This level gives enough scenarios to test following suit, trumping, and protecting your partner without an early hard jump."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce niveau suffit pour tester fourniture, coupe et protection du partenaire sans saut brutal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nivel basta para probar seguir el palo, cortar y proteger al compañero sin un salto brusco."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stufe reicht, um Bedienen, Stechen und Partnerschutz ohne harten Sprung zu testen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seviye, erken zor bir sıçrama olmadan uymayı, kesmeyi ve eşi korumayı sınamaya yeter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого уровня хватает, чтобы проверить ход в масть, козырение и защиту партнёра без резкого скачка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ سطح تلزیم، کاٹنے اور ساتھی کی حفاظت جانچنے کے لیے کافی ہے، بغیر جلد کسی مشکل چھلانگ کے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्तर सूट पालन, काटना और साथी की रक्षा परखने हेतु पर्याप्त है, बिना कठिन छलांग के।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Level ini cukup untuk menguji mengikuti simbol, memotong, dan melindungi pasangan tanpa lompatan sulit terlalu dini."
