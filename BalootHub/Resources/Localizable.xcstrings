    "أنت تكرر قرارات قريبة من الخبير. ارفع الصعوبة أو ركز على مواقف الحكم لاختبار قراءة أقوى." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are repeating expert-like decisions. Raise the difficulty or focus on Hokum scenarios to test stronger reading."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous répétez des coups d'expert : montez d'un niveau ou ciblez le Hokum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repites decisiones de nivel experto; sube la dificultad o céntrate en situaciones de Hokum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du triffst wiederholt Expertenzüge – steigere die Stufe oder nimm Hokum-Situationen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzman düzeyinde kararları tekrarlıyorsun. Zorluğu artır ya da Hokum durumlarına odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты стабильно принимаешь экспертные решения — повысь уровень или возьми Hokum."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ ماہرانہ فیصلے دہرا رہے ہیں۔ دشواری بڑھائیں یا Hokum کی صورتحال پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप विशेषज्ञ-स्तर के निर्णय दोहरा रहे हैं। कठिनाई बढ़ाएँ या Hokum स्थितियों पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu terus membuat keputusan setara pakar. Naikkan kesulitan atau fokus ke situasi Hokum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在反复作出接近专家的决策：提升难度，或专攻 Hokum 局面以检验更强的读牌。"
          }
        }
      }
    },
    "استمر بالمقارنة" : {
      "localizations" : {
        "en" : {
