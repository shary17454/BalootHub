    "راجع ثاني أفضل محاكاة قبل اعتماد قرار يبدو صحيحًا." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe die zweitbeste Simulation, bevor du einer scheinbar richtigen Entscheidung vertraust." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review the second-best simulation before trusting a decision that looks correct." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa la segunda mejor simulación antes de confiar en una decisión que parece correcta." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revois la deuxième meilleure simulation avant de valider une décision qui semble correcte." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सही लगने वाले निर्णय पर भरोसा करने से पहले दूसरे सर्वोत्तम सिमुलेशन की समीक्षा करें." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinjau simulasi terbaik kedua sebelum mempercayai keputusan yang tampak benar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверьте вторую лучшую симуляцию, прежде чем доверять решению, которое кажется правильным." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Doğru görünen bir karara güvenmeden önce ikinci en iyi simülasyonu gözden geçir." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "درست لگنے والے فیصلے پر بھروسہ کرنے سے پہلے دوسری بہترین سیمولیشن کا جائزہ لیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在信任看似正确的决策前，先复盘第二佳模拟。" } }
      }
