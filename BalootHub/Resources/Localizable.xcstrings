    "الخطأ الأكثر شيوعًا هو التعامل مع صن وكأن فيها نوعًا مفضّلًا، أو نسيان أن الآس هو الأقوى دائمًا هنا." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most common mistake is treating Sun as though it had a favored suit, or forgetting that the Ace is always the strongest card here."
          }
        }
      }
    },
    "الخلط بين أهداف الجولات المختلفة داخل نفس الدورة، خصوصًا عند التبديل بين جولة تجنّب وجولة تجميع." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixing up the objectives of different rounds within the same cycle, especially when switching between an avoidance round and a collection round."
          }
        }
      }
    },
    "الخلط بين صيغ اللعب المختلفة المتداولة باسم هذه اللعبة دون اتفاق مسبق واضح." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixing up the different formats circulating under this game's name without a clear prior agreement."
          }
        }
      }
    },
