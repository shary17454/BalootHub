        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реши больше ситуаций, чтобы понять: ошибки близки к лучшему или явно теряют очки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزید صورتحال حل کریں تاکہ کوچ طے کرے کہ آپ کی غلطیاں بہترین کے قریب ہیں یا واضح نقصان دیتی ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "और स्थितियाँ हल करें ताकि कोच तय करे कि ग़लतियाँ श्रेष्ठ के करीब हैं या स्पष्ट अंक खोती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan lebih banyak situasi agar pelatih tahu apakah kesalahanmu tipis atau jelas merugikan."
