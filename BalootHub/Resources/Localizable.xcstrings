    "القرار ليس مكلفًا مباشرة، لكن مراجعة الفارق الصغير تثبت عادة اختيار أفضل ورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The decision is not directly costly, but reviewing the small gap reinforces the habit of choosing the best card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La décision n'est pas coûteuse, mais revoir l'écart ancre l'habitude du meilleur choix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La decisión no es costosa, pero repasar la diferencia afianza el hábito de elegir la mejor carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Entscheidung ist nicht teuer, doch der Blick auf den Abstand festigt die beste Wahl."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karar doğrudan pahalı değil ama küçük farkı gözden geçirmek en iyi kartı seçme alışkanlığını pekiştirir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решение не дорогое, но разбор малого разрыва закрепляет привычку брать лучшую карту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیصلہ براہِ راست مہنگا نہیں، مگر چھوٹے فرق کا جائزہ بہترین کارڈ چننے کی عادت پکی کرتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्णय सीधे महँगा नहीं, पर छोटे अंतर की समीक्षा सर्वश्रेष्ठ कार्ड चुनने की आदत पक्की करती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusannya tidak langsung mahal, tetapi meninjau selisih kecil memantapkan kebiasaan memilih kartu terbaik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一决策代价不大，但复盘细微差距能固化选最优牌的习惯。"
          }
        }
      }
    },
    "اقرأ بداية الأكلة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the trick lead"
          }
        },
        "fr" : {
          "stringUnit" : {
