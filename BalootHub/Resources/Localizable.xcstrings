        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay proyectos al estilo Baloot; el foco está en cumplir exactamente las bazas comprometidas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Projekte im Baloot-Sinn – im Fokus steht das genaue Einhalten der Stichzahl."
