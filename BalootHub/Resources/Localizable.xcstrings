    "تُستخدم حزمة من 32 ورقة (من 7 حتى الآس). يُحدَّد الموزّع الأول بالاتفاق أو بالقرعة، ثم يدور التوزيع بالتناوب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 32-card deck is used (7 through Ace). The first dealer is chosen by agreement or by draw, then the deal rotates."
          }
        }
      }
    },
    "تُستخدم حزمة ورق عادية أو مختصرة حسب عرف اللاعبين قبل البدء." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A standard or shortened deck is used, according to the players' custom, before starting."
          }
        }
      }
    },
    "تُستخدم حزمة ورق كاملة من 52 ورقة عادة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full 52-card deck is normally used."
          }
        }
      }
    },
    "تُستخدم حزمة ورق كاملة من 52 ورقة، وتُلعب عادة دورة من عدة جولات متتالية بأهداف مختلفة لكل جولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full 52-card deck is used, and a cycle of several consecutive rounds is usually played, each with a different objective."
          }
        }
      }
    },
