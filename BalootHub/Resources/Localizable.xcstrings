    "المشاريع المعتادة (كالبلوت) تُحتسب أولًا، ثم يُطبَّق المضاعف على المجموع الكلي." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The usual projects (such as the Baloot) are counted first, then the multiplier is applied to the overall total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets habituels (comme le Baloot) comptent d'abord, puis le multiplicateur s'applique au total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos habituales (como el Baloot) se cuentan primero y luego se aplica el multiplicador al total."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übliche Projekte (wie das Baloot) zählen zuerst, dann greift der Multiplikator auf die Summe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olağan projeler (Baloot gibi) önce sayılır, sonra çarpan toplam üzerine uygulanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычные проекты (например, Baloot) считаются первыми, затем множитель применяется к сумме."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عام پروجیکٹس (جیسے بلوت) پہلے شمار ہوتے ہیں، پھر کل مجموعے پر ضرب لگتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामान्य प्रोजेक्ट (जैसे बलूत) पहले गिने जाते हैं, फिर कुल पर गुणक लगता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek biasa (seperti Baloot) dihitung dulu, lalu pengganda diterapkan pada total."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常规项目（如 Baloot）先计入，然后对总分施加倍数。"
          }
        }
      }
    },
