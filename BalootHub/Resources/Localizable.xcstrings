    "اختياراتك غالبًا تطابق أفضل قرار أو تحافظ على قيمة متوقعة جيدة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices often match the best decision or preserve solid expected value."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos choix collent souvent au meilleur ou préservent une bonne valeur attendue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus elecciones suelen coincidir con la mejor o conservan buen valor esperado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wahlen treffen oft das Beste oder halten einen guten Erwartungswert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimlerin genelde en iyi kararla örtüşüyor ya da iyi bir beklenen değer koruyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои выборы чаще совпадают с лучшим или сохраняют хорошую ожидаемую ценность."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے انتخابات اکثر بہترین فیصلے سے ملتے ہیں یا اچھی متوقع قدر بچاتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चयन प्रायः सर्वश्रेष्ठ से मेल खाते हैं या अच्छा अपेक्षित मूल्य बचाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihanmu sering cocok dengan keputusan terbaik atau menjaga nilai harapan baik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择常与最优一致，或能保住不错的期望价值。"
          }
        }
      }
    },
    "تقرأ الأكلة وتختار الورقة الرابحة أو الأقل خسارة بثبات." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the trick and consistently choose the winning or least costly card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous lisez le pli et choisissez régulièrement la carte gagnante ou la moins coûteuse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees la baza y eliges con constancia la carta ganadora o la menos costosa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
