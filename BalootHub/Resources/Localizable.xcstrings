    "نسبة القرارات التي تخسر أثرًا كبيرًا مرتفعة. قبل لعب الورقة، قارنها بأفضل قرار واسأل: هل سأخسر أكلة أو أرمي نقاطًا بلا مقابل؟" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil der Entscheidungen mit hohem Wertverlust ist hoch. Vergleiche deine Karte vor dem Ausspielen mit der besten Entscheidung und frage dich: Verliere ich damit einen Stich oder werfe ich Punkte ohne Gegenwert weg?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A high share of your decisions loses major expected value. Before playing, compare the card with the best decision and ask: will I lose the trick or throw points away?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una proporción alta de tus decisiones pierde mucho valor esperado. Antes de jugar, compárala con la mejor decisión y pregunta: ¿pierdo la baza o regalo puntos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une part élevée de vos décisions perd beaucoup de valeur attendue. Avant de jouer, comparez la carte au meilleur choix et demandez-vous : vais-je perdre le pli ou donner des points ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कई निर्णय बड़ा अपेक्षित मूल्य गंवाते हैं। कार्ड खेलने से पहले उसे सर्वोत्तम निर्णय से तुलना करें और पूछें: क्या मैं बाजी हारूँगा या अंक बेकार दूँगा?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porsi keputusan yang kehilangan nilai besar cukup tinggi. Sebelum bermain, bandingkan kartu dengan keputusan terbaik dan tanyakan: apakah saya akan kalah trick atau membuang poin?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокая доля решений теряет значимую ожидаемую ценность. Перед ходом сравните карту с лучшим решением и спросите: потеряю ли я взятку или отдам очки впустую?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlarının önemli beklenen değer kaybettiren oranı yüksek. Kartı oynamadan önce en iyi kararla karşılaştır ve sor: eli mi kaybedeceğim, yoksa puanları boşa mı atacağım?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے فیصلوں میں بڑے متوقع اثر کے ضائع ہونے کی شرح زیادہ ہے۔ پتا پھینکنے سے پہلے اسے بہترین فیصلے سے ملائیں اور پوچھیں: کیا میں اکلة ہاروں گا یا پوائنٹ ضائع کروں گا؟"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有较多决策损失了大量预期价值。出牌前先和最佳决策比较，并问自己：我会输掉这一墩，还是白白送分？"
          }
        }
      }
    },
    "قراراتك قوية" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Entscheidungen sind stark"
          }
        },
        "en" : {
