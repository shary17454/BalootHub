    "اتبع اللون المطلوب ووازن بين ربح الأكلة وتقليل الخسارة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the required suit and balance winning the trick with reducing loss"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournissez la couleur et arbitrez entre gagner le pli et limiter la perte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue el palo pedido y equilibra ganar la baza con reducir la pérdida"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bediene die Farbe und wäge zwischen Stichgewinn und Verlustbegrenzung ab"
