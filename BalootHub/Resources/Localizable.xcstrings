    "رقم فوق ورمز تحت، الشكل المعتاد للتطبيق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rank on top, suit below — the app's usual look."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur en haut, couleur en bas — l'aspect habituel de l'app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor arriba y palo abajo: el aspecto habitual de la app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wert oben, Farbe unten – das gewohnte Aussehen der App."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstte değer, altta sembol — uygulamanın alışılmış görünümü."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение сверху, масть снизу — привычный вид приложения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوپر ویلیو، نیچے نشان — ایپ کی معمول کی شکل۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर मान, नीचे चिह्न — ऐप का सामान्य रूप।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai di atas, simbol di bawah — tampilan biasa aplikasi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上方点数、下方花色 —— 应用的常规外观。"
          }
        }
      }
    },
    "أرقام كبيرة تُقرأ بسهولة من بعد الذراع." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Large numbers you can read at arm's length."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grands chiffres lisibles à bout de bras."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Números grandes que se leen a un brazo de distancia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Zahlen, auf Armlänge gut lesbar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kol mesafesinden okunabilen büyük rakamlar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупные цифры, читаемые на расстоянии вытянутой руки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بڑے ہندسے جو بازو کے فاصلے سے پڑھے جا سکیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े अंक जो एक हाथ की दूरी से पढ़े जा सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angka besar yang terbaca dari jarak satu lengan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大号数字，一臂距离也能看清。"
          }
        }
      }
    },
    "أرقام عربية-هندية بطابع المجالس القديمة." : {
      "localizations" : {
