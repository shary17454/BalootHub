    "لا يجمع التطبيق أي بيانات شخصية، ولا يحتاج اتصالًا بالإنترنت. كل البيانات تُخزَّن محليًا على جهازك فقط." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App erfasst keine personenbezogenen Daten und benötigt keine Internetverbindung. Alle Daten werden nur lokal auf deinem Gerät gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app doesn't collect any personal data and doesn't need an internet connection. All data is stored locally on your device only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no recopila ningún dato personal ni necesita conexión a Internet. Todos los datos se guardan localmente solo en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app ne collecte aucune donnée personnelle et ne nécessite pas de connexion Internet. Toutes les données sont stockées localement sur votre appareil uniquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप कोई व्यक्तिगत डेटा एकत्र नहीं करता और न ही इसे इंटरनेट कनेक्शन की आवश्यकता है। सारा डेटा केवल आपके डिवाइस पर स्थानीय रूप से संग्रहीत होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi tidak mengumpulkan data pribadi apa pun dan tidak memerlukan koneksi internet. Semua data disimpan secara lokal hanya di perangkat Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не собирает никаких персональных данных и не требует подключения к интернету. Все данные хранятся только локально на вашем устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama hiçbir kişisel veri toplamaz ve internet bağlantısı gerektirmez. Tüm veriler yalnızca cihazınızda yerel olarak saklanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کوئی ذاتی ڈیٹا جمع نہیں کرتی اور نہ ہی اسے انٹرنیٹ کنکشن کی ضرورت ہے۔ تمام ڈیٹا صرف آپ کے آلے پر مقامی طور پر محفوظ ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 不收集任何个人数据，也不需要联网。所有数据仅存储在你的设备本地。"
          }
        }
      }
    },
