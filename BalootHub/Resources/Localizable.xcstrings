    "يجب اتّباع نفس النوع المطلوب إن توفر، وتختلف طريقة تحديد الفائز بكل جولة حسب هدفها الخاص ضمن الدورة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must follow the suit led if you hold it, and how the winner of each round is determined varies with that round's own objective within the cycle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut fournir si possible ; le vainqueur de chaque manche dépend de son objectif dans le cycle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay que seguir el palo si se tiene; el ganador de cada ronda depende de su objetivo en el ciclo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe muss bedient werden; wer die Runde gewinnt, hängt vom jeweiligen Zyklusziel ab."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elde varsa istenen sembole uymak zorunludur; her elin kazananı, döngüdeki kendi amacına göre belirlenir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходить в масть обязательно; победитель каждого раунда зависит от его цели в цикле."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوبہ رنگ ہو تو اس کی پیروی لازم، اور ہر راؤنڈ کا فاتح دور میں اس کے اپنے ہدف سے طے ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माँगा गया सूट हो तो पालन अनिवार्य, और हर राउंड का विजेता चक्र में उसके अपने उद्देश्य से तय होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajib mengikuti simbol yang diminta bila ada, dan penentuan pemenang tiap ronde berbeda sesuai tujuannya dalam siklus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有所需花色必须跟牌；每个小局的胜者取决于它在周期中的目标。"
          }
        }
      }
    },
    "يجب اتّباع نفس النوع المطلوب إن توفر. من لا يملكه ويملك ورقة حكم يجب أن يقطع بها ليفوز بالأكلة مؤقتًا، وإلا يجوز له التخلص من أي ورقة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must follow the suit led if you hold it. A player without it who holds a trump must play it to take the trick for the moment; otherwise they may discard any card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut fournir si possible ; sinon, qui a un atout doit couper pour prendre le pli, sans quoi il défausse librement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay que seguir el palo si se tiene; si no y hay triunfo, debe cortar para llevarse la baza, o si no descarta libremente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe muss bedient werden; wer sie nicht hat, aber Trumpf, muss stechen – sonst darf beliebig abgeworfen werden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elde varsa istenen sembole uymak zorunludur. Sembolü olmayıp kozu olan, eli geçici olarak almak için kozla kesmelidir; yoksa istediği kartı atabilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходить в масть обязательно; без неё, но с козырем — надо козырять, иначе можно сбросить любую карту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوبہ رنگ ہو تو پیروی لازم۔ جس کے پاس نہ ہو مگر ترپ ہو، اسے کاٹ کر ہاتھ عارضی طور پر جیتنا ہوگا، ورنہ کوئی بھی کارڈ پھینک سکتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माँगा गया सूट हो तो पालन अनिवार्य। जिसके पास न हो पर तुरुप हो, उसे काटकर चाल अस्थायी रूप से लेनी होगी, अन्यथा कोई भी कार्ड फेंक सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajib mengikuti simbol yang diminta bila ada. Yang tak punya tetapi memegang truf harus memotong untuk sementara memenangi trik; jika tidak, boleh membuang kartu apa pun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有所需花色必须跟牌；没有但持将牌者必须砍将以暂时拿下该墩，否则可任意垫牌。"
          }
        }
      }
    },
    "يجب اتّباع نفس نوع الورقة الأولى في كل أكلة إن توفر لدى اللاعب؛ لا يوجد إلزام بالقطع لأنه لا يوجد نوع حكم." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must follow the suit led in every trick if you hold it; there is no obligation to trump, since there is no trump suit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut fournir à chaque pli si possible ; aucune obligation de couper puisqu'il n'y a pas d'atout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay que seguir el palo en cada baza si se tiene; no hay obligación de cortar porque no hay triunfo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In jedem Stich muss bedient werden, wenn möglich; Stechpflicht entfällt, da es keinen Trumpf gibt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elde varsa her elde ilk kartın sembolüne uymak zorunludur; koz olmadığı için kesme zorunluluğu yoktur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждой взятке нужно ходить в масть, если она есть; козырять не обязано — козыря нет."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر ہاتھ میں پہلے کارڈ کے رنگ کی پیروی لازم اگر موجود ہو؛ ترپ نہ ہونے کی وجہ سے کاٹنا لازم نہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर चाल में पहले कार्ड के सूट का पालन अनिवार्य यदि हो; तुरुप न होने से काटना अनिवार्य नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajib mengikuti simbol kartu pertama di tiap trik bila punya; tidak ada kewajiban memotong karena tak ada truf."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每墩若有所需花色必须跟牌；因为没有将牌，所以没有必须砍将的规定。"
          }
        }
      }
    },
    "يُحتسب الفارق بين الأكلات المُلتزَم بها والأكلات المُحقَّقة فعليًا، وقد تُخصم نقاط عند عدم الوفاء بالالتزام حسب الصيغة المعتمدة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The difference between the tricks committed to and the tricks actually won is calculated, and points may be deducted for falling short, depending on the format used."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On calcule l'écart entre plis promis et réalisés ; un manquement peut coûter des points selon la variante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se calcula la diferencia entre bazas prometidas y logradas; incumplir puede restar puntos según la variante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Unterschied zwischen zugesagten und erzielten Stichen wird berechnet; Verfehlen kostet je nach Variante Punkte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söz verilen el sayısı ile gerçekte alınan eller arasındaki fark hesaplanır; formata göre sözü tutmamak puan kaybettirebilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается разница между обещанными и взятыми взятками; недобор может стоить очков по варианту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وعدہ کیے گئے اور اصل جیتے گئے ہاتھوں کا فرق نکالا جاتا ہے، اور فارمیٹ کے مطابق وعدہ پورا نہ ہونے پر پوائنٹس کٹ سکتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वादा किए और वास्तव में जीते चालों का अंतर निकाला जाता है, और प्रारूप अनुसार वादा पूरा न होने पर अंक कट सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selisih antara trik yang dijanjikan dan yang benar-benar diraih dihitung, dan poin bisa dikurangi bila gagal memenuhinya sesuai format."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算承诺墩数与实际所得墩数之差；按赛制，未兑现可能扣分。"
          }
        }
      }
    },
    "يُحسب إجمالي كل فريق تلقائيًا كمجموع كل الصكات المحفوظة، مع تطبيق المضاعف على كل صكة بحسب صيغة التسجيل المختارة من الإعدادات." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each team's total is calculated automatically as the sum of all saved rounds, applying the multiplier to each round according to the scoring formula chosen in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total de chaque équipe s'additionne automatiquement, multiplicateur appliqué par donne selon la formule choisie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
