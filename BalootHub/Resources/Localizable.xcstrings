        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change between the start of training and your latest attempts is limited; focus on improving quality, not only volume."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu d'évolution depuis le début : misez sur la qualité, pas seulement le volume."
