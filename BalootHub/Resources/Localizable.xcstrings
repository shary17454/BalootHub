    },
    "دقتك أفضل من أثر قراراتك؛ ركز على اختيار الورقة الأعلى قيمة لا الورقة الصحيحة فقط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your accuracy is better than your decision impact; focus on the highest-value card, not only a technically correct card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre précision dépasse votre impact : visez la carte la plus rentable, pas seulement la bonne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu precisión supera tu impacto; busca la carta de mayor valor, no solo la correcta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Genauigkeit übertrifft die Wirkung – wähle die wertvollste Karte, nicht nur die richtige."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğruluğun karar etkinden iyi; yalnızca doğru kartı değil, en değerli kartı seçmeye odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность выше влияния — выбирай самую ценную карту, а не просто верную."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی درستگی اثر سے بہتر ہے؛ صرف درست نہیں، سب سے قیمتی کارڈ چننے پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सटीकता प्रभाव से बेहतर है; केवल सही नहीं, सर्वाधिक मूल्यवान कार्ड चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasimu lebih baik dari dampaknya; fokus memilih kartu paling bernilai, bukan sekadar benar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的准确率高于决策影响：要挑价值最高的牌，而不只是「不算错」的牌。"
          }
        }
      }
    },
