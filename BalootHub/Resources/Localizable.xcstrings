          }
        }
      }
    },
    "أكثر من خطأ حديث جاء في مواقف حكم أو وفيها حكم على الطاولة. راقب قوة الحكم المتبقية ولا تقطع إلا إذا كان القطع يربح الأكلة أو يحمي نقاط الفريق." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere aktuelle Fehler entstanden in Trumpfsituationen oder wenn Trumpf auf dem Tisch lag. Beobachte die verbleibende Trumpfstärke und stich nur, wenn es den Stich gewinnt oder Teampunkte schützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one recent mistake came in trump situations or with trump on the table. Watch the remaining trump strength, and trump in only when it wins the trick or protects team points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de un error reciente ocurrió en situaciones de triunfo o con triunfo en la mesa. Vigila la fuerza de triunfo restante y corta solo si ganas la baza o proteges puntos del equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs erreurs récentes viennent de situations d'atout ou avec de l'atout sur la table. Surveille la force d'atout restante et coupe seulement si cela gagne le pli ou protège les points de l'équipe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक से अधिक हाल की गलती हुकुम स्थितियों में या मेज़ पर हुकुम होने पर हुई। बची हुई हुकुम ताकत देखें और तभी काटें जब उससे बाज़ी जीते या टीम के अंक बचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih dari satu kesalahan terbaru terjadi dalam situasi trump atau saat trump ada di meja. Perhatikan kekuatan trump tersisa, dan potong hanya jika itu memenangkan trik atau melindungi poin tim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько последних ошибок были в козырных ситуациях или когда козырь уже был на столе. Следите за оставшейся силой козырей и перебивайте только если это выигрывает взятку или защищает очки команды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla son hata koz durumlarında ya da masada koz varken geldi. Kalan koz gücünü izle ve yalnızca eli kazanacaksa veya takım puanını koruyacaksa kozla kes."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک سے زیادہ حالیہ غلطی حکم کے حالات میں یا میز پر حکم ہونے پر ہوئی۔ باقی حکم کی طاقت دیکھیں، اور تبھی کاٹیں جب اس سے چال جیتے یا ٹیم کے پوائنٹس بچیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不止一次近期失误发生在将牌局面或桌上已有将牌时。观察剩余将牌强度，只有在能赢墩或保护队伍分数时才用将牌切。"
          }
        }
      }
    },
    "تبتعد عن أفضل خيارين" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entfernst dich von den zwei besten Optionen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You drift from the top two options"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te alejas de las dos mejores opciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'éloignes des deux meilleurs choix"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप शीर्ष दो विकल्पों से दूर जा रहे हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menjauh dari dua pilihan teratas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уходите от двух лучших вариантов"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk iki seçenekten uzaklaşıyorsun"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ بہترین دو انتخاب سے دور جا رہے ہیں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你偏离了前两个最佳选择"
          }
        }
      }
    },
    "الأخطاء الأخيرة ليست حول ثاني أفضل ورقة فقط؛ أكثر من اختيار جاء خارج أول خيارين. قبل اللعب، احذف الخيارات الضعيفة أولًا ثم قارن الأفضل والثاني." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten Fehler lagen nicht nur nahe an der zweitbesten Karte; mehrere Entscheidungen lagen außerhalb der ersten zwei Optionen. Streiche zuerst schwache Optionen und vergleiche dann die beste mit der zweiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent mistakes were not just around the second-best card; several choices fell outside the top two. Before playing, eliminate weak options first, then compare best and second best."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los errores recientes no estuvieron solo cerca de la segunda mejor carta; varias elecciones quedaron fuera de las dos primeras. Antes de jugar, elimina primero las opciones débiles y luego compara la mejor y la segunda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les erreurs récentes ne tournaient pas seulement autour de la deuxième meilleure carte ; plusieurs choix étaient hors des deux premiers. Avant de jouer, écarte d'abord les options faibles, puis compare la meilleure et la deuxième."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की गलतियाँ सिर्फ दूसरे सर्वश्रेष्ठ कार्ड के आसपास नहीं थीं; कई चुनाव शीर्ष दो से बाहर थे। खेलने से पहले कमजोर विकल्प हटाएँ, फिर सर्वश्रेष्ठ और दूसरे सर्वश्रेष्ठ की तुलना करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan terbaru bukan hanya di sekitar kartu terbaik kedua; beberapa pilihan berada di luar dua teratas. Sebelum bermain, singkirkan opsi lemah dulu, lalu bandingkan yang terbaik dan kedua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние ошибки были не только около второй лучшей карты; несколько выборов оказались вне двух лучших. Перед ходом сначала уберите слабые варианты, затем сравните лучший и второй."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son hatalar yalnızca ikinci en iyi kart çevresinde değildi; birkaç seçim ilk ikinin dışına düştü. Oynamadan önce zayıf seçenekleri ele, sonra en iyi ve ikinci en iyiyi karşılaştır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالیہ غلطیاں صرف دوسرے بہترین کارڈ کے قریب نہیں تھیں؛ کئی انتخاب پہلے دو سے باہر تھے۔ کھیلنے سے پہلے کمزور اختیارات نکالیں، پھر بہترین اور دوسرے بہترین کا موازنہ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的错误不只是围绕第二佳牌；多个选择落在前两名之外。出牌前先排除弱选项，再比较最佳和第二佳。"
          }
        }
      }
    },
    "اختيارات قريبة من الأفضل" : {
      "localizations" : {
