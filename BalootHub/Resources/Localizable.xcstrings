    "زاوية واحدة بلا زخرفة، أهدأ شكل ممكن." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One plain corner — the quietest look there is."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul coin sans décor — l'aspect le plus sobre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una esquina sin adornos: el aspecto más sobrio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine schmucklose Ecke – das ruhigste Aussehen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süssüz tek köşe — mümkün olan en sakin görünüm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один угол без украшений — самый спокойный вид."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بغیر سجاوٹ ایک کونا — سب سے پُرسکون شکل۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना सजावट एक कोना — सबसे शांत रूप।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu sudut polos — tampilan paling tenang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅一角、无装饰 —— 最素净的样式。"
          }
