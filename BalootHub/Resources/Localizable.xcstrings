        }
      }
    },
    "متوسط الأثر المتوقع غير سلبي في المستويات التي تملك عينات كافية؛ يمكنك رفع الصعوبة تدريجيًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average expected impact is not negative in levels with enough samples; you can increase difficulty gradually."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'impact moyen n'est pas négatif là où l'échantillon suffit : montez progressivement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El impacto medio no es negativo donde hay muestras suficientes; sube la dificultad poco a poco."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Durchschnittswirkung ist dort nicht negativ, wo genug Daten vorliegen – steigere schrittweise."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeterli örneğin olduğu seviyelerde ortalama beklenen etki negatif değil; zorluğu kademeli artırabilirsin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среднее ожидаемое влияние не отрицательно там, где хватает выборки — повышай сложность постепенно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاں کافی نمونے ہیں وہاں اوسط متوقع اثر منفی نہیں؛ دشواری بتدریج بڑھا سکتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ पर्याप्त नमूने हैं वहाँ औसत अपेक्षित प्रभाव ऋणात्मक नहीं; कठिनाई क्रमशः बढ़ा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rata-rata dampak harapan tidak negatif di level yang sampelnya cukup; kamu bisa menaikkan kesulitan bertahap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在样本充足的难度上，平均期望影响不为负：可以逐步提升难度。"
          }
        }
      }
    },
