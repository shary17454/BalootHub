        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामान्य प्रोजेक्ट मूल्यों का सार देती है और बताती है कि ये समूहों में भिन्न हो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merangkum nilai proyek umum dan mengingatkan bahwa nilainya bisa berbeda antar kelompok."
