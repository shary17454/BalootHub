    "درّب نفس المستوى في دفعة قصيرة حتى تصبح قراراتك أكثر ثباتًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice the same level in a short batch until your decisions become steadier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez le même niveau en un lot court jusqu'à stabiliser vos décisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica el mismo nivel en un lote corto hasta que tus decisiones sean más estables."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe dieselbe Stufe in einem kurzen Stapel, bis deine Entscheidungen stabiler sind."
