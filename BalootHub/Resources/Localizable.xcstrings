    "قرار مقبول" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Akzeptable Entscheidung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Acceptable decision" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Decisión aceptable" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Décision acceptable" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "स्वीकार्य निर्णय" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusan dapat diterima" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Приемлемое решение" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kabul edilebilir karar" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "قابل قبول فیصلہ" } },
