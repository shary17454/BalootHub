    "ابدأ جلسة جديدة لتسجيل نتائج جولات صن وحكم أولًا بأول.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new session to track sun and hokum round scores as you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une nouvelle session pour suivre les scores des manches Sun et Hokum au fur et à mesure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión nueva para registrar las puntuaciones de las rondas Sun y Hokum sobre la marcha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine neue Sitzung, um die Punkte der Sun- und Hokum-Runden laufend zu erfassen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun ve Hokum ellerinin puanlarını anında takip etmek için yeni bir oturum başlatın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните новую сессию, чтобы вести счёт раундов Sun и Hokum по ходу игры."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun اور Hokum راؤنڈز کے اسکور ساتھ ساتھ ریکارڈ کرنے کے لیے نیا سیشن شروع کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun और Hokum राउंड के अंक साथ-साथ दर्ज करने के लिए नया सत्र शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai sesi baru untuk mencatat skor ronde Sun dan Hokum seiring permainan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新会话，随时记录 Sun 和 Hokum 各局的分数。"
          }
        }
      }
    },
