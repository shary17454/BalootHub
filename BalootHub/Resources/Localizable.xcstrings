    "وصلت إلى أعلى رتبة حالية في المسيرة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have reached the highest current career rank."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez atteint le plus haut rang de carrière actuel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el rango de carrera más alto actual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast den derzeit höchsten Karriere-Rang erreicht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki en yüksek kariyer rütbesine ulaştın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты достиг высшего доступного карьерного ранга."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ موجودہ بلند ترین کیریئر رینک تک پہنچ گئے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप वर्तमान उच्चतम करियर रैंक तक पहुँच गए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mencapai peringkat karier tertinggi saat ini."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已达到当前最高生涯等级。"
          }
        }
      }
    },
    "يتحقق بعد 10 قرارات صحيحة في وش تلعب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocks after 10 correct What-to-Play decisions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloqué après 10 bonnes décisions dans « Quelle carte ? »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se logra tras 10 decisiones correctas en «¿Qué juegas?»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach 10 richtigen Was-spielst-du-Entscheidungen erreicht."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne Oynarsın'da 10 doğru karardan sonra açılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывается после 10 верных решений в «Что сыграешь?»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«کیا کھیلیں؟» میں 10 درست فیصلوں کے بعد حاصل ہوتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«क्या खेलें?» में 10 सही निर्णयों के बाद मिलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terbuka setelah 10 keputusan benar di «Main apa?»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「出什么牌？」中作出 10 次正确决策后达成。"
          }
        }
      }
    },
    "يتحقق بعد 25 إجابة صحيحة في تحدي النقاط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocks after 25 correct answers in the scoring challenge."
          }
