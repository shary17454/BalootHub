        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılış, renge uyma ve kozu dengele"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتتاح، رنگ کی پیروی اور حکم میں توازن رکھیں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡首攻、跟花色和将牌"
          }
        }
      }
    },
    "أكثر من خطأ حديث أعطى الأكلة المكتملة للفريق الخصم. قبل الرمي، احسب من يربح الأكلة بعد ورقتك وهل تستحق النقاط التي ستضيفها." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als ein aktueller Fehler gab den fertigen Stich dem Gegnerteam. Berechne vor dem Ausspielen, wer den Stich nach deiner Karte gewinnt und ob die Punkte es wert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one recent mistake handed the completed trick to the opponents. Before playing, calculate who wins the trick after your card and whether the points you add are worth it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de un error reciente entregó la baza completa al rival. Antes de jugar, calcula quién gana la baza después de tu carta y si los puntos que añades valen la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus d'une erreur récente a donné le pli terminé à l'équipe adverse. Avant de jouer, calcule qui gagne le pli après ta carte et si les points ajoutés en valent la peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की एक से अधिक गलतियों ने पूरी बाज़ी विरोधी टीम को दे दी। खेलने से पहले देखें कि आपकी पत्ती के बाद बाज़ी कौन जीतेगा और जो अंक आप जोड़ रहे हैं वे उचित हैं या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih dari satu kesalahan terbaru menyerahkan trik selesai kepada lawan. Sebelum bermain, hitung siapa yang menang setelah kartumu dan apakah poin yang kamu tambahkan sepadan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более одной недавней ошибки отдала завершенную взятку соперникам. Перед ходом посчитайте, кто выиграет взятку после вашей карты и стоят ли добавленные очки риска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son hatalardan birden fazlası tamamlanan eli rakibe verdi. Oynamadan önce kartından sonra eli kimin alacağını ve eklediğin puanların buna değip değmediğini hesapla."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالیہ ایک سے زیادہ غلطیوں نے مکمل چال مخالف ٹیم کو دے دی۔ پتا پھینکنے سے پہلے حساب کریں کہ آپ کے پتے کے بعد چال کون جیتے گا اور کیا شامل ہونے والے پوائنٹس قابل ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近不止一次失误把已完成的一墩送给对手。出牌前先计算你出牌后谁会赢这一墩，以及你加入的分值是否值得。"
          }
        }
      }
    },
    "افتتاحاتك مكلفة" : {
