        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके परिणाम मज़बूत निर्णयों और महँगी ग़लतियों के बीच झूलते हैं; अधिक स्थिर अभ्यास चाहिए।"
