        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली स्थिति में एक प्रश्न से शुरू करें: यदि चाल विपक्ष की हो तो कौन सा कार्ड सबसे कम अपेक्षित अंक खोता है?"
