    "دقتك وسلسلتك قوية حتى في أعلى مستوى؛ ركز على السرعة ومراجعة القهوة والمضاعفات." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your accuracy and streak are strong even at the highest level; focus on speed and reviewing coffee and multipliers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision et série solides même au plus haut niveau : visez la vitesse, Coffee et multiplicateurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisión y racha sólidas incluso en el nivel más alto; enfócate en velocidad, Coffee y multiplicadores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit und Serie sind auch oben stark – arbeite an Tempo, Coffee und Multiplikatoren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üst seviyede bile doğruluk ve serin güçlü; hıza, Coffee ve çarpanlara odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность и серия сильны даже на высшем уровне — работай над скоростью, Coffee и множителями."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلیٰ ترین سطح پر بھی درستگی اور سلسلہ مضبوط؛ رفتار، Coffee اور ضربات پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उच्चतम स्तर पर भी सटीकता व लड़ी मज़बूत; गति, Coffee और गुणकों पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasi dan rentetanmu kuat bahkan di level tertinggi; fokus pada kecepatan, Coffee, dan pengganda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在最高难度，你的准确率与连胜依然强劲：专注速度、Coffee 与加倍。"
          }
        }
      }
    },
