        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعمال ہونے والی ترتیب دور کے راؤنڈ کی قسم سے بدلتی ہے (کچھ راؤنڈ کارڈ کی قوت نہیں بلکہ مخصوص کارڈ سے بچنے پر ہوتے ہیں)۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रयुक्त क्रम चक्र में राउंड के प्रकार से बदलता है (कुछ राउंड कार्ड की ताक़त नहीं, विशेष कार्ड से बचने पर निर्भर हैं)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urutan yang dipakai berbeda menurut jenis ronde dalam siklus (sebagian ronde tidak bergantung pada kekuatan kartu, melainkan menghindari kartu tertentu)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
