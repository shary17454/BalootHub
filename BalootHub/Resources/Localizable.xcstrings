    "بعد اكتمال اليد يعرض التطبيق تقييم القوة، أفضل شراء، المشاريع، ونصيحة تكتيكية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the hand is complete, the app shows strength, best bid, projects, and tactical advice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois la main complète, l'app montre force, meilleure enchère, projets et conseil tactique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la mano completa, la app muestra fuerza, mejor puja, proyectos y consejo táctico."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei vollständiger Hand zeigt die App Stärke, beste Ansage, Projekte und Taktiktipp."
