    "الدقة وأثر القرار قريبان؛ حسّن الاثنين معًا برفع جودة القراءة قبل اللعب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accuracy and decision impact are close; improve both by raising the quality of your read before playing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision et impact sont proches : améliorez les deux via une meilleure lecture avant de jouer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisión e impacto están cerca; mejora ambos elevando la calidad de tu lectura antes de jugar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit und Wirkung liegen nah beieinander – verbessere beide durch besseres Lesen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğruluk ve karar etkisi yakın; oynamadan önce okuma kalitesini yükselterek ikisini birden geliştir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность и влияние близки — улучшай оба, повышая качество чтения до хода."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درستگی اور فیصلے کا اثر قریب ہیں؛ کھیلنے سے پہلے قرات بہتر بنا کر دونوں سدھاریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीकता और निर्णय प्रभाव करीब हैं; खेलने से पहले पढ़ाई सुधारकर दोनों बेहतर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasi dan dampak keputusan berdekatan; perbaiki keduanya dengan bacaan lebih baik sebelum bermain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准确率与决策影响相近：出牌前提高读牌质量，两者同时改善。"
          }
        }
      }
    },
    "ابدأ الجلسة حتى يظهر تقييم يجمع الدقة وأثر القرار." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start the session to see a grade that combines accuracy and decision impact."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez la session pour obtenir une note combinant précision et impact."
          }
        },
        "es" : {
          "stringUnit" : {
