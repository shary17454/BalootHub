        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "损失价值" } }
      }
    },
    "تقييم اختيارك" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bewertung deiner Wahl" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your choice rating" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Evaluación de tu elección" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Évaluation de votre choix" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी पसंद का आकलन" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Penilaian pilihan Anda" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Оценка вашего выбора" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçiminin değerlendirmesi" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے انتخاب کی درجہ بندی" } },
