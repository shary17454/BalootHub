    "تدريب وش تلعب؟ يكشف أن قراراتك المكلفة متكررة. راجع سبب أفضل ورقة قبل اللعب وركز على تقليل الفاقد المتوقع." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What-to-Play practice shows your costly decisions repeat. Review why the best card wins before playing, and focus on reducing expected loss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement montre des décisions coûteuses répétées : justifiez la meilleure carte avant de jouer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento muestra decisiones costosas repetidas; justifica la mejor carta antes de jugar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Training zeigt wiederholt teure Entscheidungen – begründe die beste Karte vor dem Spielen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne Oynarsın antrenmanı pahalı kararlarının tekrarladığını gösteriyor. Oynamadan önce en iyi kartın nedenini gözden geçir ve beklenen kaybı azaltmaya odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренажёр показывает повторяющиеся дорогие решения — обоснуй лучшую карту до хода."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«کیا کھیلیں؟» مشق بتاتی ہے کہ آپ کے مہنگے فیصلے دہرا رہے ہیں۔ کھیلنے سے پہلے بہترین کارڈ کی وجہ دیکھیں اور متوقع نقصان کم کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«क्या खेलें?» अभ्यास दिखाता है कि आपके महँगे निर्णय दोहराते हैं। खेलने से पहले सर्वश्रेष्ठ कार्ड का कारण देखें और अपेक्षित हानि घटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan «Main apa?» menunjukkan keputusan mahalmu berulang. Tinjau alasan kartu terbaik sebelum bermain dan fokus menekan kerugian harapan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「出什么牌？」训练显示你的高代价决策在重复：出牌前先弄清最优牌的理由，专注减少期望损失。"
          }
        }
      }
    },
    "دقة التدريب" : {
      "localizations" : {
        "en" : {
