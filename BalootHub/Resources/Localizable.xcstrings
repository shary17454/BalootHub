    "جرّب تغيير الفلتر أو كلمة البحث.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try changing the filter or search term."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de modifier le filtre ou le terme de recherche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a cambiar el filtro o el término de búsqueda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere den Filter oder den Suchbegriff."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtreyi veya arama terimini değiştirmeyi deneyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте изменить фильтр или поисковый запрос."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فلٹر یا تلاش کی اصطلاح تبدیل کر کے دیکھیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर या खोज शब्द बदलकर देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba ubah filter atau kata pencarian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试更改筛选条件或搜索词。"
          }
        }
      }
    },
    "جرّب كلمات بحث أخرى": {
      "localizations": {
