    "الدقة والسلسلة تسمحان بالانتقال لمستوى أعلى مع مشاريع ومضاعفات أكثر." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your accuracy and streak support moving to a higher level with more projects and multipliers."
          }
        },
        "fr" : {
          "stringUnit" : {
