    "الدقة والأثر لم يصلا للهدف؛ ابدأ من نفس المستوى ولا ترفع الصعوبة بعد." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accuracy and impact did not reach the target; start from the same level and do not raise the difficulty yet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision et impact sous l'objectif : repartez du même niveau, sans monter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisión e impacto no llegaron al objetivo; parte del mismo nivel y no subas aún."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit und Wirkung verfehlt – starte auf derselben Stufe, ohne zu steigern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğruluk ve etki hedefe ulaşmadı; aynı seviyeden başla, zorluğu henüz artırma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность и влияние не достигли цели — начни с того же уровня, не повышай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درستگی اور اثر ہدف تک نہ پہنچے؛ اسی سطح سے شروع کریں، دشواری ابھی نہ بڑھائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीकता और प्रभाव लक्ष्य तक नहीं पहुँचे; उसी स्तर से शुरू करें, कठिनाई अभी न बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasi dan dampak belum mencapai target; mulai dari level sama, jangan naikkan dulu."
