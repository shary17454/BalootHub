    "تدريب الإعادة" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry practice" } }
      }
    },
    "تحسن متوقع" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erwartete Verbesserung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Expected improvement" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mejora esperada" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Amélioration attendue" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपेक्षित सुधार" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Peningkatan yang diharapkan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ожидаемое улучшение" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklenen iyileşme" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "متوقع بہتری" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预期提升" } }
      }
    },
    "استهدف نوع موقف ناقص" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ziele auf einen fehlenden Situationstyp" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Target a missing scenario type" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Practica un tipo de situación pendiente" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cible un type de situation manquant" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "एक छूटे हुए स्थिति प्रकार को लक्षित करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Targetkan jenis situasi yang belum terlatih" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отработайте недостающий тип ситуации" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eksik bir senaryo türünü hedefle" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایک رہ گئی صورتحال کی قسم کو ہدف بنائیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "练习缺少的局面类型" } }
      }
    },
    "تغطية أنواع المواقف تجعل توصيات المدرب أعدل؛ لا تدرّب الصعوبة فقط." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Abdeckung verschiedener Situationstypen macht die Trainerempfehlungen fairer; trainiere nicht nur die Schwierigkeit." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Covering scenario types makes trainer recommendations fairer; do not train difficulty only." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cubrir tipos de situación hace más justas las recomendaciones del entrenador; no entrenes solo la dificultad." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Couvrir les types de situations rend les recommandations du coach plus justes; ne travaille pas seulement la difficulté." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "स्थिति प्रकारों को कवर करने से कोच की सिफारिशें बेहतर होती हैं; केवल कठिनाई का अभ्यास न करें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Mencakup jenis situasi membuat rekomendasi pelatih lebih adil; jangan hanya melatih tingkat kesulitan." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Покрытие типов ситуаций делает рекомендации тренера точнее; тренируйте не только сложность." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Senaryo türlerini kapsamak koç önerilerini daha dengeli yapar; yalnızca zorluğu çalıştırma." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مختلف صورتحال کی اقسام کا احاطہ کوچ کی سفارشات کو بہتر بناتا ہے؛ صرف مشکل سطح کی مشق نہ کریں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "覆盖不同局面类型会让教练建议更均衡；不要只训练难度。" } }
      }
    },
    "خطة أنواع المواقف" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Plan für Situationstypen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scenario Type Plan" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Plan de tipos de situación" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plan des types de situations" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "स्थिति प्रकार योजना" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Rencana Jenis Situasi" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "План типов ситуаций" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Senaryo Türü Planı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "صورتحال کی قسم کا منصوبہ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "局面类型计划" } }
      }
    },
    "حل موقفين من نوع الموقف الناقص" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löse zwei Aufgaben dieses fehlenden Situationstyps" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Solve two prompts from the missing scenario type" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Resuelve dos situaciones del tipo pendiente" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Résous deux situations du type manquant" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "छूटे हुए स्थिति प्रकार के दो प्रश्न हल करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Selesaikan dua prompt dari jenis situasi yang belum terlatih" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Решите две задачи недостающего типа ситуации" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eksik senaryo türünden iki durum çöz" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "رہ گئی صورتحال کی قسم سے دو مشقیں حل کریں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成两个缺少局面类型的题目" } }
      }
    },
    "وازن بين الافتتاح والتلزيم والحكم" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Balanciere Eröffnung, Bedienen und Trumpf" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Balance opening leads, following suit, and trump" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Equilibra salidas, seguir el palo y triunfo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Équilibre entame, suivi de couleur et atout" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "शुरुआत, सूट का पालन और हुकुम में संतुलन रखें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Seimbangkan pembukaan, mengikuti jenis, dan trump" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Балансируйте заходы, следование масти и козырь" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açılış, renge uyma ve kozu dengele" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "افتتاح، رنگ کی پیروی اور حکم میں توازن رکھیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "平衡首攻、跟花色和将牌" } }
      }
    },
    "أكثر من خطأ حديث أعطى الأكلة المكتملة للفريق الخصم. قبل الرمي، احسب من يربح الأكلة بعد ورقتك وهل تستحق النقاط التي ستضيفها." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mehr als ein aktueller Fehler gab den fertigen Stich dem Gegnerteam. Berechne vor dem Ausspielen, wer den Stich nach deiner Karte gewinnt und ob die Punkte es wert sind." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "More than one recent mistake handed the completed trick to the opponents. Before playing, calculate who wins the trick after your card and whether the points you add are worth it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Más de un error reciente entregó la baza completa al rival. Antes de jugar, calcula quién gana la baza después de tu carta y si los puntos que añades valen la pena." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plus d'une erreur récente a donné le pli terminé à l'équipe adverse. Avant de jouer, calcule qui gagne le pli après ta carte et si les points ajoutés en valent la peine." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "हाल की एक से अधिक गलतियों ने पूरी बाज़ी विरोधी टीम को दे दी। खेलने से पहले देखें कि आपकी पत्ती के बाद बाज़ी कौन जीतेगा और जो अंक आप जोड़ रहे हैं वे उचित हैं या नहीं।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Lebih dari satu kesalahan terbaru menyerahkan trik selesai kepada lawan. Sebelum bermain, hitung siapa yang menang setelah kartumu dan apakah poin yang kamu tambahkan sepadan." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Более одной недавней ошибки отдала завершенную взятку соперникам. Перед ходом посчитайте, кто выиграет взятку после вашей карты и стоят ли добавленные очки риска." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Son hatalardan birden fazlası tamamlanan eli rakibe verdi. Oynamadan önce kartından sonra eli kimin alacağını ve eklediğin puanların buna değip değmediğini hesapla." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "حالیہ ایک سے زیادہ غلطیوں نے مکمل چال مخالف ٹیم کو دے دی۔ پتا پھینکنے سے پہلے حساب کریں کہ آپ کے پتے کے بعد چال کون جیتے گا اور کیا شامل ہونے والے پوائنٹس قابل ہیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近不止一次失误把已完成的一墩送给对手。出牌前先计算你出牌后谁会赢这一墩，以及你加入的分值是否值得。" } }
      }
    },
    "افتتاحاتك مكلفة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Eröffnungen sind teuer" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your opening leads are costly" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus salidas son costosas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes entames coûtent cher" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी शुरुआती चालें महंगी पड़ रही हैं" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pembukaanmu mahal" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши первые ходы обходятся дорого" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açılışların maliyetli" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کی ابتدائی چالیں مہنگی پڑ رہی ہیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的首攻代价较高" } }
      }
    },
    "افتتاح مكلف" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Teure Eröffnung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Costly opening lead" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Salida costosa" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Entame coûteuse" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "महंगी शुरुआती चाल" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pembukaan mahal" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Дорогой первый ход" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Maliyetli açılış" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مہنگی ابتدائی چال" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "代价较高的首攻" } }
      }
    },
    "بعض أخطائك جاءت من بداية الأكلة بورقة تخفض الأثر المتوقع. عند الافتتاح، اختر ورقة تكشف أقل قدر من قوتك أو تسحب الحكم لغرض واضح." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einige Fehler entstehen, weil du den Stich mit einer Karte beginnst, die den erwarteten Effekt senkt. Wähle beim Eröffnen eine Karte, die wenig Stärke verrät oder Trumpf aus einem klaren Grund zieht." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Some mistakes came from leading a trick with a card that lowers expected impact. When opening, choose a card that reveals less of your strength or pulls trump for a clear reason." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Algunos errores vinieron de iniciar la baza con una carta que reduce el impacto esperado. Al salir, elige una carta que revele menos fuerza o que saque triunfo con un motivo claro." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Certaines erreurs viennent d'une entame qui réduit l'impact attendu. À l'entame, choisis une carte qui révèle moins ta force ou qui tire l'atout pour une raison claire." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कुछ गलतियाँ ऐसी पत्ती से बाज़ी शुरू करने से आईं जो अपेक्षित प्रभाव घटाती है। शुरुआत में ऐसी पत्ती चुनें जो आपकी ताकत कम दिखाए या साफ कारण से हुकुम निकाले।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Beberapa kesalahan berasal dari membuka trik dengan kartu yang menurunkan dampak yang diharapkan. Saat membuka, pilih kartu yang tidak banyak membuka kekuatanmu atau menarik trump dengan alasan jelas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Часть ошибок связана с началом взятки картой, снижающей ожидаемый эффект. При заходе выбирайте карту, которая меньше раскрывает силу, или тяните козырь с понятной целью." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bazı hataların, beklenen etkiyi düşüren bir kartla eli açmaktan geldi. Açılışta gücünü az gösteren ya da net bir amaçla kozu çeken kartı seç." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "کچھ غلطیاں ایسی چال شروع کرنے سے ہوئیں جس سے متوقع اثر کم ہوا۔ آغاز پر ایسا پتا چنیں جو آپ کی طاقت کم ظاہر کرے یا واضح مقصد سے حکم نکالے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分失误来自用会降低预期影响的牌开墩。首攻时选择较少暴露实力的牌，或在有明确目的时引出将牌。" } }
      }
    },
    "بدأت الأكلة بورقة تخفض الأثر المتوقع. جرّب افتتاحًا يحفظ القوة أو يسحب الحكم بسبب واضح." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du hast den Stich mit einer Karte begonnen, die den erwarteten Effekt senkt. Versuche eine Eröffnung, die Stärke bewahrt oder Trumpf aus einem klaren Grund zieht." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You led the trick with a card that lowers expected impact. Try an opening that preserves strength or pulls trump for a clear reason." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Iniciaste la baza con una carta que reduce el impacto esperado. Prueba una salida que conserve fuerza o saque triunfo con un motivo claro." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu as entamé le pli avec une carte qui réduit l'impact attendu. Essaie une entame qui conserve la force ou tire l'atout pour une raison claire." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपने ऐसी पत्ती से बाज़ी शुरू की जो अपेक्षित प्रभाव घटाती है। ऐसी शुरुआत आज़माएँ जो ताकत बचाए या साफ कारण से हुकुम निकाले।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu membuka trik dengan kartu yang menurunkan dampak yang diharapkan. Coba pembukaan yang menjaga kekuatan atau menarik trump dengan alasan jelas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы начали взятку картой, снижающей ожидаемый эффект. Попробуйте заход, который сохраняет силу или тянет козырь с понятной целью." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eli, beklenen etkiyi düşüren bir kartla açtın. Gücü koruyan ya da net bir nedenle kozu çeken bir açılış dene." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ نے چال ایسے پتے سے شروع کی جس سے متوقع اثر کم ہوا۔ ایسی شروعات آزمائیں جو طاقت بچائے یا واضح وجہ سے حکم نکالے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你用会降低预期影响的牌开墩。尝试保留实力的首攻，或在有明确原因时引出将牌。" } }
      }
    },
    "تغلق الأكلة للخصم" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du schließt den Stich für den Gegner" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You close the trick for the opponent" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cierras la baza para el rival" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu fermes le pli pour l'adversaire" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप बाज़ी विरोधी के लिए बंद कर रहे हैं" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu menutup trik untuk lawan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы закрываете взятку в пользу соперника" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eli rakip için kapatıyorsun" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ چال مخالف کے لیے بند کر رہے ہیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你把这一墩送给了对手" } }
      }
    },
    "اختيارك أضاف نقاطًا لأكلة انتهت للفريق الخصم. راجع هل كان يمكن تقليل الخسارة بدل تغذية الأكلة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Wahl fügte Punkte zu einem Stich hinzu, der beim Gegner landete. Prüfe, ob du den Verlust hättest verringern können, statt den Stich zu füttern." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your choice added points to a trick that went to the opponents. Review whether you could have reduced the loss instead of feeding the trick." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu elección añadió puntos a una baza que ganó el rival. Revisa si podías reducir la pérdida en lugar de alimentar la baza." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton choix a ajouté des points à un pli gagné par l'adversaire. Vérifie si tu pouvais réduire la perte au lieu d'alimenter le pli." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके चुनाव ने ऐसी बाज़ी में अंक जोड़े जो विरोधियों ने जीती। देखें कि क्या बाज़ी को बढ़ाने के बजाय नुकसान कम किया जा सकता था।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilihanmu menambah poin pada trik yang dimenangkan lawan. Tinjau apakah kamu bisa mengurangi kerugian alih-alih memberi poin pada trik itu." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваш выбор добавил очки во взятку, которую забрали соперники. Проверьте, можно ли было уменьшить потерю вместо усиления взятки." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçimin, rakibin aldığı ele puan ekledi. Eli beslemek yerine kaybı azaltıp azaltamayacağını gözden geçir." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے انتخاب نے ایسی چال میں پوائنٹس ڈالے جو مخالف کو گئی۔ دیکھیں کیا چال کو بھرنے کے بجائے نقصان کم کیا جا سکتا تھا۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的选择给对手赢下的一墩增加了分值。回顾是否本可以减少损失，而不是给这一墩加分。" } }
      }
    },
    "ترمي نقاطًا بلا حماية" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du wirfst Punkte ungeschützt ab" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You throw points without cover" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tiras puntos sin protección" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu jettes des points sans protection" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप बिना सुरक्षा के अंक फेंक रहे हैं" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu membuang poin tanpa perlindungan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы сбрасываете очки без защиты" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Korumasız puan atıyorsun" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ بغیر حفاظت کے پوائنٹس پھینک رہے ہیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你在无保护地丢分牌" } }
      }
    },
    "الورقة تحمل نقاطًا والأكلة لم تُحسم بعد. اسأل هل شريكك يحميها أو هل الأفضل التخلص من ورقة أرخص." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Karte trägt Punkte und der Stich ist noch nicht entschieden. Frage dich, ob dein Partner sie schützt oder ob eine billigere Karte besser wäre." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The card carries points and the trick is not decided yet. Ask whether your partner protects it or whether discarding a cheaper card is better." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La carta tiene puntos y la baza aún no está decidida. Pregunta si tu compañero la protege o si conviene soltar una carta más barata." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La carte vaut des points et le pli n'est pas encore décidé. Demande-toi si ton partenaire la protège ou s'il vaut mieux défausser une carte moins chère." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "पत्ती में अंक हैं और बाज़ी अभी तय नहीं हुई। सोचें कि साथी इसे बचाएगा या सस्ती पत्ती छोड़ना बेहतर है।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kartu itu bernilai poin dan trik belum diputuskan. Tanyakan apakah pasanganmu melindunginya atau lebih baik membuang kartu yang lebih murah." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Карта несет очки, а взятка еще не решена. Спросите себя, защитит ли ее партнер или лучше сбросить более дешевую карту." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kart puan taşıyor ve el henüz belli değil. Ortağın koruyor mu yoksa daha ucuz bir kart atmak mı daha iyi, sor." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "پتے میں پوائنٹس ہیں اور چال ابھی طے نہیں ہوئی۔ سوچیں ساتھی اسے بچائے گا یا سستا پتا پھینکنا بہتر ہے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这张牌有分值，而这一墩尚未确定。想想队友是否能保护它，或是否应丢一张更便宜的牌。" } }
      }
    },
    "تكرر رمي أوراق عليها نقاط قبل أن تُحسم الأكلة. لا تضف العشرة أو الآس إلا إذا كنت تكسب الأكلة أو شريكك غالبًا سيحميها." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du wirfst wiederholt Punktekarten, bevor der Stich entschieden ist. Lege Zehn oder Ass nur dazu, wenn du den Stich gewinnst oder dein Partner ihn wahrscheinlich schützt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You repeatedly play point cards before the trick is decided. Do not add a ten or ace unless you are winning the trick or your partner will likely protect it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Repites cartas con puntos antes de que la baza esté decidida. No añadas el diez o el as salvo que ganes la baza o tu compañero probablemente la proteja." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu joues souvent des cartes à points avant que le pli soit décidé. N'ajoute pas le dix ou l'as sauf si tu gagnes le pli ou si ton partenaire va probablement le protéger." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप बाज़ी तय होने से पहले बार-बार अंक वाली पत्तियाँ खेल रहे हैं। दस या इक्का तभी डालें जब आप बाज़ी जीत रहे हों या साथी संभवतः उसे बचा लेगा।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu berulang kali memainkan kartu bernilai sebelum trik ditentukan. Jangan tambahkan sepuluh atau ace kecuali kamu menang trik atau pasanganmu kemungkinan melindunginya." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы часто кладете карты с очками до того, как взятка решена. Не добавляйте десятку или туза, если не выигрываете взятку или партнер, вероятно, ее защитит." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "El belli olmadan puanlı kartları tekrar tekrar oynuyorsun. Eli kazanmadıkça ya da ortağın muhtemelen korumadıkça onlu veya as ekleme." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ چال طے ہونے سے پہلے بار بار پوائنٹ والے پتے کھیل رہے ہیں۔ دس یا اکا تبھی ڈالیں جب آپ چال جیت رہے ہوں یا ساتھی غالباً اسے بچائے گا۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你多次在这一墩尚未确定前打出有分值的牌。除非你能赢这一墩，或队友很可能保护它，否则不要加入10或A。" } }
      }
    },
    "تفصيل الأثر" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Effektdetails" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Impact Detail" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Detalle del impacto" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Détail de l'impact" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रभाव विवरण" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Detail Dampak" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Детали эффекта" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Etki Detayı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "اثر کی تفصیل" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "影响详情" } }
      }
    },
    "أثر افتتاحي" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Eröffnungseffekt" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Opening impact" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Impacto de apertura" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impact d'ouverture" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "शुरुआती प्रभाव" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Dampak pembuka" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эффект захода" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açılış etkisi" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "افتتاحی اثر" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开局影响" } }
      }
    },
    "لا تحسم الأكلة الآن" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entscheidet den Stich jetzt nicht" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Does not decide the trick yet" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no decide la baza" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ne décide pas encore le pli" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी बाज़ी तय नहीं करती" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum menentukan trik" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока не решает взятку" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eli henüz belirlemez" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ابھی چال کا فیصلہ نہیں کرتی" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不决定这一墩" } }
      }
    },
    "لفريقك" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "für dein Team" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "for your team" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "para tu equipo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "pour ton équipe" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी टीम के लिए" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "untuk timmu" } },
