        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her takımın toplamı, kaydedilen tüm ellerin toplamı olarak otomatik hesaplanır; çarpan, Ayarlar'da seçilen puanlama formülüne göre her ele uygulanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итог каждой команды считается автоматически как сумма всех раздач с множителем по выбранной формуле."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر ٹیم کا مجموعہ خودکار طور پر تمام محفوظ صکات کے جوڑ کے طور پر، اور ضرب ہر صکہ پر ترتیبات میں منتخب صیغے کے مطابق لگتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर टीम का कुल स्वतः सभी सहेजे हाथों के जोड़ के रूप में, और गुणक हर हाथ पर सेटिंग्स में चुने सूत्र अनुसार लगता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total tiap tim dihitung otomatis sebagai jumlah semua ronde tersimpan, dengan pengganda diterapkan per ronde sesuai formula di Pengaturan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各队总分自动累加所有已保存的每局，并按设置中所选计分公式对每局施加倍数。"
          }
        }
      }
    },
    "يختار اللاعب الفائز بالمزايدة نوعًا واحدًا من الأنواع الأربعة ليكون \"الحكم\" لهذه الجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player who wins the bidding chooses one of the four suits to be the \"Hokum\" (trump) for that round."
          }
        }
      }
    },
    "يختلف الترتيب المستخدم حسب نوع الجولة داخل الدورة (بعض الجولات لا تعتمد على قوة الأوراق بل على تجنّب رموز معيّنة)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ranking used varies with the type of round within the cycle (some rounds don't depend on card strength at all, but on avoiding certain cards)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
