          }
        }
      }
    },
    "نمط داخل البلوت لا يوجد فيه نوع حكم؛ يُحتسب كل الأنواع الأربعة بنفس ترتيب القوة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Baloot mode with no trump suit; all four suits rank by the same order of strength."
          }
        }
      }
    },
    "نمط داخل البلوت يُختار فيه نوع واحد يصبح \"الحكم\"، فيتفوق على بقية الأنواع، والشايب هو أقوى أوراقه." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Baloot mode where one suit is chosen as the \"Hokum\" (trump), outranking the others, with the Jack as its strongest card."
          }
        }
      }
    },
    "نمط يركّز على إعلان \"المشاريع\" (تتابعات وتكرارات في اليد) كمصدر إضافي للنقاط قبل بدء اللعب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mode focused on declaring \"projects\" (runs and sets in your hand) as an extra source of points before play begins."
          }
        }
      }
    },
    "نمط يعتمد على مضاعفة الرهان أثناء المزايدة (دبل، ثري، فور) قبل بدء اللعب، لرفع قيمة الجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mode built on raising the stakes during bidding (Double, Triple, Quadruple) before play begins, to increase the round's value."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode fondé sur la surenchère (Double, Triple, Quadruple) avant le jeu, pour valoriser la manche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo basado en doblar la apuesta (Doble, Triple, Cuádruple) antes de jugar, para subir el valor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modus mit Erhöhung des Einsatzes (Doppel, Dreifach, Vierfach) vor dem Spiel zur Rundenaufwertung."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun başlamadan ihalede bahsi katlamaya (Double, Triple, Quadruple) dayanan mod; elin değerini yükseltir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим с повышением ставки (дубль, трипл, квадро) до игры для роста ценности раунда."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بولی کے دوران کھیل شروع ہونے سے پہلے شرط دگنی کرنے (ڈبل، تھری، فور) والا موڈ، جو راؤنڈ کی قیمت بڑھاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेल शुरू होने से पहले बोली में दाँव दोगुना करने (डबल, ट्रिपल, फोर) वाला मोड, जो राउंड का मूल्य बढ़ाता है।"
          }
        },
