    "حل أول أسئلة بدون مشاريع أو مضاعفات حتى تثبت طريقة جمع النقاط الأساسية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solve the first questions without projects or multipliers until the basic point-counting method is stable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites d'abord les questions sans projets ni multiplicateurs pour ancrer la méthode de base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelve primero preguntas sin proyectos ni multiplicadores para fijar el método básico."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löse zuerst Fragen ohne Projekte und Multiplikatoren, bis die Grundmethode sitzt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel toplama yöntemi oturana dek önce projesiz ve çarpansız soruları çöz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала реши вопросы без проектов и множителей, чтобы закрепить базовый метод."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بنیادی جمع کا طریقہ پکا ہونے تک پہلے پروجیکٹ اور ضربات کے بغیر سوالات حل کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुनियादी जोड़ विधि पक्की होने तक पहले बिना प्रोजेक्ट/गुणक वाले प्रश्न हल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerjakan dulu soal tanpa proyek atau pengganda sampai metode dasar mantap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先做不含项目与加倍的题目，把基础算法练稳。"
          }
        }
      }
    },
    "ثبّت مستوى الصعب" : {
