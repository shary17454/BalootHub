        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے حالیہ فیصلے درست یا نفع بخش ہیں؛ جاری رکھیں یا مشکل تر آزمائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हालिया निर्णय सही या लाभकारी हैं; जारी रखें या कठिन आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
