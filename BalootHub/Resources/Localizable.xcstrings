        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلی صکہ سے پہلے دونوں ٹیموں کے نام اور ہدف (پہلے سے 152 یا اپنی قیمت) درج کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
