    "اختيار خبير" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expert choice"
          }
        }
      }
    },
    "اختيار قريب" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close choice"
          }
        }
      }
    },
    "اختيارك خسر قيمة متوقعة مقارنة بالأفضل. ابحث عن الورقة التي تقلل الخسارة حتى لو لم تربح الأكلة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice lost expected value compared with the best option. Look for the card that reduces loss even if it does not win the trick."
          }
        }
      }
    },
    "استخدم هذه الخطوات القصيرة قبل الانتقال للموقف التالي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use these short steps before moving to the next scenario."
          }
        }
      }
    },
    "افحص الحكم الموجود على الطاولة قبل رمي ورقة عالية أو حكم أعلى." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect the trump on the table before throwing a high card or a higher trump."
          }
        }
      }
    },
    "اكتب سبب نجاح القرار في ذهنك وكرر نفس القراءة في موقف مشابه." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note why the decision worked and repeat the same read in a similar scenario."
          }
        }
      }
    },
    "ابحث عن الورقة التي كانت ستحوّل الأكلة من خسارة إلى ربح." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the card that would have turned the trick from a loss into a win."
          }
        }
      }
    },
    "أعد الموقف إذا كان الفارق أكثر من نقطتين متوقعتين." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replay the scenario if the gap is more than two expected points."
          }
        }
      }
    },
    "حدد هل خسرت النقاط لأنك رميت ورقة ثمينة أو تركت ورقة أقل ضررًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identify whether you lost points by throwing a valuable card or by missing a less damaging one."
          }
        }
      }
    },
    "راجع القرار بهذه الطريقة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the decision this way"
          }
        }
      }
    },
    "راجع اللون المطلوب أولًا، ثم اسأل هل تستطيع ربح الأكلة أم يجب تقليل خسارتها." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the required suit first, then ask whether you can win the trick or need to reduce the loss."
          }
        }
      }
    },
    "ثبّت القراءة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock in the read"
          }
        }
      }
    },
    "درّب الفارق الصغير" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Train the small gap"
          }
        }
      }
    },
    "أعد قراءة نفس النوع من المواقف وركّز على سبب تفوق ورقة واحدة بنقطة أو نقطتين متوقعتين." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replay this type of scenario and focus on why one card is better by one or two expected points."
          }
        }
      }
    },
    "ابحث عن الورقة الرابحة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the winning card"
          }
        }
      }
    },
    "قبل اللعب، احسب هل عندك ورقة تنقل الأكلة لفريقك بدل الاكتفاء برمي ورقة قليلة الضرر." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before playing, check whether you have a card that moves the trick to your team instead of only throwing a low-damage card."
          }
        }
      }
    },
    "قلل النزيف القادم" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce the next leak"
          }
        }
      }
    },
    "في الموقف القادم ابدأ بسؤال واحد: ما أقل ورقة تخسر أقل نقاط متوقعة إذا كانت الأكلة للخصم؟" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the next scenario, start with one question: what is the lowest card that loses the fewest expected points if the trick belongs to the opponent?"
          }
        }
      }
    },
    "احتفظ بنفس منطق الافتتاح: لا تكشف قوتك إلا عندما يعطيك ذلك سيطرة واضحة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the same lead logic: do not reveal your strength unless it gives you clear control."
          }
        }
      }
    },
    "استمر في قراءة اللون المطلوب أولًا ثم قارن بين ربح الأكلة وتقليل الخسارة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep reading the required suit first, then compare winning the trick against reducing the loss."
          }
        }
      }
    },
    "ثبت عادة فحص الحكم على الطاولة قبل صرف حكم قوي أو ورقة عالية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the habit of checking the trump on the table before spending a strong trump or high card."
          }
        }
      }
    },
    "عند ضيق الخيارات، استمر في ترتيبها حسب الأثر المتوقع لا حسب شكل الورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When options are tight, keep ranking them by expected impact, not by how the card looks."
          }
        }
      }
    },
    "ورقة المراجعة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review card"
          }
        }
      }
    },
    "عندما تكون الخيارات قليلة، رتّبها حسب أقل خسارة لا حسب أعلى ورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When choices are limited, rank them by least loss, not by highest card."
          }
        }
      }
    },
    "قارن الفرق بين اختيارك وأفضل ورقة؛ هذا النوع من الفوارق الصغيرة يتراكم." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the gap between your choice and the best card; these small gaps add up."
          }
        }
      }
    },
    "قارن هل افتتاحك يكشف قوة يدك مبكرًا أو يحفظها للأكلة القادمة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare whether your lead reveals your hand strength early or preserves it for the next trick."
          }
        }
      }
    },
    "الخيار الأفضل كان يتوقع كسبًا، بينما اختيارك يميل لخسارة الأكلة أو نقاطها. هذه المواقف تستحق إعادة قراءة الطاولة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best option expected a gain, while your choice tends to lose the trick or its points. These scenarios are worth rereading carefully."
          }
        }
      }
    },
    "قرارك قريب من الأفضل، لكن الفرق الصغير يتراكم مع الوقت؛ راجع لماذا رجّح الخبير الورقة الأولى." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decision is close to the best option, but small differences add up; review why the expert preferred the first card."
          }
        }
      }
    },
    "قرارك يطابق أفضل خيار في هذا الموقف، لذلك ركز على تذكر سبب نجاحه للمواقف المشابهة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
