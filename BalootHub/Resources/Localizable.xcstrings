        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھلاڑی مجلس کے رواج کے مطابق راؤنڈ کے شروع میں اپنا پروجیکٹ (اگر ہو) بتاتا ہے، پھر کھیل معمول کے مطابق رنگ کی پیروی یا ترپ سے کاٹنے کے ساتھ چلتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खिलाड़ी समूह की परंपरा अनुसार राउंड के आरंभ में अपना प्रोजेक्ट (यदि हो) घोषित करता है, फिर खेल सामान्य रूप से सूट पालन या तुरुप से काटने के साथ चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemain mendeklarasikan proyeknya (bila ada) di awal ronde sesuai kebiasaan, lalu permainan berjalan normal dengan mengikuti simbol atau memotong dengan truf."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "玩家按本圈习惯在本局早期宣告项目（若有），随后按跟花色或砍将的常规方式继续。"
          }
        }
      }
    },
    "يلتزم كل لاعب بعدد أكلات أثناء المزايدة، ثم يُلعب مع وجوب اتّباع النوع المطلوب أو القطع بالطرنيب عند عدم توفره." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each player commits to a number of tricks during the bidding, then play proceeds with the obligation to follow suit or trump when you can't."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun s'engage sur un nombre de plis aux enchères, puis on fournit ou on coupe au Tarneeb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada jugador se compromete a un número de bazas en la puja y luego se sigue el palo o se corta con Tarneeb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder legt beim Reizen eine Stichzahl fest; dann wird bedient oder mit dem Tarneeb gestochen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her oyuncu ihalede bir el sayısına söz verir; sonra istenen sembole uyulur, yoksa Tarneeb ile kesilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый заявляет число взяток в торговле, затем ходят в масть или козыряют Tarneeb."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کھلاڑی بولی میں ہاتھوں کی تعداد کا وعدہ کرتا ہے، پھر مطلوبہ رنگ کی پیروی یا نہ ہونے پر ترنیب سے کاٹنا لازم۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर खिलाड़ी बोली में चालों की संख्या का वादा करता है, फिर सूट पालन या न होने पर तरनीब से काटना अनिवार्य।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap pemain menjanjikan sejumlah trik saat lelang, lalu bermain dengan wajib mengikuti simbol atau memotong dengan Tarneeb bila tak punya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位玩家在叫牌时承诺墩数，随后必须跟花色，没有则用 Tarneeb 砍牌。"
          }
        }
      }
    },
    "يُلعب بنفس قواعد اتّباع النوع أو القطع بالحكم، لكن نتيجة الجولة كاملة تُضرب بالمضاعف المتفق عليه قبل اللعب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Played by the same follow-suit and trumping rules, but the entire round's result is multiplied by the multiplier agreed before play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mêmes règles de fourniture et de coupe, mais le total de la manche est multiplié par le facteur convenu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismas reglas de seguir el palo y cortar, pero el total de la ronda se multiplica por el factor acordado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiche Bedien- und Stechregeln, doch das Rundenergebnis wird mit dem vereinbarten Faktor multipliziert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembole uyma ve kozla kesme kuralları aynıdır; ancak elin tüm sonucu, oyun öncesi anlaşılan çarpanla çarpılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те же правила хода в масть и козырения, но итог раунда умножается на согласованный коэффициент."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ کی پیروی اور ترپ سے کاٹنے کے وہی اصول، مگر پورے راؤنڈ کا نتیجہ طے شدہ ضرب سے ضرب دیا جاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूट पालन और तुरुप से काटने के वही नियम, पर पूरे राउंड का परिणाम तय गुणक से गुणा होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan mengikuti simbol dan memotong dengan truf sama, tetapi hasil seluruh ronde dikalikan pengganda yang disepakati sebelum bermain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟牌与砍将规则不变，但整局结果需乘以开打前约定的倍数。"
          }
        }
      }
    },
    "يوزَّع 8 أوراق لكل لاعب على دفعات (مثل 3-2-3 أو 5-3)، ثم تبدأ مرحلة المزايدة قبل رؤية بقية الأوراق أحيانًا حسب عادة المجلس." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 cards are dealt to each player in batches (such as 3-2-3 or 5-3), then the bidding phase begins — sometimes before the remaining cards are seen, depending on the group's custom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 cartes par joueur en paquets (3-2-3 ou 5-3), puis les enchères, parfois avant de voir le reste selon l'usage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 cartas por jugador por tandas (3-2-3 o 5-3) y luego la puja, a veces antes de ver el resto según la costumbre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 Karten je Spieler in Paketen (3-2-3 oder 5-3), dann das Reizen – je nach Brauch vor dem Sehen des Rests."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her oyuncuya 8 kart partiler hâlinde (3-2-3 ya da 5-3) dağıtılır; sonra meclisin âdetine göre bazen kalan kartlar görülmeden ihale başlar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По 8 карт партиями (3-2-3 или 5-3), затем торговля — иногда до просмотра остальных карт, по обычаю."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کھلاڑی کو 8 کارڈ حصوں میں (جیسے 3-2-3 یا 5-3)، پھر مجلس کے رواج کے مطابق کبھی باقی کارڈ دیکھنے سے پہلے بولی شروع۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर खिलाड़ी को 8 कार्ड किश्तों में (जैसे 3-2-3 या 5-3), फिर समूह की परंपरा अनुसार कभी बाकी कार्ड देखने से पहले बोली शुरू।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 kartu per pemain dibagikan bertahap (misal 3-2-3 atau 5-3), lalu fase lelang dimulai — kadang sebelum melihat sisa kartu, sesuai kebiasaan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每人 8 张分批发出（如 3-2-3 或 5-3），随后进入叫牌；按各圈习惯，有时在看到其余牌之前就开始。"
          }
        }
      }
    },
