            "value" : "Previous"
          }
        }
      }
    },
    "نتائجك متقاربة بين المحاولات السابقة والأخيرة؛ ركز على تقليل خسارة النقاط في الخيارات الثانية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your results are close across previous and recent attempts; focus on reducing point loss in second-best options."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos résultats stagnent : réduisez la perte sur les deuxièmes choix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus resultados son similares entre intentos previos y recientes; reduce la pérdida en las segundas opciones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ergebnisse stagnieren – reduziere Verluste bei den zweitbesten Optionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki ve son denemelerin birbirine yakın; ikinci seçeneklerdeki puan kaybını azaltmaya odaklan."
