        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا سلسلہ مضبوط ہے؛ زیادہ دباؤ میں قرات جانچنے کے لیے اوپر کی سطح آزمائیں۔"
