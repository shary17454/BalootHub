    "اختيارك قريب من مسار المحاكاة الأفضل، لكن لا يزال يخسر عن أفضل محاكاة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wahl liegt nah am besten Simulationspfad, verliert aber noch gegenüber der besten Simulation"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice is close to the best simulation path, but still loses against the best simulation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu elección está cerca de la mejor ruta de simulación, pero aún pierde frente a la mejor simulación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre choix est proche du meilleur chemin de simulation, mais perd encore face à la meilleure simulation"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका चुनाव सर्वश्रेष्ठ सिमुलेशन रास्ते के करीब है, लेकिन अभी भी सर्वश्रेष्ठ सिमुलेशन से पीछे है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan Anda dekat dengan jalur simulasi terbaik, tetapi masih kalah dari simulasi terbaik"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш выбор близок к лучшему пути симуляции, но всё еще уступает лучшей симуляции"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimin en iyi simülasyon yoluna yakın, ancak en iyi simülasyona karşı hâlâ kaybediyor"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا انتخاب بہترین سیمولیشن راستے کے قریب ہے، مگر اب بھی بہترین سیمولیشن سے پیچھے ہے"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择接近最佳模拟路径，但仍落后于最佳模拟"
          }
        }
      }
    },
    "قارن Replay بين المسارين قبل إعادة المحاولة." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche das Replay beider Pfade, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the replay between both paths before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el replay entre ambas rutas antes de intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez le replay des deux chemins avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों रास्तों का रिप्ले तुलना करें, फिर दोबारा प्रयास करें."
          }
        },
        "id" : {
