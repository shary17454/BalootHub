    "تحتاج خادم غرف أو GKMatchmaker، مع اختبارات انقطاع وإعادة اتصال." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires a room server or GKMatchmaker, plus disconnect and reconnect tests."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite un serveur de salons ou GKMatchmaker, avec des tests de déconnexion et de reconnexion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere un servidor de salas o GKMatchmaker, con pruebas de desconexión y reconexión."
          }
        },
        "de" : {
          "stringUnit" : {
