    "المشاريع المعلنة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deklarierte Projekte" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Declared projects" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Proyectos declarados" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Projets annoncés" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "घोषित प्रोजेक्ट" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Proyek diumumkan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Объявленные проекты" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açıklanan projeler" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "اعلان شدہ پروجیکٹس" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已声明项目" } }
      }
    },
    "أضف مشروعًا صالحًا من يد اللاعب المختار ليظهر في الموقف ويدخل مع حالة المحرك والتحليل." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Füge ein gültiges Projekt aus der Hand des gewählten Spielers hinzu, damit es in der Situation erscheint und in Motorzustand und Analyse eingeht." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Add a valid project from the selected player's hand so it appears in the scenario and is included in engine state and analysis." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Agrega un proyecto válido de la mano del jugador elegido para que aparezca en la situación y entre en el estado del motor y el análisis." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoute un projet valide depuis la main du joueur choisi afin qu'il apparaisse dans la situation et soit inclus dans l'état du moteur et l'analyse." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "चुने गए खिलाड़ी के हाथ से एक मान्य प्रोजेक्ट जोड़ें ताकि वह स्थिति में दिखे और इंजन स्थिति व विश्लेषण में शामिल हो." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambahkan proyek valid dari kartu pemain yang dipilih agar muncul di skenario dan masuk ke status mesin serta analisis." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавьте допустимый проект из руки выбранного игрока, чтобы он появился в ситуации и вошёл в состояние движка и анализ." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçilen oyuncunun elinden geçerli bir proje ekle; böylece senaryoda görünür ve motor durumuna ile analize dahil edilir." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "منتخب کھلاڑی کے ہاتھ سے درست پروجیکٹ شامل کریں تاکہ وہ صورتحال میں نظر آئے اور انجن اسٹیٹ اور تجزیے میں شامل ہو۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从所选玩家手牌添加有效项目，使其显示在局面中并进入引擎状态和分析。" } }
      }
    },
    "صاحب المشروع" : {
