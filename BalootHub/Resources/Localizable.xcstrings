    "تميل أحيانًا لحفظ الورقة أو التخلص الآمن عندما توجد فرصة أفضل." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You sometimes keep the card or choose a safe discard when a better chance exists."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gardez parfois la carte ou défaussez prudemment alors qu'il y a mieux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veces guardas la carta o descartas seguro cuando hay una opción mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal hältst du die Karte oder wirfst sicher ab, obwohl es Besseres gibt."
