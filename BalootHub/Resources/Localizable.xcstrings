    "قواعد %@" : {},
    "العب البلوت الكامل: صن وحكم في نفس الطاولة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständiges Baloot spielen: Sun und Hokum am selben Tisch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play full Baloot: Sun and Hokum at the same table"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jugar Baloot completo: Sun y Hokum en la misma mesa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouer au Baloot complet : Sun et Hokum à la même table"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा बलूत खेलें: एक ही मेज़ पर सन और होकुम"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main Baloot lengkap: Sun dan Hokum di meja yang sama"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Играть в полный Baloot: Sun и Hokum за одним столом"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Baloot oyna: Sun ve Hokum aynı masada"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مکمل بلوٹ کھیلیں: سن اور حکم ایک ہی میز پر"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游玩完整 Baloot：Sun 和 Hokum 在同一桌"
          }
        }
      }
    },
    "مرجع نمط" : {
      "localizations" : {
        "de" : {
