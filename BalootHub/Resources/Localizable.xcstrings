    "الأولوية الآن ليست كثرة المواقف، بل فهم سبب الخطأ الأخير." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The priority now is not more scenarios, but understanding the latest mistake."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La priorité n'est pas le nombre de situations, mais la cause de la dernière erreur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prioridad no es más situaciones, sino entender la última equivocación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorrang hat nicht die Menge an Situationen, sondern die Ursache des letzten Fehlers."
