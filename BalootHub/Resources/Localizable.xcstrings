    "جلسة تقليل القرارات المكلفة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzung zum Reduzieren kostspieliger Entscheidungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costly decision reduction session"
          }
        },
        "es" : {
