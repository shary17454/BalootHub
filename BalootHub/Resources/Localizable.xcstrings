        }
      }
    },
    "بعض أخطائك جاءت من بداية الأكلة بورقة تخفض الأثر المتوقع. عند الافتتاح، اختر ورقة تكشف أقل قدر من قوتك أو تسحب الحكم لغرض واضح." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Fehler entstehen, weil du den Stich mit einer Karte beginnst, die den erwarteten Effekt senkt. Wähle beim Eröffnen eine Karte, die wenig Stärke verrät oder Trumpf aus einem klaren Grund zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some mistakes came from leading a trick with a card that lowers expected impact. When opening, choose a card that reveals less of your strength or pulls trump for a clear reason."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos errores vinieron de iniciar la baza con una carta que reduce el impacto esperado. Al salir, elige una carta que revele menos fuerza o que saque triunfo con un motivo claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines erreurs viennent d'une entame qui réduit l'impact attendu. À l'entame, choisis une carte qui révèle moins ta force ou qui tire l'atout pour une raison claire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ गलतियाँ ऐसी पत्ती से बाज़ी शुरू करने से आईं जो अपेक्षित प्रभाव घटाती है। शुरुआत में ऐसी पत्ती चुनें जो आपकी ताकत कम दिखाए या साफ कारण से हुकुम निकाले।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa kesalahan berasal dari membuka trik dengan kartu yang menurunkan dampak yang diharapkan. Saat membuka, pilih kartu yang tidak banyak membuka kekuatanmu atau menarik trump dengan alasan jelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть ошибок связана с началом взятки картой, снижающей ожидаемый эффект. При заходе выбирайте карту, которая меньше раскрывает силу, или тяните козырь с понятной целью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı hataların, beklenen etkiyi düşüren bir kartla eli açmaktan geldi. Açılışta gücünü az gösteren ya da net bir amaçla kozu çeken kartı seç."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کچھ غلطیاں ایسی چال شروع کرنے سے ہوئیں جس سے متوقع اثر کم ہوا۔ آغاز پر ایسا پتا چنیں جو آپ کی طاقت کم ظاہر کرے یا واضح مقصد سے حکم نکالے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分失误来自用会降低预期影响的牌开墩。首攻时选择较少暴露实力的牌，或在有明确目的时引出将牌。"
          }
        }
      }
    },
    "بدأت الأكلة بورقة تخفض الأثر المتوقع. جرّب افتتاحًا يحفظ القوة أو يسحب الحكم بسبب واضح." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast den Stich mit einer Karte begonnen, die den erwarteten Effekt senkt. Versuche eine Eröffnung, die Stärke bewahrt oder Trumpf aus einem klaren Grund zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You led the trick with a card that lowers expected impact. Try an opening that preserves strength or pulls trump for a clear reason."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciaste la baza con una carta que reduce el impacto esperado. Prueba una salida que conserve fuerza o saque triunfo con un motivo claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as entamé le pli avec une carte qui réduit l'impact attendu. Essaie une entame qui conserve la force ou tire l'atout pour une raison claire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने ऐसी पत्ती से बाज़ी शुरू की जो अपेक्षित प्रभाव घटाती है। ऐसी शुरुआत आज़माएँ जो ताकत बचाए या साफ कारण से हुकुम निकाले।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu membuka trik dengan kartu yang menurunkan dampak yang diharapkan. Coba pembukaan yang menjaga kekuatan atau menarik trump dengan alasan jelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы начали взятку картой, снижающей ожидаемый эффект. Попробуйте заход, который сохраняет силу или тянет козырь с понятной целью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eli, beklenen etkiyi düşüren bir kartla açtın. Gücü koruyan ya da net bir nedenle kozu çeken bir açılış dene."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ نے چال ایسے پتے سے شروع کی جس سے متوقع اثر کم ہوا۔ ایسی شروعات آزمائیں جو طاقت بچائے یا واضح وجہ سے حکم نکالے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用会降低预期影响的牌开墩。尝试保留实力的首攻，或在有明确原因时引出将牌。"
          }
        }
      }
    },
    "تغلق الأكلة للخصم" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schließt den Stich für den Gegner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You close the trick for the opponent"
          }
        },
        "es" : {
