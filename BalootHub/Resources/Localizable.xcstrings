    "الرتبة التالية" : {},
    "المرحلة التالية هي اللعب ضد خصوم أقوى ومراجعة Replay بعد كل جولة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next step is playing stronger opponents and reviewing the replay after each round."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'étape suivante : affronter des adversaires plus forts et revoir le replay après chaque manche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El siguiente paso es jugar contra rivales más fuertes y revisar la repetición tras cada ronda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nächste Schritt: gegen stärkere Gegner spielen und nach jeder Runde das Replay ansehen."
