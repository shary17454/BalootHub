        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous lisez bien la situation, vos choix frôlent ceux de l'expert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando lees bien la situación, llegas a elecciones cercanas al experto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Situation gut liest, triffst du Wahlen nahe am Experten."
