    "اقرأ مواقف وش تلعب واختر نفس قرار الخبير." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies Was spielst du?-Szenarien und wähle dieselbe Entscheidung wie der Experte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read What to Play scenarios and choose the same decision as the expert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee escenarios de ¿Qué juegas? y elige la misma decisión que el experto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis les situations Que jouer ? et choisis la même décision que l'expert."
