    "أعد الجلسة وركّز على تقليل الفارق عن اختيار الخبير قبل رفع الصعوبة." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Sitzung und konzentriere dich darauf, den Abstand zur Expertenwahl zu verringern, bevor du die Schwierigkeit erhöhst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat the session and focus on reducing the gap from the expert choice before raising difficulty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite la sesión y céntrate en reducir la diferencia con la elección del experto antes de subir la dificultad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète la session et concentre-toi sur la réduction de l’écart avec le choix de l’expert avant d’augmenter la difficulté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कठिनाई बढ़ाने से पहले सत्र दोहराएँ और विशेषज्ञ के चुनाव से अंतर कम करने पर ध्यान दें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi sesi dan fokus mengurangi selisih dari pilihan ahli sebelum menaikkan kesulitan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтори сессию и сосредоточься на сокращении разрыва с выбором эксперта перед повышением сложности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorluğu artırmadan önce oturumu tekrarla ve uzman seçimiyle aradaki farkı azaltmaya odaklan."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشکل بڑھانے سے پہلے سیشن دہرائیں اور ماہر کے انتخاب سے فرق کم کرنے پر توجہ دیں."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高难度前，重复本训练并专注缩小与专家选择的差距。"
          }
        }
      }
    },
    "الدقة وحدها لا تكفي هنا؛ ركز على تقليل الفارق بين اختيارك واختيار الخبير قبل رفع المستوى." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit allein reicht hier nicht; konzentriere dich darauf, den Abstand zwischen deiner Wahl und der Expertenwahl zu verringern, bevor du das Niveau erhöhst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accuracy alone is not enough here; focus on reducing the gap between your choice and the expert choice before raising the level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La precisión sola no basta aquí; céntrate en reducir la diferencia entre tu elección y la del experto antes de subir el nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La précision seule ne suffit pas ici ; concentre-toi sur la réduction de l’écart entre ton choix et celui de l’expert avant d’augmenter le niveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ केवल सटीकता काफी नहीं है; स्तर बढ़ाने से पहले अपने चुनाव और विशेषज्ञ के चुनाव के बीच का अंतर घटाने पर ध्यान दें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akurasi saja belum cukup di sini; fokuslah mengurangi selisih antara pilihanmu dan pilihan ahli sebelum menaikkan level."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одной точности здесь недостаточно; сосредоточься на сокращении разрыва между своим выбором и выбором эксперта перед повышением уровня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada yalnızca doğruluk yetmez; seviyeyi artırmadan önce seçiminle uzman seçimi arasındaki farkı azaltmaya odaklan."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں صرف درستگی کافی نہیں؛ سطح بڑھانے سے پہلے اپنے انتخاب اور ماہر کے انتخاب کے فرق کو کم کرنے پر توجہ دیں."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里只看准确率还不够；提高等级前，先专注缩小你的选择与专家选择之间的差距。"
          }
        }
      }
    },
    "هدف الجلسة: متوسط نقاط ضائعة أقل من 4." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
