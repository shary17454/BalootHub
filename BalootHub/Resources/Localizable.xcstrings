            "state" : "translated",
            "value" : "Lapisan transport abstrak"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抽象传输层"
          }
        }
      }
    },
    "MatchTransport يفصل المحرك عن وسيلة النقل، وتنفيذه المحلي يعمل اليوم بلا شبكة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport separates the engine from the transport, and its local implementation works today with no network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport sépare le moteur du transport ; son implémentation locale fonctionne déjà sans réseau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport separa el motor del transporte y su implementación local ya funciona sin red."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport trennt Engine und Transport; die lokale Implementierung läuft schon ohne Netz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport motoru taşımadan ayırır; yerel uygulaması bugün ağsız çalışır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport отделяет движок от транспорта, а его локальная реализация уже работает без сети."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport انجن کو ٹرانسپورٹ سے الگ کرتا ہے، اور اس کا مقامی نفاذ آج بغیر نیٹ ورک چلتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport इंजन को ट्रांसपोर्ट से अलग करता है, और इसका लोकल क्रियान्वयन आज बिना नेटवर्क चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport memisahkan mesin dari transport, dan implementasi lokalnya sudah jalan tanpa jaringan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MatchTransport 将引擎与传输解耦，其本地实现今天即可无网运行。"
          }
        }
      }
    },
