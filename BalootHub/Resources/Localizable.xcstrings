        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接近的选择"
          }
        }
      }
    },
    "اختيارك خسر قيمة متوقعة مقارنة بالأفضل. ابحث عن الورقة التي تقلل الخسارة حتى لو لم تربح الأكلة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice lost expected value compared with the best option. Look for the card that reduces loss even if it does not win the trick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre choix perd de la valeur : cherchez la carte qui limite la perte, même sans gagner le pli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu elección perdió valor esperado; busca la carta que reduzca la pérdida aunque no ganes la baza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wahl kostet Erwartungswert – suche die Karte, die den Verlust mindert, auch ohne Stich."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimin en iyiye kıyasla beklenen değer kaybetti. Eli almasan bile kaybı azaltan kartı ara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой выбор потерял ожидаемую ценность — ищи карту, снижающую потери, даже без взятки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے انتخاب نے بہترین کے مقابلے متوقع قدر کھوئی۔ وہ کارڈ ڈھونڈیں جو ہاتھ نہ جیتے بھی نقصان کم کرے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चयन ने श्रेष्ठ की तुलना में अपेक्षित मूल्य खोया। वह कार्ड खोजें जो चाल न जीते तब भी हानि घटाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihanmu kehilangan nilai harapan dibanding yang terbaik. Cari kartu yang menekan kerugian meski tak memenangi trik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相较最优，你的选择损失了期望价值：找出即便拿不下这墩也能减损的牌。"
          }
        }
      }
    },
    "استخدم هذه الخطوات القصيرة قبل الانتقال للموقف التالي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use these short steps before moving to the next scenario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez ces étapes courtes avant de passer à la situation suivante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa estos pasos cortos antes de pasar a la siguiente situación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze diese kurzen Schritte, bevor du zur nächsten Situation gehst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki duruma geçmeden önce bu kısa adımları uygula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройди эти короткие шаги перед переходом к следующей ситуации."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلی صورتحال پر جانے سے پہلے یہ مختصر مراحل استعمال کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली स्थिति पर जाने से पहले ये छोटे कदम अपनाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan langkah singkat ini sebelum lanjut ke situasi berikutnya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进入下一局面前，先走完这几个小步骤。"
          }
        }
      }
    },
    "افحص الحكم الموجود على الطاولة قبل رمي ورقة عالية أو حكم أعلى." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect the trump on the table before throwing a high card or a higher trump."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l'atout sur la table avant de jeter une haute carte ou un atout supérieur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el triunfo en la mesa antes de tirar una carta alta o un triunfo mayor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Trumpf auf dem Tisch, bevor du hoch abwirfst oder höher stichst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek kart ya da daha üstün koz atmadan önce masadaki kozu incele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
