    "أثر اختياراتك جيد عندما تصيب، لكنك تحتاج تقليل الأخطاء المباشرة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices have good impact when you are right, but you need to reduce direct mistakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos bons coups ont de l'impact, mais réduisez les erreurs directes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando aciertas el impacto es bueno, pero debes reducir los errores directos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du triffst, ist die Wirkung gut – reduziere aber direkte Fehler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsabet ettiğinde etkin iyi, ama doğrudan hataları azaltman gerek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда попадаешь — эффект хороший, но нужно меньше прямых ошибок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب آپ درست ہوتے ہیں تو اثر اچھا ہے، مگر براہِ راست غلطیاں کم کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप सही होते हैं तो प्रभाव अच्छा है, पर सीधी ग़लतियाँ घटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dampak pilihanmu bagus saat benar, tetapi kurangi kesalahan langsung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选对时影响不错，但要减少直接失误。"
          }
        }
      }
    },
