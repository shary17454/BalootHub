    "قرارك يطابق أفضل خيار في الأكلة الحالية، لكن محاكاة بقية الجولة تستحق المراجعة قبل تثبيت النمط." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Entscheidung entspricht der besten Option im aktuellen Stich, aber die Simulation der restlichen Runde sollte vor dem Festigen des Musters überprüft werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision matches the best option for the current trick, but the rest-of-round simulation is worth reviewing before locking in the pattern." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu decisión coincide con la mejor opción de la baza actual, pero conviene revisar la simulación del resto de la ronda antes de fijar el patrón." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ta décision correspond à la meilleure option du pli actuel, mais la simulation du reste de la manche mérite d'être revue avant d'ancrer ce schéma." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका निर्णय मौजूदा ट्रिक के लिए सबसे अच्छे विकल्प से मेल खाता है, लेकिन पैटर्न पक्का करने से पहले बाकी राउंड की सिमुलेशन समीक्षा करनी चाहिए।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusanmu cocok dengan opsi terbaik untuk trik saat ini, tetapi simulasi sisa ronde layak ditinjau sebelum pola itu dikunci." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваше решение совпадает с лучшим вариантом для текущей взятки, но симуляцию остатка раунда стоит проверить, прежде чем закреплять этот шаблон." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararın mevcut el için en iyi seçenekle eşleşiyor, ancak bu kalıbı kesinleştirmeden önce turun kalan simülasyonunu gözden geçirmek gerekir." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا فیصلہ موجودہ چال کے بہترین اختیار سے ملتا ہے، مگر اس انداز کو پکا کرنے سے پہلے باقی راؤنڈ کی سیمولیشن دیکھنا بہتر ہے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的决策符合当前一墩的最佳选择，但在固定这个模式前，值得复盘剩余整轮的模拟。" } }
      }
    },
    "اختيارك صحيح في الأكلة الحالية، لكن نتيجة الجولة الكاملة تشير إلى مسار أقوى." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Wahl ist für den aktuellen Stich richtig, aber das Ergebnis der gesamten Runde zeigt einen stärkeren Weg." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your choice is correct for the current trick, but the full-round result points to a stronger line." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu elección es correcta para la baza actual, pero el resultado de la ronda completa apunta a una línea más fuerte." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton choix est correct pour le pli actuel, mais le résultat de la manche complète indique une ligne plus forte." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी चाल मौजूदा ट्रिक के लिए सही है, लेकिन पूरे राउंड का परिणाम एक मजबूत लाइन दिखाता है।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilihanmu benar untuk trik saat ini, tetapi hasil ronde penuh menunjukkan jalur yang lebih kuat." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваш выбор верен для текущей взятки, но результат всего раунда указывает на более сильную линию." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçimin mevcut el için doğru, ancak tam tur sonucu daha güçlü bir hattı gösteriyor." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کا انتخاب موجودہ چال کے لیے درست ہے، مگر مکمل راؤنڈ کا نتیجہ ایک زیادہ مضبوط راستہ دکھاتا ہے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的选择对当前一墩是正确的，但整轮结果指向更强的路线。" } }
      }
    },
    "قرارك يخسر بعد استكمال الجولة؛ راجع Replay كامل قبل لعب موقف جديد." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Entscheidung verliert nach Abschluss der Runde; prüfe das vollständige Replay, bevor du eine neue Situation spielst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision loses after the round is completed; review the full replay before playing a new scenario." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu decisión pierde al completar la ronda; revisa la repetición completa antes de jugar una nueva situación." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ta décision perd après la fin de la manche ; revois le replay complet avant de jouer une nouvelle situation." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "राउंड पूरा होने के बाद आपका निर्णय अंक गंवाता है; नया परिदृश्य खेलने से पहले पूरा replay देखें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusanmu kalah setelah ronde selesai; tinjau replay penuh sebelum memainkan skenario baru." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваше решение проигрывает после завершения раунда; просмотрите полный повтор перед новым сценарием." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararın tur tamamlandıktan sonra kaybettiriyor; yeni bir senaryo oynamadan önce tam replay'i incele." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "راؤنڈ مکمل ہونے کے بعد آپ کا فیصلہ نقصان دیتا ہے؛ نیا منظر کھیلنے سے پہلے مکمل replay دیکھیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的决策在整轮完成后会失分；开始新局面前先复盘完整回放。" } }
      }
    },
    "جلسة مراجعة المحاكاة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Simulations-Review-Sitzung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Simulation review session" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sesión de revisión de simulación" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Session de revue de simulation" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिमुलेशन समीक्षा सत्र" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Sesi tinjauan simulasi" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сессия разбора симуляции" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Simülasyon inceleme seansı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "سیمولیشن جائزہ سیشن" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模拟复盘训练" } }
      }
    },
    "قراراتك لا تخسر الأثر اللحظي فقط؛ المحاكاة تكشف فاقدًا بعد اكتمال الجولة. راجع Replay لكل اختيار وقارن نتيجة الفريق." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Entscheidungen verlieren nicht nur Sofortwirkung; die Simulation zeigt Verluste nach der gesamten Runde. Prüfe für jede Wahl das Replay und vergleiche das Teamergebnis." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decisions are not only losing immediate impact; the simulation shows loss after the round finishes. Review each choice replay and compare the team result." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus decisiones no solo pierden impacto inmediato; la simulación muestra pérdida tras completar la ronda. Revisa el replay de cada elección y compara el resultado del equipo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes décisions ne perdent pas seulement l'impact immédiat ; la simulation révèle une perte après la manche complète. Revois le replay de chaque choix et compare le résultat de l'équipe." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके निर्णय केवल तत्काल प्रभाव नहीं गंवाते; सिमुलेशन पूरे राउंड के बाद नुकसान दिखाता है। हर चुनाव का replay देखें और टीम परिणाम की तुलना करें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusanmu tidak hanya kehilangan dampak langsung; simulasi menunjukkan kerugian setelah ronde selesai. Tinjau replay tiap pilihan dan bandingkan hasil tim." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши решения теряют не только мгновенный эффект; симуляция показывает потери после завершения раунда. Просмотрите replay каждого выбора и сравните результат команды." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararların yalnızca anlık etki kaybetmiyor; simülasyon tur tamamlandıktan sonra kaybı gösteriyor. Her seçimin replay'ini incele ve takım sonucunu karşılaştır." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے فیصلے صرف فوری اثر نہیں کھوتے؛ سیمولیشن راؤنڈ مکمل ہونے کے بعد نقصان دکھاتی ہے۔ ہر انتخاب کا replay دیکھیں اور ٹیم کا نتیجہ موازنہ کریں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的决策不只损失即时影响；模拟会显示整轮结束后的损失。复盘每个选择的回放，并比较队伍结果。" } }
      }
    },
    "هدف الجلسة: متوسط نقاط محاكاة ضائعة أقل من 6." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sitzungsziel: durchschnittlich weniger als 6 verlorene Simulationspunkte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Session goal: average lost simulation points under 6." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Objetivo de la sesión: promedio de puntos de simulación perdidos por debajo de 6." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Objectif de session : moins de 6 points de simulation perdus en moyenne." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सत्र लक्ष्य: औसत खोए हुए सिमुलेशन अंक 6 से कम।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Target sesi: rata-rata poin simulasi hilang di bawah 6." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Цель сессии: средние потерянные очки симуляции меньше 6." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seans hedefi: ortalama kaybedilen simülasyon puanı 6'nın altında." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "سیشن کا ہدف: اوسط ضائع شدہ سیمولیشن پوائنٹس 6 سے کم۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "训练目标：平均损失模拟分数低于 6。" } }
      }
    },
    "خطة محاكاة القرار" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entscheidungssimulationsplan" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Decision simulation plan" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Plan de simulación de decisiones" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plan de simulation de décision" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "निर्णय सिमुलेशन योजना" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Rencana simulasi keputusan" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "План симуляции решения" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Karar simülasyonu planı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "فیصلے کی سیمولیشن منصوبہ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "决策模拟计划" } }
      }
    },
    "راجع قرارًا تغيّرت قيمته بعد استكمال الجولة، لا الأكلة الحالية فقط." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Überprüfe eine Entscheidung, deren Wert sich nach Abschluss der Runde geändert hat, nicht nur im aktuellen Stich." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review a decision whose value changed after finishing the round, not just the current trick." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa una decisión cuyo valor cambió al completar la ronda, no solo la baza actual." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révise une décision dont la valeur change après la manche complète, pas seulement le pli actuel." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "उस निर्णय की समीक्षा करें जिसका मूल्य पूरी राउंड के बाद बदला, सिर्फ मौजूदा ट्रिक में नहीं।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinjau keputusan yang nilainya berubah setelah ronde selesai, bukan hanya trik saat ini." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пересмотри решение, ценность которого изменилась после завершения раунда, а не только текущей взятки." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sadece mevcut elde değil, tur tamamlanınca değeri değişen bir kararı incele." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایسے فیصلے کا جائزہ لیں جس کی قدر راؤنڈ مکمل ہونے کے بعد بدلی، صرف موجودہ ٹرک میں نہیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复盘一个在整局完成后价值发生变化的决策，而不只是当前一墩。" } }
      }
    },
    "قارن نتيجة الجولة لا الأكلة فقط" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vergleiche das Rundenergebnis, nicht nur den Stich" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Compare the round result, not just the trick" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Compara el resultado de la ronda, no solo la baza" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Compare le résultat de la manche, pas seulement le pli" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिर्फ ट्रिक नहीं, पूरी राउंड का परिणाम तुलना करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Bandingkan hasil ronde, bukan hanya trik" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сравни результат раунда, а не только взятку" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sadece eli değil, tur sonucunu karşılaştır" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "صرف ٹرک نہیں، راؤنڈ کا نتیجہ موازنہ کریں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "比较整局结果，而不只是这一墩" } }
      }
    },
    "كرر نفس نوع الموقف" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wiederhole denselben Situationstyp" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Repeat the same situation type" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Repite el mismo tipo de situación" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Répète le même type de situation" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "उसी प्रकार की स्थिति दोहराएँ" } },
