            "state" : "translated",
            "value" : "Close to expert"
          }
        }
      }
    },
    "اختياراتك غالبًا تطابق أفضل قرار أو تحافظ على قيمة متوقعة جيدة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices often match the best decision or preserve solid expected value."
          }
        }
      }
    },
    "تقرأ الأكلة وتختار الورقة الرابحة أو الأقل خسارة بثبات." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the trick and consistently choose the winning or least costly card."
          }
        }
      }
    },
    "الخطر القادم هو التعود على المواقف السهلة وعدم اختبار القراءة تحت ضغط." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next risk is getting used to easy scenarios without testing reads under pressure."
          }
        }
      }
    },
    "ارفع الصعوبة وركز على مواقف الحكم وقراءة نية الشريك." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise the difficulty and focus on Hokum scenarios and reading partner intent."
          }
        }
      }
    },
    "قراراتك الحالية لا تزال بعيدة عن اختيار الخبير في أغلب المواقف." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current decisions are still far from the expert choice in most scenarios."
          }
        }
      }
    },
    "لديك فرصة واضحة للتحسن السريع بمجرد ضبط التلزيم والقطع." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have a clear chance to improve quickly once follow-suit and trumping are controlled."
          }
        }
      }
    },
    "أكبر نقطة ضعف هي اختيار الورقة قبل قراءة اللون المطلوب والحكم." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The biggest weakness is choosing before reading the required suit and trump."
          }
        }
