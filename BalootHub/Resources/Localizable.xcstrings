        }
      }
    },
    "تحقيق أفضل نتيجة عبر تجنّب أوراق أو أكلات معيّنة تخسر نقاطًا، بحسب الصيغة المعتمدة من اللاعبين." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the best result by avoiding certain cards or tricks that lose points, according to the format the players adopt."
          }
        }
      }
    },
    "تحقيق أقل عدد نقاط سلبية (أو أعلى نقاط إيجابية حسب الجولة) عبر دورة من عدة أنماط لعب مختلفة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish with the fewest penalty points (or the most positive points, depending on the round) across a cycle of several different play modes."
          }
        }
      }
    },
    "تحقيق عدد الأكلات الذي التزم به اللاعب أو الفريق أثناء المزايدة، أو أكثر." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win at least the number of tricks you or your team committed to during the bidding."
          }
        }
      }
    },
    "تختلف طريقة الاحتساب من جولة لأخرى داخل نفس الدورة، وتُجمع النقاط تراكميًا حتى نهاية الدورة الكاملة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calculation method differs from one round to the next within the same cycle, and points accumulate until the full cycle ends."
          }
        }
      }
    },
