    "تُستخدم حزمة من 32 ورقة (من 7 حتى الآس). يُحدَّد الموزّع الأول بالاتفاق أو بالقرعة، ثم يدور التوزيع بالتناوب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 32-card deck is used (7 through Ace). The first dealer is chosen by agreement or by draw, then the deal rotates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeu de 32 cartes (du 7 à l'As). Le premier donneur est désigné par accord ou tirage, puis la donne tourne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baraja de 32 cartas (del 7 al As). El primer repartidor se elige por acuerdo o sorteo y luego el reparto rota."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32-Karten-Deck (7 bis Ass). Der erste Geber wird vereinbart oder ausgelost, dann rotiert das Geben."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32 kartlık deste kullanılır (7'den As'a). İlk dağıtıcı anlaşmayla ya da kurayla belirlenir, sonra dağıtım sırayla döner."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колода из 32 карт (от 7 до туза). Первого сдающего выбирают по договорённости или жребию, затем сдача идёт по кругу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32 کارڈ کی گڈی (7 سے اِکّہ تک)۔ پہلا تقسیم کار اتفاق یا قرعے سے، پھر تقسیم باری باری گھومتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32 कार्ड की गड्डी (7 से इक्का तक)। पहला बाँटने वाला सहमति या पर्ची से तय, फिर बाँट बारी-बारी घूमती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai dek 32 kartu (7 sampai As). Pembagi pertama ditentukan lewat kesepakatan atau undian, lalu pembagian berputar bergiliran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 32 张牌（7 至 A）。首位发牌者由约定或抽签决定，之后轮流发牌。"
          }
        }
      }
    },
    "تُستخدم حزمة ورق عادية أو مختصرة حسب عرف اللاعبين قبل البدء." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A standard or shortened deck is used, according to the players' custom, before starting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On utilise un jeu complet ou réduit selon l'usage convenu avant de commencer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa una baraja completa o reducida según la costumbre acordada antes de empezar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Spielbeginn wird je nach Brauch ein volles oder verkürztes Deck genutzt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamadan önce oyuncuların âdetine göre tam ya da kısaltılmış deste kullanılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед началом берут полную или укороченную колоду по договорённости."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع سے پہلے کھلاڑیوں کے رواج کے مطابق مکمل یا مختصر گڈی استعمال ہوتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने से पहले खिलाड़ियों की परंपरा अनुसार पूरी या छोटी गड्डी ली जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum mulai, dipakai dek penuh atau dipersingkat sesuai kebiasaan pemain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开局前按牌友习惯使用整副或删减牌组。"
          }
        }
      }
    },
    "تُستخدم حزمة ورق كاملة من 52 ورقة عادة." : {
