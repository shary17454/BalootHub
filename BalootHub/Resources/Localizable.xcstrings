        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ مفید تجربہ جمع کر رہے ہیں؛ ہر فیصلے کی وجہ دیکھیں اور نقصان دینے والی صورتحال دہرائیں۔"
