    "قراراتك الأخيرة نظيفة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent decisions are clean"
          }
        }
      }
    },
    "آخر محاولاتك تطابق أفضل قرار؛ جرّب صعوبة أعلى أو ركز على تفسير سبب التفوق." : {
      "localizations" : {
