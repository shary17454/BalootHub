    "راجع Replay اختيارك وأفضل قرار بعد كل موقف، وابق على مستوى قريب حتى تنخفض القرارات المكلفة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe nach jedem Szenario das Replay deiner Wahl und der besten Entscheidung und bleibe auf einem nahen Niveau, bis kostspielige Entscheidungen sinken." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After each scenario, review your choice replay and the best decision replay, and stay near your current level until costly decisions drop." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Después de cada situación, revisa la repetición de tu elección y la mejor decisión, y mantente cerca de tu nivel hasta que bajen las decisiones costosas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après chaque situation, revoyez le replay de votre choix et du meilleur choix, et restez près de votre niveau jusqu’à ce que les décisions coûteuses diminuent." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "हर स्थिति के बाद अपनी पसंद और सर्वोत्तम निर्णय का रीप्ले देखें, और महंगे निर्णय घटने तक अपने स्तर के पास रहें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Setelah tiap skenario, tinjau replay pilihan Anda dan keputusan terbaik, lalu tetap di level yang dekat sampai keputusan mahal menurun." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "После каждого сценария просматривайте повтор вашего выбора и лучшего решения и оставайтесь рядом с текущим уровнем, пока дорогие решения не снизятся." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her senaryodan sonra kendi seçiminin ve en iyi kararın tekrarını incele; maliyetli kararlar düşene kadar seviyene yakın kal." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ہر موقف کے بعد اپنے انتخاب اور بہترین فیصلے کا Replay دیکھیں، اور مہنگے فیصلے کم ہونے تک اپنی سطح کے قریب رہیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每个情境后复盘你的选择回放和最佳决策回放，并在高代价决策减少前保持接近当前水平。" } }
      }
    },
    "هدف الجلسة: لا يوجد أكثر من قرار مكلف واحد." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sitzungsziel: höchstens eine kostspielige Entscheidung." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Session goal: no more than one costly decision." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Objetivo de la sesión: no más de una decisión costosa." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Objectif de session : pas plus d’une décision coûteuse." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सत्र लक्ष्य: एक से अधिक महंगा निर्णय नहीं।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Target sesi: tidak lebih dari satu keputusan mahal." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Цель сессии: не более одного дорогого решения." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Oturum hedefi: en fazla bir maliyetli karar." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "نشست کا ہدف: ایک سے زیادہ مہنگا فیصلہ نہیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "训练目标：高代价决策不超过一次。" } }
      }
    },
    "خطة تقليل القرارات المكلفة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Plan zum Reduzieren kostspieliger Entscheidungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Costly decision reduction plan" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Plan para reducir decisiones costosas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plan de réduction des décisions coûteuses" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "महंगे निर्णय घटाने की योजना" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Rencana mengurangi keputusan mahal" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "План снижения дорогих решений" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Maliyetli kararları azaltma planı" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مہنگے فیصلے کم کرنے کا منصوبہ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "减少高代价决策计划" } }
      }
    },
    "اجعل التدريب القادم قصيرًا ومبنيًا على مقارنة Replay اختيارك بأفضل قرار." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Halte das nächste Training kurz und baue es auf dem Vergleich des Replays deiner Wahl mit der besten Entscheidung auf." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep the next drill short and base it on comparing your replay with the best decision replay." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Haz que el próximo entrenamiento sea corto y basado en comparar la repetición de tu elección con la mejor decisión." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Gardez le prochain entraînement court et comparez le replay de votre choix au meilleur choix." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अगला अभ्यास छोटा रखें और अपनी पसंद के रीप्ले की तुलना सर्वोत्तम निर्णय से करें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Buat latihan berikutnya singkat dan bandingkan replay pilihan Anda dengan replay keputusan terbaik." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сделайте следующую тренировку короткой и сравните повтор вашего выбора с повтором лучшего решения." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonraki çalışmayı kısa tut ve kendi seçiminin tekrarını en iyi kararın tekrarıyla karşılaştır." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "اگلی مشق مختصر رکھیں اور اپنے انتخاب کے Replay کا بہترین فیصلے سے موازنہ کریں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一次训练保持简短，并比较你的选择回放与最佳决策回放。" } }
      }
    },
    "شاهد Replay أفضل قرار" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Replay der besten Entscheidung ansehen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Watch the best-decision replay" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ver la repetición de la mejor decisión" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Voir le replay de la meilleure décision" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सर्वश्रेष्ठ निर्णय का रीप्ले देखें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tonton replay keputusan terbaik" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Посмотреть повтор лучшего решения" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "En iyi kararın tekrarını izle" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "بہترین فیصلے کا Replay دیکھیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观看最佳决策回放" } }
      }
    },
    "لا ترفع الصعوبة حتى تنخفض القرارات المكلفة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erhöhe die Schwierigkeit erst, wenn kostspielige Entscheidungen sinken" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Do not raise difficulty until costly decisions drop" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No subas la dificultad hasta que bajen las decisiones costosas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "N’augmentez pas la difficulté avant que les décisions coûteuses diminuent" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "महंगे निर्णय घटने तक कठिनाई न बढ़ाएँ" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Jangan naikkan kesulitan sampai keputusan mahal menurun" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не повышайте сложность, пока дорогие решения не снизятся" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Maliyetli kararlar düşmeden zorluğu artırma" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مہنگے فیصلے کم ہونے تک مشکل نہ بڑھائیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在高代价决策减少前不要提高难度" } }
      }
    },
    "قلّل القرارات المكلفة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Reduziere kostspielige Entscheidungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reduce costly decisions" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Reduce decisiones costosas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réduire les décisions coûteuses" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "महंगे निर्णय कम करें" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kurangi keputusan mahal" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Снизьте число дорогих решений" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Maliyetli kararları azalt" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "مہنگے فیصلے کم کریں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "减少高代价决策" } }
      }
    },
    "اختر مواقف قريبة من مستواك وراجع Replay أفضل قرار قبل رفع الصعوبة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle Situationen nahe an deinem Niveau und prüfe das Replay der besten Entscheidung, bevor du die Schwierigkeit erhöhst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose scenarios close to your level and review the best-decision replay before raising difficulty." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige situaciones cercanas a tu nivel y revisa la repetición de la mejor decisión antes de subir la dificultad." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez des situations proches de votre niveau et revoyez le replay de la meilleure décision avant d’augmenter la difficulté." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने स्तर के करीब स्थितियाँ चुनें और कठिनाई बढ़ाने से पहले सर्वश्रेष्ठ निर्णय का रीप्ले देखें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih skenario yang dekat dengan level Anda dan tinjau replay keputusan terbaik sebelum menaikkan kesulitan." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выбирайте ситуации близко к вашему уровню и пересматривайте повтор лучшего решения перед повышением сложности." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zorluğu artırmadan önce seviyene yakın senaryolar seç ve en iyi kararın tekrarını incele." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "اپنی سطح کے قریب مواقف منتخب کریں اور مشکل بڑھانے سے پہلے بہترین فیصلے کا Replay دیکھیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择接近你水平的情境，并在提高难度前复盘最佳决策回放。" } }
      }
    },
    "قرارات مكلفة متكررة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wiederholt kostspielige Entscheidungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Frequent costly decisions" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Decisiones costosas frecuentes" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Décisions coûteuses fréquentes" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बार-बार महंगे निर्णय" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusan mahal berulang" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Частые дорогие решения" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sık maliyetli kararlar" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "بار بار مہنگے فیصلے" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "频繁高代价决策" } }
      }
    },
    "نسبة القرارات التي تخسر أثرًا كبيرًا مرتفعة. قبل لعب الورقة، قارنها بأفضل قرار واسأل: هل سأخسر أكلة أو أرمي نقاطًا بلا مقابل؟" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Anteil der Entscheidungen mit hohem Wertverlust ist hoch. Vergleiche deine Karte vor dem Ausspielen mit der besten Entscheidung und frage dich: Verliere ich damit einen Stich oder werfe ich Punkte ohne Gegenwert weg?" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A high share of your decisions loses major expected value. Before playing, compare the card with the best decision and ask: will I lose the trick or throw points away?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Una proporción alta de tus decisiones pierde mucho valor esperado. Antes de jugar, compárala con la mejor decisión y pregunta: ¿pierdo la baza o regalo puntos?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une part élevée de vos décisions perd beaucoup de valeur attendue. Avant de jouer, comparez la carte au meilleur choix et demandez-vous : vais-je perdre le pli ou donner des points ?" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके कई निर्णय बड़ा अपेक्षित मूल्य गंवाते हैं। कार्ड खेलने से पहले उसे सर्वोत्तम निर्णय से तुलना करें और पूछें: क्या मैं बाजी हारूँगा या अंक बेकार दूँगा?" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Porsi keputusan yang kehilangan nilai besar cukup tinggi. Sebelum bermain, bandingkan kartu dengan keputusan terbaik dan tanyakan: apakah saya akan kalah trick atau membuang poin?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Высокая доля решений теряет значимую ожидаемую ценность. Перед ходом сравните карту с лучшим решением и спросите: потеряю ли я взятку или отдам очки впустую?" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararlarının önemli beklenen değer kaybettiren oranı yüksek. Kartı oynamadan önce en iyi kararla karşılaştır ve sor: eli mi kaybedeceğim, yoksa puanları boşa mı atacağım?" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے فیصلوں میں بڑے متوقع اثر کے ضائع ہونے کی شرح زیادہ ہے۔ پتا پھینکنے سے پہلے اسے بہترین فیصلے سے ملائیں اور پوچھیں: کیا میں اکلة ہاروں گا یا پوائنٹ ضائع کروں گا؟" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你有较多决策损失了大量预期价值。出牌前先和最佳决策比较，并问自己：我会输掉这一墩，还是白白送分？" } }
      }
    },
    "قراراتك قوية" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Entscheidungen sind stark" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decisions are strong" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus decisiones son fuertes" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos décisions sont solides" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके निर्णय मजबूत हैं" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Keputusan Anda kuat" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши решения сильные" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararların güçlü" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے فیصلے مضبوط ہیں" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的决策很强" } }
      }
    },
    "معظم اختياراتك مطابقة أو قريبة من تحليل الخبير. الخطوة التالية هي رفع الصعوبة أو مراجعة الفوارق الصغيرة بين أفضل وثاني أفضل قرار." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die meisten deiner Entscheidungen entsprechen der Expertenanalyse oder liegen nah daran. Der nächste Schritt ist eine höhere Schwierigkeit oder die Prüfung kleiner Unterschiede zwischen bester und zweitbester Entscheidung." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Most of your choices match or stay close to expert analysis. Next, raise the difficulty or review the small gaps between the best and second-best decisions." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La mayoría de tus elecciones coinciden o están cerca del análisis experto. Ahora sube la dificultad o revisa las pequeñas diferencias entre la mejor y la segunda mejor decisión." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La plupart de vos choix correspondent ou restent proches de l’analyse experte. Ensuite, augmentez la difficulté ou révisez les petits écarts entre le meilleur et le deuxième choix." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी अधिकतर पसंद विशेषज्ञ विश्लेषण से मेल खाती हैं या उसके करीब हैं। अगला कदम कठिनाई बढ़ाना या सर्वश्रेष्ठ और दूसरे सर्वश्रेष्ठ निर्णय के छोटे अंतर की समीक्षा करना है।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Sebagian besar pilihan Anda sesuai atau dekat dengan analisis pakar. Langkah berikutnya adalah menaikkan kesulitan atau meninjau selisih kecil antara keputusan terbaik dan terbaik kedua." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Большинство ваших выборов совпадают с экспертным анализом или близки к нему. Следующий шаг — повысить сложность или разобрать малые разницы между лучшим и вторым лучшим решением." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçimlerinin çoğu uzman analizine uyuyor veya çok yakın. Sonraki adım zorluğu artırmak ya da en iyi ve ikinci en iyi karar arasındaki küçük farkları incelemek." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے اکثر انتخاب ماہر تجزیے کے مطابق یا قریب ہیں۔ اگلا قدم مشکل بڑھانا یا بہترین اور دوسرے بہترین فیصلے کے چھوٹے فرق کا جائزہ لینا ہے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的多数选择符合或接近专家分析。下一步可以提高难度，或复盘最佳与第二佳决策之间的小差距。" } }
      }
    },
    "قراراتك متوسطة الجودة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Entscheidungsqualität ist gemischt" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision quality is mixed" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu calidad de decisión es mixta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La qualité de vos décisions est mitigée" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी निर्णय गुणवत्ता मिली-जुली है" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kualitas keputusan Anda campuran" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Качество ваших решений смешанное" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Karar kaliten karışık" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے فیصلوں کا معیار ملا جلا ہے" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的决策质量有好有坏" } }
      }
    },
    "لديك قرارات جيدة وأخرى تخسر قيمة. ركّز في التدريب القادم على تقليل الفاقد المتوقع لا على مطابقة ورقة الخبير فقط." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du hast gute Entscheidungen und andere mit Wertverlust. Konzentriere dich im nächsten Training darauf, erwarteten Verlust zu senken, nicht nur die Expertenkarte zu treffen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You have some good decisions and some that lose value. In the next session, focus on reducing expected loss, not only matching the expert card." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tienes decisiones buenas y otras que pierden valor. En el próximo entrenamiento, céntrate en reducir la pérdida esperada, no solo en igualar la carta experta." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous avez de bonnes décisions et d’autres qui perdent de la valeur. Au prochain entraînement, cherchez à réduire la perte attendue, pas seulement à imiter la carte experte." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके कुछ निर्णय अच्छे हैं और कुछ मूल्य खोते हैं। अगले अभ्यास में अपेक्षित नुकसान घटाने पर ध्यान दें, केवल विशेषज्ञ कार्ड मिलाने पर नहीं।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Anda punya keputusan baik dan beberapa yang kehilangan nilai. Di sesi berikutnya, fokuslah mengurangi kehilangan nilai, bukan hanya mencocokkan kartu pakar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У вас есть хорошие решения и решения с потерей ценности. В следующей тренировке сосредоточьтесь на снижении ожидаемой потери, а не только на совпадении с картой эксперта." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bazı kararların iyi, bazıları değer kaybettiriyor. Sonraki çalışmada yalnızca uzman kartını tutturmaya değil, beklenen kaybı azaltmaya odaklan." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "آپ کے کچھ فیصلے اچھے ہیں اور کچھ قدر کھوتے ہیں۔ اگلی مشق میں صرف ماہر کے پتے سے ملانے کے بجائے متوقع نقصان کم کرنے پر توجہ دیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你有一些好决策，也有一些会损失价值。下一次训练重点应是减少预期损失，而不只是匹配专家出牌。" } }
      }
    },
    "جودة قراراتك" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Qualität deiner Entscheidungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Decision quality" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Calidad de tus decisiones" } },
