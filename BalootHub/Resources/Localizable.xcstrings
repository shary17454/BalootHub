        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты чередуют сильные решения и дорогие ошибки — нужна более ровная тренировка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے نتائج مضبوط فیصلوں اور مہنگی غلطیوں کے بیچ ہیں؛ زیادہ مستقل مشق چاہیے۔"
