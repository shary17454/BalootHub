    "نسيان اختيار المضاعف الصحيح، أو حفظ صكة بأرقام فارغة أو سالبة — والأداة تمنع ذلك تلقائيًا." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgetting to choose the correct multiplier, or saving a round with empty or negative numbers — which the tool prevents automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublier le bon multiplicateur ou enregistrer une donne vide/négative — l'outil l'empêche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar el multiplicador correcto o guardar una mano vacía o negativa: la herramienta lo impide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den falschen Multiplikator wählen oder eine leere/negative Runde speichern – das Tool verhindert es."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru çarpanı seçmeyi unutmak ya da boş veya negatif sayılarla el kaydetmek — araç bunu otomatik engeller."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыть верный множитель или сохранить пустую/отрицательную раздачу — инструмент это блокирует."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درست ضرب چننا بھول جانا، یا خالی یا منفی اعداد کے ساتھ صکہ محفوظ کرنا — ٹول خودکار روکتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सही गुणक चुनना भूलना, या खाली या ऋणात्मक अंकों वाला हाथ सहेजना — उपकरण स्वतः रोकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa memilih pengganda yang benar, atau menyimpan ronde dengan angka kosong atau negatif — alat mencegahnya otomatis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记选择正确倍数，或保存空值/负值的一局——工具会自动阻止。"
          }
        }
      }
    },
    "نفس حزمة الـ32 ورقة، ويُختار نمط \"صن\" في مرحلة المزايدة بدل اختيار نوع حكم." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same 32-card deck, with \"Sun\" chosen during the bidding phase instead of picking a trump suit."
          }
        }
      }
    },
    "نفس مشاريع البلوت العامة قابلة للاتفاق عليها، باستثناء \"البلوت\" (شايب وبنت الحكم) لأنه لا يوجد نوع حكم في هذا النمط." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same general Baloot projects can be agreed on, except the \"Baloot\" (Jack and Queen of trump), since there is no trump suit in this mode."
          }
        }
      }
    },
    "نمط اللاعبين" : {
      "localizations" : {
