    "ابدأ بإعادة موقف" : {},
    "ابدأ أول موقف من نفس الخطة حتى يقيس المدرب الدقة والأثر من بيانات فعلية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start the first scenario of the same plan so the coach can measure accuracy and impact from real data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez la première situation du même plan pour mesurer précision et impact sur données réelles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza la primera situación del mismo plan para medir precisión e impacto con datos reales."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte die erste Situation desselben Plans, damit Genauigkeit und Wirkung real gemessen werden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenörün doğruluk ve etkiyi gerçek veriyle ölçmesi için aynı planın ilk durumunu başlat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни первую ситуацию того же плана, чтобы тренер измерил точность и влияние по реальным данным."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسی منصوبے کی پہلی صورتحال شروع کریں تاکہ کوچ حقیقی ڈیٹا سے درستگی اور اثر ناپے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसी योजना की पहली स्थिति शुरू करें ताकि कोच असली डेटा से सटीकता और प्रभाव माप सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai situasi pertama dari rencana yang sama agar pelatih mengukur akurasi dan dampak dari data nyata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始同一计划的第一个局面，让教练用真实数据衡量准确率与影响。"
          }
        }
      }
    },
