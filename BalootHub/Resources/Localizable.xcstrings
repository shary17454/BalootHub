    "تُستخدم حزمة ورق كاملة من 52 ورقة، وتُلعب عادة دورة من عدة جولات متتالية بأهداف مختلفة لكل جولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full 52-card deck is used, and a cycle of several consecutive rounds is usually played, each with a different objective."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On utilise un jeu complet de 52 cartes et un cycle de manches successives aux objectifs différents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa una baraja completa de 52 cartas y suele jugarse un ciclo de rondas con objetivos distintos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein volles 52-Karten-Deck; gespielt wird meist ein Zyklus aufeinanderfolgender Runden mit je eigenem Ziel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "52 kartlık tam deste kullanılır ve genelde her elin farklı amacı olan ardışık bir döngü oynanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется полная колода из 52 карт; обычно играют цикл раундов с разными целями."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "52 کارڈ کی مکمل گڈی استعمال ہوتی ہے، اور عموماً مختلف مقاصد والے پے در پے راؤنڈز کا ایک دور کھیلا جاتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "52 कार्ड की पूरी गड्डी उपयोग होती है, और आमतौर पर अलग-अलग उद्देश्यों वाले क्रमिक राउंड का चक्र खेला जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
