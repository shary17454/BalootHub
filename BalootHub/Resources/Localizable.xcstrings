            "state" : "translated",
            "value" : "Débloqué après 25 bonnes réponses au défi de calcul."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se logra tras 25 respuestas correctas en el reto de conteo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach 25 richtigen Antworten in der Rechen-Challenge erreicht."
          }
