    },
    "راجع بطاقة أثر كل قرار وابحث عن الفرق بين الأفضل وثاني أفضل." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the impact card for each decision and look for the gap between best and second best."
