    "خسارة الأكلة متكررة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trick losses are recurring"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pertes de plis se répètent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pérdidas de bazas se repiten"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stichverluste wiederholen sich"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El kayıpları tekrarlıyor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потери взяток повторяются"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہاتھ ہارنا بار بار ہو رہا ہے"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालें बार-बार हार रहे हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalahan trik berulang"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丢墩反复出现"
          }
        }
      }
    },
    "نصف قراراتك المفحوصة أو أكثر تنهي الأكلة للخصم. راجع اللون المطلوب والحكم قبل رمي ورقة عالية." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half or more of your tracked decisions give the trick to the opponent. Review the led suit and trump before playing a high card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié ou plus de vos coups donnent le pli à l'adversaire : vérifiez couleur et atout d'abord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad o más de tus decisiones dan la baza al rival; revisa palo pedido y triunfo antes de tirar alto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte oder mehr deiner Züge schenken den Stich – prüfe Farbe und Trumpf vor hohen Karten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İncelenen kararlarının yarısı ya da fazlası eli rakibe bırakıyor. Yüksek kart atmadan önce istenen sembolü ve kozu gözden geçir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Половина или больше твоих решений отдают взятку сопернику — сначала проверяй масть и козырь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے جانچے گئے نصف یا زیادہ فیصلے ہاتھ حریف کو دیتے ہیں۔ اونچا کارڈ پھینکنے سے پہلے مطلوبہ رنگ اور ترپ دیکھیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जाँचे गए आधे या अधिक निर्णय चाल विपक्ष को देते हैं। ऊँचा कार्ड फेंकने से पहले सूट व तुरुप देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setengah atau lebih keputusanmu menyerahkan trik ke lawan. Tinjau simbol yang diminta dan truf sebelum membuang kartu tinggi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你被记录的决策中有一半以上把墩送给了对手：出大牌前先看所需花色与将牌。"
          }
        }
      }
    },
    "تحسم الأكلات بثبات" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You finish tricks steadily"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous remportez les plis avec régularité"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierras las bazas con constancia"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest Stiche verlässlich"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elleri istikrarla alıyorsun"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты стабильно забираешь взятки"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ مستقل مزاجی سے ہاتھ جیتتے ہیں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप लगातार चालें जीतते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memenangi trik dengan konsisten"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你能稳定拿墩"
          }
        }
      }
    },
    "نصف قراراتك المفحوصة أو أكثر تكسب الأكلة لفريقك. ركز الآن على تقليل النقاط المتوقعة الضائعة عند البدائل القريبة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half or more of your tracked decisions win the trick for your team. Now focus on reducing expected points lost on close alternatives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié ou plus de vos coups gagnent le pli : réduisez maintenant la perte sur les alternatives serrées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad o más de tus decisiones ganan la baza; ahora reduce los puntos esperados perdidos en alternativas ajustadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte oder mehr deiner Züge gewinnt den Stich – reduziere nun Verluste bei knappen Alternativen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İncelenen kararlarının yarısı ya da fazlası eli takımına kazandırıyor. Şimdi yakın alternatiflerdeki beklenen puan kaybını azaltmaya odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Половина или больше твоих решений берут взятку — теперь снижай потери на близких альтернативах."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے جانچے گئے نصف یا زیادہ فیصلے ہاتھ آپ کی ٹیم کو دلاتے ہیں۔ اب قریبی متبادل میں ضائع متوقع پوائنٹس کم کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जाँचे गए आधे या अधिक निर्णय चाल आपकी टीम को दिलाते हैं। अब निकट विकल्पों में खोए अपेक्षित अंक घटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setengah atau lebih keputusanmu memenangkan trik untuk timmu. Kini fokus menekan poin harapan yang hilang pada alternatif berdekatan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你被记录的决策中有一半以上为自家拿墩：现在专注减少接近备选上损失的期望分。"
          }
        }
      }
    },
    "قراراتك تترك الأكلة مفتوحة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decisions leave tricks open"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos décisions laissent le pli ouvert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones dejan la baza abierta"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Entscheidungen lassen den Stich offen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararların eli açık bırakıyor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои решения оставляют взятку открытой"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے فیصلے ہاتھ کھلا چھوڑ دیتے ہیں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके निर्णय चाल खुली छोड़ देते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusanmu membiarkan trik terbuka"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的决策让这墩留有余地"
          }
        }
      }
    },
    "أغلب قراراتك لا تحسم الأكلة فورًا؛ تابع قراءة ردود الخصوم بعد ورقتك ولا تعتمد على أثر الورقة وحدها." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most of your decisions do not decide the trick immediately; keep reading opponents' replies after your card and do not rely on the card impact alone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos coups ne tranchent pas d'emblée : suivez les réponses adverses, pas seulement l'impact de la carte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones no cierran la baza al instante; sigue las respuestas rivales, no solo el impacto de la carta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Züge entscheiden nicht sofort – lies die Antworten der Gegner, nicht nur die Kartenwirkung."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlarının çoğu eli hemen bitirmiyor; kartından sonra rakiplerin yanıtlarını okumaya devam et, tek başına kart etkisine güvenme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои ходы не решают взятку сразу — читай ответы соперников, а не только эффект карты."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے اکثر فیصلے ہاتھ فوراً طے نہیں کرتے؛ اپنے کارڈ کے بعد حریفوں کے جواب پڑھتے رہیں، صرف کارڈ کے اثر پر نہ جائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अधिकतर निर्णय चाल तुरंत तय नहीं करते; अपने कार्ड के बाद विरोधियों की प्रतिक्रिया पढ़ें, केवल कार्ड प्रभाव पर न जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan keputusanmu tidak langsung menentukan trik; terus baca respons lawan setelah kartumu, jangan bergantung pada dampak kartu saja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的多数决策不会立刻定墩：继续读对手在你出牌后的应对，别只看这张牌本身的影响。"
          }
        }
      }
    },
    "نتائج قراراتك متوازنة" : {
      "localizations" : {
        "en" : {
