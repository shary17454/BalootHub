    "قراراتك قريبة من الخبير وتحقق أثرًا قويًا؛ انتقل لتحدٍ أصعب." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your decisions are close to the expert and deliver strong impact; move to a harder challenge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos décisions frôlent l'expert avec un fort impact : passez à plus difficile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones se acercan al experto con fuerte impacto; pasa a un reto más difícil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Entscheidungen sind nah am Experten und wirkungsstark – geh auf schwerer."
