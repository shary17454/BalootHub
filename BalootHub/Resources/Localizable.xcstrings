    "راجع القرار وتدرّب على قراءة الموقف." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the decision and practice reading the scenario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyez la décision et entraînez-vous à lire la situation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
