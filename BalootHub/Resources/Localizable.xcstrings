        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوبہ رنگ کی پیروی کریں اور ہاتھ جیتنے اور نقصان کم کرنے میں توازن رکھیں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माँगे गए सूट का पालन करें और चाल जीतने व नुक़सान घटाने में संतुलन रखें"
          }
        },
        "id" : {
          "stringUnit" : {
