    "تُستخدم حزمة من 32 ورقة (من 7 حتى الآس). يُحدَّد الموزّع الأول بالاتفاق أو بالقرعة، ثم يدور التوزيع بالتناوب." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 32-card deck is used (7 through Ace). The first dealer is chosen by agreement or by draw, then the deal rotates."
          }
        }
      }
    },
    "تُستخدم حزمة ورق عادية أو مختصرة حسب عرف اللاعبين قبل البدء." : {
      "extractionState" : "stale",
