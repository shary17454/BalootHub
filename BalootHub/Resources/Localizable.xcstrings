    "اضغط جاهز عندما يكون الجهاز مع اللاعب الحالي فقط." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe erst auf Bereit, wenn das Gerät beim aktuellen Spieler ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Ready only when the current player has the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Listo solo cuando el jugador actual tenga el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Prêt seulement quand le joueur actuel a l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तैयार तभी दबाएँ जब डिवाइस मौजूदा खिलाड़ी के पास हो."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Siap hanya saat perangkat berada pada pemain saat ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимайте Готово только когда устройство у текущего игрока."
