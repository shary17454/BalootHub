        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sesión para reducir decisiones costosas" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Session de réduction des décisions coûteuses" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "महंगे निर्णय घटाने का सत्र" } },
