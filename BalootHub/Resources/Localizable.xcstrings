    "مواقف وش تلعب" : {

    },
    "نتائج التدريب تشير إلى قراءة جيدة للمواقف. ارفع الصعوبة وراجع الفوارق الصغيرة بين أفضل وثاني أفضل ورقة." : {

    },
    "يحتاج مراجعة قرارات" : {

    },
    "اقرأ مواقف وش تلعب واختر نفس قرار الخبير." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lies Was spielst du?-Szenarien und wähle dieselbe Entscheidung wie der Experte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read What to Play scenarios and choose the same decision as the expert." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Lee escenarios de ¿Qué juegas? y elige la misma decisión que el experto." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lis les situations Que jouer ? et choisis la même décision que l'expert." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "क्या खेलें स्थितियाँ पढ़ें और विशेषज्ञ जैसा ही निर्णय चुनें।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Baca skenario Apa yang dimainkan? dan pilih keputusan yang sama seperti ahli." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разбирайте сценарии «Что сыграть?» и выбирайте то же решение, что и эксперт." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ne oynarsın? senaryolarını oku ve uzmanla aynı kararı seç." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "وش تلعب؟ کے مواقف پڑھیں اور ماہر جیسا فیصلہ چنیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阅读“该出什么？”局面，并选择与专家相同的决策。" } }
      }
    },
    "عين الخبير" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Expertenauge" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Expert Eye" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ojo experto" } },
