        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلی صورتحال میں ایک سوال سے شروع کریں: اگر ہاتھ حریف کا ہو تو کون سا کارڈ کم سے کم متوقع پوائنٹس کھوتا ہے؟"
