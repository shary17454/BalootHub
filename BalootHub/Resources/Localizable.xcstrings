    "لا يظهر ميل واضح لكسب أو خسارة الأكلة. استخدم مقارنة أفضل وثاني أفضل لتقليل الفوارق الصغيرة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No clear tendency toward winning or losing tricks appears. Use the best vs. second-best comparison to reduce small gaps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune tendance nette : comparez meilleur et deuxième pour réduire les petits écarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay tendencia clara; usa la comparación mejor/segundo mejor para reducir las brechas pequeñas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine klare Tendenz – nutze den Vergleich Bestes/Zweitbestes, um kleine Lücken zu schließen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eli kazanma ya da kaybetme yönünde net bir eğilim yok. Küçük farkları azaltmak için en iyi–ikinci karşılaştırmasını kullan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Явной тенденции нет — сравнивай лучший и второй, чтобы убрать мелкие разрывы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہاتھ جیتنے یا ہارنے کا واضح رجحان نہیں۔ چھوٹے فرق کم کرنے کے لیے بہترین اور دوسرے کا موازنہ کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चाल जीतने या हारने की स्पष्ट प्रवृत्ति नहीं। छोटे अंतर घटाने हेतु सर्वश्रेष्ठ–दूसरे की तुलना करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak ada kecenderungan jelas menang atau kalah trik. Gunakan perbandingan terbaik–kedua untuk menekan selisih kecil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有明显的赢墩或丢墩倾向：用最优/次优对比来缩小细微差距。"
          }
        }
      }
    },
