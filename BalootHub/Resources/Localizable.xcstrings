            "value" : "继续对比"
          }
        }
      }
    },
    "اختياراتك الأخيرة تخسر نقاطًا متوقعة؛ جرّب حفظ الورق العالي عندما لا تستطيع الفوز بالأكلة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent choices are losing expected points; try saving high cards when you cannot win the trick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos derniers choix coûtent des points : gardez les hautes cartes quand le pli est perdu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimas elecciones pierden puntos; guarda las cartas altas cuando no puedas ganar la baza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Wahlen kosten Punkte – spare hohe Karten, wenn der Stich verloren ist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son seçimlerin beklenen puan kaybettiriyor; eli alamayacağın zaman yüksek kartları saklamayı dene."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние выборы теряют очки — береги старшие карты, когда взятку не взять."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے حالیہ انتخابات متوقع پوائنٹس کھوتے ہیں؛ جب ہاتھ نہ جیت سکیں تو اونچے کارڈ بچائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हालिया चयन अपेक्षित अंक खोते हैं; जब चाल न जीत सकें तो ऊँचे कार्ड बचाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan terkinimu kehilangan poin harapan; coba simpan kartu tinggi saat tak bisa menang trik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的选择在丢期望分：拿不下这墩时，试着保留大牌。"
          }
        }
      }
    },
    "بعد كل إجابة راجع بطاقة أثر كل قرار؛ الفرق بين اختيارك والخيار الثاني يعلمك متى تكون المخاطرة مقبولة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After each answer, review the impact card; the gap between your choice and the second option teaches when risk is acceptable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque réponse, lisez la fiche d'impact : l'écart avec le second vous dit quand risquer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cada respuesta, revisa la ficha de impacto; la diferencia con la segunda te enseña cuándo arriesgar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies nach jeder Antwort die Wirkungskarte – der Abstand zur zweiten zeigt, wann Risiko passt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her cevaptan sonra karar etki kartını incele; seçiminle ikinci seçenek arasındaki fark, riskin ne zaman kabul edilebilir olduğunu öğretir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После каждого ответа смотри карточку влияния — разрыв со вторым покажет, когда риск оправдан."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر جواب کے بعد فیصلے کا اثر کارڈ دیکھیں؛ آپ کے انتخاب اور دوسرے اختیار کا فرق بتاتا ہے کہ خطرہ کب قابلِ قبول ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर उत्तर के बाद प्रभाव कार्ड देखें; आपके चयन और दूसरे विकल्प का अंतर सिखाता है कि जोखिम कब उचित है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah tiap jawaban, tinjau kartu dampak; selisih pilihanmu dengan opsi kedua mengajarkan kapan risiko layak diambil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次作答后查看影响卡：你与次优之间的差距会告诉你何时值得冒险。"
          }
        }
      }
    },
    "صفِّ الخيارات أولًا" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtere zuerst die Optionen"
