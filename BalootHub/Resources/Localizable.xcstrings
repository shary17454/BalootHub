    "الفوز بأكبر عدد من نقاط الأوراق خلال الجولة دون وجود نوع حكم يفضَّل على البقية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win the most card points during the round, with no trump suit favored over the others."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remporter le plus de points de cartes sans qu'aucune couleur ne soit atout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganar la mayor cantidad de puntos de cartas sin que ningún palo sea triunfo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Kartenpunkte gewinnen, ohne dass eine Farbe Trumpf ist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir sembol koz sayılmadan el boyunca en çok kart puanını kazanmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набрать больше всего очков карт, когда ни одна масть не козырь."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راؤنڈ میں سب سے زیادہ کارڈ پوائنٹس جیتنا جب کوئی رنگ ترپ نہ ہو۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड में सर्वाधिक कार्ड अंक जीतना जब कोई सूट तुरुप न हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memenangi poin kartu terbanyak dalam ronde tanpa ada simbol yang jadi truf."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在没有任何花色为将的情况下，赢得本局最多的牌分。"
          }
        }
      }
    },
