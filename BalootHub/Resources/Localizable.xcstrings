    "كل ألعاب البلوت وأدواتها وألعاب الورق المفضّلة في مكان واحد": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your favorite Baloot games, tools, and card games in one place"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos jeux de Baloot, outils et jeux de cartes préférés au même endroit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus juegos de Baloot, herramientas y juegos de cartas favoritos en un solo lugar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "All deine liebsten Baloot-Spiele, Werkzeuge und Kartenspiele an einem Ort"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm favori Baloot oyunlarınız, araçlarınız ve kart oyunlarınız tek bir yerde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши любимые игры Балут, инструменты и карточные игры в одном месте"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تمام پسندیدہ بلوت گیمز، ٹُولز اور کارڈ گیمز ایک ہی جگہ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सभी पसंदीदा बलूत गेम, टूल और कार्ड गेम एक ही जगह"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua permainan Baloot, alat, dan permainan kartu favorit Anda dalam satu tempat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你喜爱的所有巴鲁特游戏、工具和纸牌游戏，尽在一处"
          }
        }
      }
    },
