    "تنتهي الجولة بانتهاء الأوراق، وتُعلن النتيجة بحسب الصيغة المعتمدة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when the cards run out, and the result is declared according to the format used."
          }
        }
      }
    },
    "تنتهي الجولة بانتهاء كل الأوراق (13 أكلة)، وتُحدَّث النتيجة التراكمية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when all the cards are played (13 tricks), and the running total is updated."
          }
        }
      }
    },
    "تنتهي الجولة بخلوّ يد أحد اللاعبين من الأوراق أو باستنفاد الحزمة الاحتياطية." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends when one player's hand is empty or the draw pile is exhausted."
          }
        }
      }
    },
    "تنتهي الجولة بعد الأكلات الثماني، وتُحتسب نقاط كل فريق وتُضاف إلى إجمالي الجلسة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends after the eight tricks, and each team's points are counted and added to the session total."
          }
        }
      }
    },
    "تنتهي الجولة بعد لعب الأكلات الثماني وتُجمع النقاط لكل فريق." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends after the eight tricks are played and each team's points are added up."
          }
        }
      }
    },
    "تنتهي الجولة بعد لعب كل الأوراق الثماني (8 أكلات)، ثم تُحسب النقاط ويبدأ توزيع جديد حتى يبلغ أحد الفريقين الهدف." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends after all eight cards are played (8 tricks), then the points are counted and a new deal begins until one team reaches the target."
          }
        }
      }
    },
    "تنتهي الجولة كالمعتاد بعد الأكلات الثماني مع إضافة قيمة المشاريع الصحيحة للنتيجة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends as usual after the eight tricks, with the value of any valid projects added to the result."
          }
        }
      }
    },
    "تنتهي الجولة كالمعتاد بعد الأكلات الثماني، وتُطبَّق المضاعفة على النتيجة النهائية قبل إضافتها لإجمالي الجلسة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The round ends as usual after the eight tricks, and the multiplier is applied to the final result before it is added to the session total."
          }
        }
      }
    },
    "تنتهي كل جولة فرعية بانتهاء الأوراق، وتنتهي الدورة الكاملة بعد لعب كل أنماط الجولات المتفق عليها." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each sub-round ends when its cards run out, and the full cycle ends after all the agreed round types have been played."
          }
        }
      }
    },
    "تُوزَّع الأوراق بالتساوي على اللاعبين في بداية كل جولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cards are dealt evenly among the players at the start of each round."
          }
        }
      }
    },
    "تُوزَّع الأوراق حسب عدد اللاعبين، وتُترك بقية الحزمة كسحب احتياطي إن كانت الصيغة تسمح بذلك." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards are dealt according to the number of players, with the rest of the deck left as a draw pile if the format allows it."
          }
        }
      }
    },
    "تُوزَّع كل الأوراق على اللاعبين الأربعة بالتساوي (13 ورقة لكل لاعب) في بداية كل جولة من الدورة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All cards are dealt evenly among the four players (13 cards each) at the start of each round in the cycle."
          }
        }
      }
    },
    "تُوزَّع كل الأوراق على اللاعبين الأربعة بالتساوي (13 ورقة لكل لاعب)." : {
      "extractionState" : "stale",
