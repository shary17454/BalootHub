        "en" : { "stringUnit" : { "state" : "translated", "value" : "Gap between best and second" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Diferencia entre la mejor y la segunda" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écart entre la meilleure et la deuxième" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सर्वश्रेष्ठ और दूसरे के बीच अंतर" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Selisih antara terbaik dan kedua" } },
