        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tur tamamlanınca kayıp" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "راؤنڈ مکمل ہونے کے بعد نقصان" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打完整局后的损失" } }
      }
    },
    "راجع كيف تغيّر القرار نتيجة الجولة لا الأكلة فقط." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe, wie sich die Entscheidung auf die ganze Runde auswirkte, nicht nur auf den Stich." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review how the decision changed the round result, not only the trick." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa cómo cambió el resultado de la ronda, no solo la baza." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revoyez comment la décision a changé la manche, pas seulement le pli." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "देखें कि फैसले ने पूरी राउंड को कैसे बदला, सिर्फ बाज़ी को नहीं।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tinjau bagaimana keputusan mengubah hasil ronde, bukan hanya trik." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разберите, как решение изменило раунд, а не только взятку." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kararın yalnızca eli değil, tur sonucunu nasıl değiştirdiğini incele." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "دیکھیں فیصلے نے صرف چال نہیں بلکہ راؤنڈ کا نتیجہ کیسے بدلا۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复盘这个决定如何改变整局结果，而不只是这一墩。" } }
      }
    },
    "سبب الترشيح من المحاكاة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Empfehlungsgrund aus der Simulation" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Simulation reason for recommendation" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Motivo de recomendación por simulación" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Raison de recommandation par simulation" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिमुलेशन से सिफारिश का कारण" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Alasan rekomendasi dari simulasi" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Причина рекомендации по симуляции" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Simülasyona göre öneri nedeni" } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "سیمولیشن سے سفارش کی وجہ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模拟给出推荐的原因" } }
      }
    },
    "نقطة ضاعت بعد استكمال الجولة." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Punkte gingen nach ausgespielter Runde verloren." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "points were lost after completing the round." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "puntos se perdieron tras completar la ronda." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "points ont été perdus après la manche complète." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "राउंड पूरा होने के बाद अंक खोए।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "poin hilang setelah ronde selesai." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "очков потеряно после доигрывания раунда." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "puan tur tamamlandıktan sonra kaybedildi." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "پوائنٹس راؤنڈ مکمل ہونے کے بعد ضائع ہوئے۔" } },
