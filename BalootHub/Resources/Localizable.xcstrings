        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılan sıralama, döngü içindeki el türüne göre değişir (bazı eller kart gücüne değil, belirli kartlardan kaçınmaya dayanır)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок зависит от типа раунда (в некоторых важна не сила карт, а избегание определённых)."
