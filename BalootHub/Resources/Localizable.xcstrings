    "الحجب بحذف الأوراق من اللقطة لا بإخفائها بصريًا، فلا تُسرَّب عبر أي قناة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards are removed from the snapshot rather than hidden visually, so nothing leaks through any channel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes sont retirées de l'instantané au lieu d'être masquées : rien ne fuit par aucun canal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cartas se eliminan de la instantánea en vez de ocultarse visualmente, así nada se filtra por ningún canal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten werden aus dem Snapshot entfernt statt nur optisch verborgen – nichts gelangt über einen Kanal nach außen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartlar görsel olarak gizlenmek yerine anlık görüntüden silinir; hiçbir kanaldan sızmaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карты удаляются из снимка, а не скрываются визуально, поэтому ничего не утекает ни по одному каналу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ بصری طور پر چھپانے کے بجائے اسنیپ شاٹ سے حذف ہوتے ہیں، سو کسی چینل سے کچھ نہیں رستا۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड दृश्य रूप से छिपाने के बजाय स्नैपशॉट से हटाए जाते हैं, इसलिए किसी चैनल से कुछ लीक नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu dihapus dari snapshot, bukan sekadar disembunyikan, sehingga tak ada yang bocor lewat kanal mana pun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手牌是从快照中删除而非仅视觉隐藏，因此不会经任何通道泄露。"
          }
        }
      }
    },
