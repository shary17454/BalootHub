        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Perte après la fin de la manche" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "राउंड पूरा होने पर नुकसान" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kalah setelah ronde selesai" } },
