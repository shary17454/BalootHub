            "value" : "مہنگی غلطیاں"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महँगी ग़लतियाँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan mahal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代价高的失误"
          }
        }
      }
    },
    "معظم الأخطاء الأخيرة خفضت الأثر المتوقع؛ توقف قبل اللعب واسأل: هل أحمي النقاط أم أرمي ورقة رابحة؟" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most recent mistakes lowered expected impact; pause before playing and ask: am I protecting points or throwing away a winning card?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos erreurs récentes baissent l'impact : avant de jouer, demandez-vous — protéger ou gagner ?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus errores recientes bajan el impacto; antes de jugar pregúntate: ¿protejo puntos o tiro una carta ganadora?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fehler senken die Wirkung – frag dich vorher: Punkte schützen oder Gewinnkarte wegwerfen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son hataların beklenen etkiyi düşürdü; oynamadan önce sor: puanı mı koruyorum, kazandıran kartı mı atıyorum?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние ошибки снижают влияние — спроси себя: защищаю очки или выбрасываю выигрышную карту?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالیہ غلطیوں نے متوقع اثر کم کیا؛ کھیلنے سے پہلے پوچھیں: پوائنٹس بچا رہا ہوں یا جیتنے والا کارڈ پھینک رہا ہوں؟"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हालिया ग़लतियों ने अपेक्षित प्रभाव घटाया; खेलने से पहले पूछें: अंक बचा रहा हूँ या जीतने वाला कार्ड फेंक रहा हूँ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan terkini menurunkan dampak harapan; berhenti sejenak dan tanya: melindungi poin atau membuang kartu pemenang?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期失误拉低了期望影响：出牌前先问自己——我是在护分，还是在丢掉一张制胜牌？"
          }
        }
      }
    },
    "أخطاء عند التلزيم" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler beim Bedienen der Farbe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow-suit mistakes"
          }
        },
