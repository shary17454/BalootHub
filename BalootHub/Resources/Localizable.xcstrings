    "اختياراتك قريبة من الخبير" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices are close to the expert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos choix sont proches de l'expert"
          }
        },
        "es" : {
          "stringUnit" : {
