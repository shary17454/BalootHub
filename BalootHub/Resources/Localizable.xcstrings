          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreurs en suivant la couleur"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूट फ़ॉलो करने में गलतियाँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan mengikuti suit"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибки при следовании масти"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk takip hataları"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ فالو کرنے کی غلطیاں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟花失误"
          }
        }
      }
    },
    "تكررت أخطاء مكلفة عندما كان على الطاولة لون مطلوب. قبل اختيار الورقة، احصر أوراق اللون أولًا ثم قارن هل تلعب للحماية أو لتخفيف الخسارة." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teure Fehler traten wiederholt auf, wenn eine Farbe bedient werden musste. Prüfe vor der Karte zuerst alle Karten dieser Farbe und entscheide dann, ob du schützt oder den Verlust verringerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costly mistakes repeated when there was a required suit on the table. Before choosing, isolate that suit first, then compare whether to protect or reduce the loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los errores costosos se repitieron cuando había un palo obligatorio en la mesa. Antes de elegir, separa primero esas cartas y compara si conviene proteger o reducir la pérdida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les erreurs coûteuses se répètent quand une couleur demandée est sur la table. Avant de choisir, isole d'abord cette couleur, puis compare s'il faut protéger ou limiter la perte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब टेबल पर आवश्यक सूट था तब महंगी गलतियाँ दोहराईं। पत्ती चुनने से पहले उसी सूट की पत्तियाँ अलग करें, फिर तुलना करें कि बचाना है या नुकसान घटाना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan mahal berulang saat ada suit wajib di meja. Sebelum memilih kartu, pisahkan suit itu dulu, lalu bandingkan apakah perlu melindungi atau mengurangi kerugian."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дорогие ошибки повторялись, когда на столе была обязательная масть. Перед выбором сначала отделите карты этой масти, затем решите: защищать очки или снижать потерю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masada takip edilmesi gereken renk varken maliyetli hatalar tekrarlandı. Kart seçmeden önce o rengi ayır, sonra korumak mı yoksa kaybı azaltmak mı gerektiğini karşılaştır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب میز پر لازمی رنگ تھا تو مہنگی غلطیاں دہرائیں۔ پتا چننے سے پہلے اسی رنگ کے پتے الگ کریں، پھر دیکھیں کہ حفاظت کرنی ہے یا نقصان کم کرنا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当桌上有必须跟的花色时，昂贵失误反复出现。选牌前先把该花色筛出，再比较是保护分数还是减少损失。"
          }
        }
      }
    },
    "ضغط الحكم يربك قرارك" : {
      "localizations" : {
