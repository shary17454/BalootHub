        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренируй тот же уровень короткой серией, пока решения не станут стабильнее."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے فیصلے مستحکم ہونے تک وہی سطح مختصر بیچ میں مشق کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने निर्णय स्थिर होने तक वही स्तर छोटे बैच में अभ्यास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latih level yang sama dalam batch singkat sampai keputusanmu lebih stabil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
