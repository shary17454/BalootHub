    "جولة قابلة لإعادة البناء من الأفعال" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A round rebuildable from its actions"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une manche reconstructible depuis ses actions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ronda reconstruible desde sus acciones"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine aus Aktionen rekonstruierbare Runde"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylemlerinden yeniden kurulabilen bir el"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раунд, восстановимый из действий"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعمال سے دوبارہ بننے والا راؤنڈ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रियाओं से पुनर्निर्मित राउंड"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde yang bisa dibangun ulang dari aksinya"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可由动作重建的一局"
          }
        }
      }
    },
    "كل ما يغيّر الجولة يمر عبر GameAction ويُسجَّل، فتُعاد الحالة من السجل بلا فرق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything that changes the round goes through GameAction and is recorded, so the state replays identically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui modifie la manche passe par GameAction et est enregistré : l'état se rejoue à l'identique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que cambia la ronda pasa por GameAction y queda registrado, así el estado se reproduce igual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was die Runde ändert, läuft über GameAction und wird protokolliert – der Zustand lässt sich identisch wiedergeben."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eli değiştiren her şey GameAction üzerinden geçer ve kaydedilir; durum birebir yeniden oynatılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что меняет раунд, проходит через GameAction и записывается, поэтому состояние воспроизводится идентично."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راؤنڈ کو بدلنے والی ہر چیز GameAction سے گزرتی اور محفوظ ہوتی ہے، سو حالت ہوبہو دوبارہ بنتی ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राउंड बदलने वाली हर चीज़ GameAction से गुज़रती और दर्ज होती है, इसलिए स्थिति हूबहू दोहराई जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua yang mengubah ronde melewati GameAction dan tercatat, sehingga status diputar ulang persis sama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何改变牌局的操作都经由 GameAction 并被记录，因此状态可原样重放。"
          }
        }
      }
    },
    "توزيع حتمي ببذرة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deterministic seeded deal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribution déterministe par graine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparto determinista con semilla"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deterministisches Geben per Seed"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohumlu belirlenimci dağıtım"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детерминированная раздача по сиду"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیڈ سے متعین تقسیم"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीड आधारित नियतात्मक बाँट"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembagian deterministik dengan seed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于种子的确定性发牌"
          }
        }
      }
    },
    "نفس البذرة تعطي نفس التوزيع على أي جهاز، وهو شرط مزامنة أي جولة مشتركة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same seed deals the same cards on any device — a prerequisite for syncing a shared round."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même graine donne la même donne sur tout appareil : condition pour synchroniser une manche partagée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma semilla reparte igual en cualquier dispositivo: requisito para sincronizar una ronda compartida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derselbe Seed gibt auf jedem Gerät dieselben Karten – Voraussetzung für eine synchronisierte Runde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı tohum her cihazda aynı dağıtımı verir; paylaşılan bir eli senkronlamanın ön koşuludur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один и тот же сид даёт одинаковую раздачу на любом устройстве — условие синхронизации общего раунда."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی سیڈ ہر آلے پر ایک جیسی تقسیم دیتی ہے؛ مشترکہ راؤنڈ کی ہم آہنگی کی شرط۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही सीड हर डिवाइस पर एक जैसी बाँट देती है — साझा राउंड के सिंक की शर्त।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seed yang sama membagi kartu sama di perangkat mana pun — syarat sinkronisasi ronde bersama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一种子在任何设备上发出相同的牌 —— 同步共享牌局的前提。"
          }
        }
      }
    },
    "طبقة نقل مجرّدة" : {
      "localizations" : {
