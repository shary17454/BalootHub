    "لا ترفع الصعوبة حتى تنخفض القرارات المكلفة" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe die Schwierigkeit erst, wenn kostspielige Entscheidungen sinken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not raise difficulty until costly decisions drop"
