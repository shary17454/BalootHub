    "لا يجمع التطبيق أي بيانات شخصية، ولا يحتاج اتصالًا بالإنترنت. كل البيانات تُخزَّن محليًا على جهازك فقط.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app doesn't collect any personal data and doesn't need an internet connection. All data is stored locally on your device only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne collecte aucune donnée personnelle et ne nécessite pas de connexion Internet. Toutes les données sont stockées localement sur votre appareil uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no recopila ningún dato personal ni necesita conexión a Internet. Todos los datos se guardan localmente solo en tu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erfasst keine personenbezogenen Daten und benötigt keine Internetverbindung. Alle Daten werden nur lokal auf deinem Gerät gespeichert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hiçbir kişisel veri toplamaz ve internet bağlantısı gerektirmez. Tüm veriler yalnızca cihazınızda yerel olarak saklanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не собирает никаких персональных данных и не требует подключения к интернету. Все данные хранятся только локально на вашем устройстве."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کوئی ذاتی ڈیٹا جمع نہیں کرتی اور نہ ہی اسے انٹرنیٹ کنکشن کی ضرورت ہے۔ تمام ڈیٹا صرف آپ کے آلے پر مقامی طور پر محفوظ ہوتا ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप कोई व्यक्तिगत डेटा एकत्र नहीं करता और न ही इसे इंटरनेट कनेक्शन की आवश्यकता है। सारा डेटा केवल आपके डिवाइस पर स्थानीय रूप से संग्रहीत होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak mengumpulkan data pribadi apa pun dan tidak memerlukan koneksi internet. Semua data disimpan secara lokal hanya di perangkat Anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不收集任何个人数据，也不需要联网。所有数据仅存储在你的设备本地。"
          }
        }
      }
    },
    "لا يمكن أن تكون نقاط المشاريع سالبة.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project points cannot be negative."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points de projets ne peuvent pas être négatifs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos de proyectos no pueden ser negativos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektpunkte dürfen nicht negativ sein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje puanları negatif olamaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очки проектов не могут быть отрицательными."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروجیکٹ پوائنٹس منفی نہیں ہو سکتے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट अंक ऋणात्मक नहीं हो सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Poin proyek tidak boleh negatif."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目分数不能为负数。"
          }
        }
      }
    },
    "لا يمكن حفظ صكة فارغة بدون أي نقاط.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't save an empty round with no points."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer une manche vide sans aucun point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede guardar una ronda vacía sin puntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine leere Runde ohne Punkte kann nicht gesichert werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanı olmayan boş bir el kaydedilemez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя сохранить пустой раунд без очков."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر کسی پوائنٹ کے خالی راؤنڈ محفوظ نہیں کیا جا سکتا۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना किसी अंक के खाली राउंड सहेजा नहीं जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde kosong tanpa poin tidak dapat disimpan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储没有任何分数的空局。"
          }
        }
      }
    },
    "لا يمكن لعب هذه الورقة الآن": {
      "localizations": {
