        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这一墩分数" } }
      }
    },
    "نقاط الورقة" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kartenpunkte" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Card points" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Puntos de la carta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Points de la carte" } },
