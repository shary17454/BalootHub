        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игроки ходят по очереди, избегая или собирая штрафные и премиальные карты по правилам компании."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھلاڑی باری باری کھیلتے ہیں، مجلس کے اصولوں کے مطابق منفی یا مثبت اثر والے کارڈ سے بچتے یا جمع کرتے ہوئے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
