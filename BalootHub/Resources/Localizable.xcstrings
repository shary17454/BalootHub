    "ابدأ بمواقف أسهل وركز على اللون المطلوب والحكم قبل التفكير في المخاطرة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with easier scenarios and focus on the led suit and trump before thinking about risk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez plus facile : couleur demandée et atout avant toute prise de risque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza más fácil y céntrate en el palo pedido y el triunfo antes de arriesgar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang leichter an – geforderte Farbe und Trumpf vor jedem Risiko."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha kolay durumlarla başla; risk düşünmeden önce istenen sembole ve koza odaklan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни с лёгкого: сначала затребованная масть и козырь, потом риск."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آسان صورتحال سے شروع کریں اور خطرہ سوچنے سے پہلے مطلوبہ رنگ اور ترپ پر توجہ دیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आसान स्थितियों से शुरू करें और जोखिम सोचने से पहले माँगा गया सूट व तुरुप देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari situasi lebih mudah dan fokus pada simbol yang diminta serta truf sebelum ambil risiko."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从更简单的局面开始：先看所需花色与将牌，再考虑冒险。"
          }
        }
      }
    },
    "آخر أداء" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent performance"
          }
        }
      }
    },
    "آخر محاولاتك أفضل من السابق؛ استمر على نفس الصعوبة أو ارفعها إذا ثبتت الدقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent attempts are better than before; keep the same difficulty or raise it if accuracy stays steady."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dernières tentatives progressent : restez au même niveau ou montez si la précision tient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimos intentos mejoran; mantén el nivel o súbelo si la precisión se sostiene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Versuche sind besser – bleib auf der Stufe oder steigere bei stabiler Genauigkeit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son denemelerin öncekinden iyi; aynı zorlukta kal ya da doğruluk oturursa artır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние попытки лучше — оставайся на уровне или повышай при стабильной точности."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی حالیہ کوششیں پہلے سے بہتر ہیں؛ اسی دشواری پر رہیں یا درستگی مستحکم ہو تو بڑھائیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके हालिया प्रयास पहले से बेहतर हैं; उसी कठिनाई पर रहें या सटीकता स्थिर हो तो बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percobaan terkinimu lebih baik; tetap di kesulitan sama atau naikkan bila akurasi stabil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的尝试有进步：维持当前难度，若准确率稳定可提升。"
          }
        }
      }
    },
    "أداؤك الأخير انخفض؛ خذ وقتك في قراءة اللون المطلوب والحكم قبل اختيار الورقة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent performance declined; take time to read the led suit and trump before choosing a card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos résultats baissent : prenez le temps de lire couleur demandée et atout avant de choisir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rendimiento bajó; tómate tiempo para leer el palo pedido y el triunfo antes de elegir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Leistung sank – nimm dir Zeit für geforderte Farbe und Trumpf vor der Wahl."
