          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ ہاتھ پڑھ کر مستقل طور پر جیتنے والا یا کم نقصان والا کارڈ چنتے ہیں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप चाल पढ़कर लगातार जीतने वाला या कम नुक़सान वाला कार्ड चुनते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
