    "دفعة واحدة تملك بها اللعبة للأبد": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One payment, yours forever"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement, à vous pour toujours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago, tuyo para siempre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen, für immer deins"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek ödeme, sonsuza dek sizin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж — ваше навсегда"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار ادائیگی، ہمیشہ کے لیے آپ کی"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार भुगतान, हमेशा के लिए आपका"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali bayar, milik Anda selamanya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付费，永久拥有"
          }
        }
      }
    },
    "دفعة واحدة فقط، بلا اشتراكات وبلا إعلانات إطلاقًا": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single one-time payment — no subscriptions, no ads at all"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement unique — sans abonnement et sans aucune publicité"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único pago — sin suscripciones y sin anuncios"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine einmalige Zahlung — keine Abos, überhaupt keine Werbung"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tek seferlik ödeme — abonelik yok, hiç reklam yok"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единоразовый платёж — без подписок и совсем без рекламы"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ایک بار کی ادائیگی — کوئی سبسکرپشن نہیں، کوئی اشتہار نہیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक बार का भुगतान — कोई सदस्यता नहीं, कोई विज्ञापन नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya sekali bayar — tanpa langganan, tanpa iklan sama sekali"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅需一次性付费——没有订阅，完全没有广告"
          }
        }
      }
    },
