    "بعد اختيار نمط الجولة (صن أو حكم)، يجوز لأي فريق أن \"يدبل\" ليضاعف قيمة الجولة، ويجوز للفريق الآخر الرد بمضاعفة أعلى (ثري ثم فور)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the round mode is chosen (Sun or Hokum), either team may \"double\" to multiply the round's value, and the other team may answer with a higher multiplier (Triple, then Quadruple)."
          }
        }
      }
    },
    "بعد التوزيع، يفحص كل لاعب يده بحثًا عن مشاريع محتملة قبل أن تبدأ الأكلات." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the deal, each player checks their hand for possible projects before the tricks begin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la donne, chacun cherche d'éventuels projets avant le premier pli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el reparto, cada jugador busca posibles proyectos antes de la primera baza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Geben prüft jeder seine Hand auf mögliche Projekte vor dem ersten Stich."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dağıtımdan sonra her oyuncu eller başlamadan önce elinde olası projeleri arar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После раздачи каждый ищет в руке возможные проекты до первой взятки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقسیم کے بعد ہر کھلاڑی پہلے ہاتھ سے قبل ممکنہ پروجیکٹس ڈھونڈتا ہے۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाँट के बाद हर खिलाड़ी पहली चाल से पहले संभावित प्रोजेक्ट खोजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah pembagian, tiap pemain memeriksa tangannya untuk proyek sebelum trik dimulai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发牌后，每位玩家在开打前先查看手牌是否有项目。"
          }
        }
      }
    },
    "بعد كل صكة، أدخل نوعها (صن أو حكم)، نقاط كل فريق، المشاريع، والمضاعف (دبل/ثري/فور/قهوة إن كانت مفعّلة)، ثم احفظ الجولة." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After each round, enter its type (Sun or Hokum), each team's points, the projects, and the multiplier (Double/Triple/Quadruple/Coffee if enabled), then save the round."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque donne, saisissez le type (Sun/Hokum), les points, les projets et le multiplicateur, puis enregistrez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cada mano, introduce el tipo (Sun u Hokum), los puntos, los proyectos y el multiplicador, y guarda la ronda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jeder Runde Typ (Sun/Hokum), Punkte, Projekte und Multiplikator eintragen und speichern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her elden sonra türünü (Sun ya da Hokum), her takımın puanını, projeleri ve çarpanı (Double/Triple/Quadruple/Coffee etkinse) gir ve eli kaydet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После каждой раздачи введи тип (Sun или Hokum), очки, проекты и множитель, затем сохрани раунд."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر صکہ کے بعد اس کی قسم (Sun یا Hokum)، ہر ٹیم کے پوائنٹس، پروجیکٹس اور ضرب (ڈبل/تھری/فور/Coffee اگر فعال) درج کر کے راؤنڈ محفوظ کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हाथ के बाद उसका प्रकार (Sun या Hokum), हर टीम के अंक, प्रोजेक्ट और गुणक (डबल/ट्रिपल/फोर/Coffee यदि सक्षम) दर्ज कर राउंड सहेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah tiap ronde, masukkan jenisnya (Sun atau Hokum), poin tiap tim, proyek, dan pengganda (Double/Triple/Quadruple/Coffee bila aktif), lalu simpan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每局结束后录入类型（Sun 或 Hokum）、各队分数、项目与倍数（如启用 Double/Triple/Quadruple/Coffee），然后保存该局。"
          }
        }
      }
    },
