        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عام پروجیکٹس کی قیمتیں خلاصہ کرتی ہے اور بتاتی ہے کہ یہ مجالس میں مختلف ہو سکتی ہیں۔"
