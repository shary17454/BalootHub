    "إتقان طريقة جمع نقاط الأوراق والمشاريع والمضاعفات يدويًا دون أخطاء." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Master adding up card points, projects, and multipliers by hand without mistakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maîtriser l'addition manuelle des points, projets et multiplicateurs sans erreur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dominar la suma manual de puntos, proyectos y multiplicadores sin errores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten-, Projekt- und Multiplikatorpunkte fehlerfrei von Hand addieren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart, proje ve çarpan puanlarını elle hatasız toplamayı ustalaşmak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освоить ручной подсчёт очков карт, проектов и множителей без ошибок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ، پروجیکٹ اور ضربات کے پوائنٹس بلا غلطی ہاتھ سے جمع کرنے میں مہارت۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड, प्रोजेक्ट और गुणक अंकों को बिना ग़लती हाथ से जोड़ने में महारत।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menguasai penjumlahan manual poin kartu, proyek, dan pengganda tanpa salah."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熟练手算牌分、项目分与加倍且不出错。"
          }
        }
      }
    },
