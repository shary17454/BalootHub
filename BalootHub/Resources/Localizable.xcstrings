    "نتائجك بين قرارات قوية وأخطاء مؤثرة؛ تحتاج نمط تدريب أكثر ثباتًا." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your results alternate between strong decisions and costly mistakes; you need steadier practice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos résultats alternent bons coups et erreurs coûteuses : entraînez-vous plus régulièrement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus resultados alternan decisiones fuertes y errores costosos; necesitas práctica más constante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ergebnisse schwanken zwischen starken Zügen und teuren Fehlern – übe gleichmäßiger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
