            "value" : "El impacto baja la nota"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wirkung senkt die Note"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etki notu düşürüyor"
          }
        },
        "ru" : {
          "stringUnit" : {
