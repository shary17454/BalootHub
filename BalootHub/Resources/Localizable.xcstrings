    "لا توجد أوراق تكوّن هذا المشروع في يد اللاعب المختار حسب القواعد الحالية." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Hand des gewählten Spielers enthält nach den aktuellen Regeln keine Karten für dieses Projekt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected player's hand has no cards that form this project under the current rules." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La mano del jugador elegido no tiene cartas que formen este proyecto según las reglas actuales." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La main du joueur choisi ne contient pas de cartes formant ce projet avec les règles actuelles." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मौजूदा नियमों के अनुसार चुने गए खिलाड़ी के हाथ में इस प्रोजेक्ट को बनाने वाली कार्ड नहीं हैं." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Kartu pemain yang dipilih tidak membentuk proyek ini menurut aturan saat ini." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В руке выбранного игрока нет карт, образующих этот проект по текущим правилам." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçilen oyuncunun elinde geçerli kurallara göre bu projeyi oluşturan kart yok." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "موجودہ قواعد کے مطابق منتخب کھلاڑی کے ہاتھ میں اس پروجیکٹ کی کارڈز موجود نہیں۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按当前规则，所选玩家手牌中没有可组成该项目的牌。" } }
      }
    },
