        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درستگی اور فیصلے کے اثر کو ملانے والا درجہ دیکھنے کے لیے سیشن شروع کریں۔"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीकता और निर्णय प्रभाव मिलाकर ग्रेड देखने हेतु सत्र शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
