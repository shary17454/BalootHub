    "يتحقق عند مطابقة قرار الخبير في 5 مواقف من مدرب وش تلعب." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird freigeschaltet, wenn du in 5 Was spielst du?-Szenarien die Expertenentscheidung triffst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Earned when you match the expert decision in 5 What to Play trainer scenarios." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se desbloquea al igualar la decisión del experto en 5 escenarios del entrenador ¿Qué juegas?." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Se débloque quand tu égales la décision de l'expert dans 5 situations de l'entraîneur Que jouer ?." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "क्या खेलें ट्रेनर की 5 स्थितियों में विशेषज्ञ के निर्णय से मिलान करने पर खुलता है।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Terbuka saat kamu menyamai keputusan ahli dalam 5 skenario pelatih Apa yang dimainkan?." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывается, когда вы совпадаете с решением эксперта в 5 сценариях тренера «Что сыграть?»." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ne oynarsın? antrenöründe 5 senaryoda uzman kararıyla eşleşince açılır." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "وش تلعب؟ ٹرینر کے 5 مواقف میں ماہر کے فیصلے سے مطابقت پر کھلتا ہے۔" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在“该出什么？”训练器的 5 个局面中匹配专家决策后解锁。" } }
